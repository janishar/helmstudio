# files_service settings. Compose overrides the storage values. Any VAR can instead come from a file:
# VAR_FILE=/run/secrets/... (the stack does this for FILE_URL_SECRET and the S3 keys).

# ============================================================================================
# 1. SIGNED FILE LINKS
# ============================================================================================
# HMAC secret of the /files/... links studio_service signs (16+ random characters, the same value as studio_service's;
# on the stack the file_url_secret compose secret)
FILE_URL_SECRET=

# ============================================================================================
# 2. OBJECT STORE
# ============================================================================================
# s3 (SeaweedFS locally, AWS S3 when S3_ENDPOINT is empty) or memory (tests)
STORAGE_DRIVER=s3
S3_BUCKET=helmstudio
S3_REGION=us-east-1
S3_ENDPOINT=http://seaweedfs:8333
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=helm-local
S3_SECRET_ACCESS_KEY=helm-local-secret

# ============================================================================================
# 3. INFRASTRUCTURE
# ============================================================================================
PORT=8080
