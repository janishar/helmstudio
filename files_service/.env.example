# files_service settings. Compose overrides the storage values. Any VAR can instead come from a file:
# VAR_FILE=/run/secrets/... (the stack does this for FILE_URL_SECRET and the S3 keys).

# ============================================================================================
# 1. SIGNED FILE LINKS AND RETENTION
# ============================================================================================
# HMAC secret of the /files/... links catalog_service signs (16+ random characters, the same value as catalog_service's;
# on the stack the file_url_secret compose secret)
FILE_URL_SECRET=
# the janitor (hourly, on every replica) deletes u/*/work/ and u/*/catalog/*/work/ objects older than this, and
# u/*/archives/ (download zips) after 1 day
RETENTION_WORK_DAYS=30

# ============================================================================================
# 2. OBJECT STORE
# ============================================================================================
# s3 (SeaweedFS locally, AWS S3 when S3_ENDPOINT is empty) or memory (tests)
STORAGE_DRIVER=s3
S3_BUCKET=ora
S3_REGION=us-east-1
S3_ENDPOINT=http://seaweedfs:8333
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=ora-local
S3_SECRET_ACCESS_KEY=ora-local-secret

# ============================================================================================
# 3. INFRASTRUCTURE
# ============================================================================================
PORT=8080
