#!/bin/sh
# Creates the object-store bucket on the local SeaweedFS; safe to re-run.
# Runs inside the seaweedfs image (compose service `storage-setup`, profile s3local), or from the host:
#   docker compose -f deploy/docker-compose.yml run --rm storage-setup
# On AWS S3 create the bucket with your own tooling instead.
set -eu
bucket="${S3_BUCKET:-helmstudio}"
master="${WEED_MASTER:-seaweedfs:9333}"
if echo "s3.bucket.list" | weed shell -master="$master" 2>/dev/null | grep -qw "$bucket"; then
  echo "bucket $bucket exists"
else
  echo "s3.bucket.create -name $bucket" | weed shell -master="$master"
fi
