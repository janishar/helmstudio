#!/bin/sh
# Creates the JetStream streams and the KV buckets (registry, hosts, cancels, host_settings); safe to re-run. cmd.pipeline.> and
# evt.pipeline.>/evt.studio.> ride CMD and EVT; batch control is a command, not a KV key (no new bucket).
# Runs inside nats-box (compose service `nats-setup`), or from the host:
#   docker compose -f deploy/docker-compose.yml run --rm nats-setup
set -eu
[ -n "${NATS_URL_FILE:-}" ] && NATS_URL=$(cat "$NATS_URL_FILE")   # the admin user (compose secret nats_admin_url)
export NATS_URL="${NATS_URL:-nats://nats:4222}"

# Every stream has a byte cap (an existing one gets it too), together with the KV buckets under nats.conf's 10 GB
# max_file_store: EVT or DLQ filling up (a remote host publishing without limit) never leaves CMD without room
# (contracts/README.md, A remote GPU host: JetStream).
stream() { # name subjects retention max-age max-bytes
  if nats stream info "$1" >/dev/null 2>&1; then
    echo "stream $1 exists"
    nats stream edit "$1" --max-bytes "$5" -f >/dev/null
    return
  fi
  nats stream add "$1" --subjects "$2" --retention "$3" --max-age "$4" --max-bytes "$5" \
    --storage file --replicas 1 --discard old --dupe-window 2m --defaults
}
kv() { # bucket [ttl]; an existing bucket gets the ttl given here
  if nats kv info "$1" >/dev/null 2>&1; then
    echo "kv $1 exists"
    [ -z "${2:-}" ] || nats kv edit "$1" --ttl "$2" >/dev/null
    return
  fi
  nats kv add "$1" --history 1 --storage file ${2:+--ttl "$2"}
}

stream CMD 'cmd.>' work 0 1GB     # work queue: a run command lives until its runner acks it
stream EVT 'evt.>' limits 7d 6GB  # run + auth events, replayable for 7 days (the oldest go first past 6 GB)
stream DLQ 'dlq.>' limits 30d 1GB # commands a runner could not accept

kv registry                   # <host>.<env>.{nodes,workflows,models}, written by each runner at start
kv hosts 1h                   # <host>.<env>, rewritten every 10 s; deleted on a clean exit. An offline key counts (fail
                              # closed) for an hour, far past any stall, before it expires: expiry writes no delete marker
kv cancels 1h                 # <run_id>, written by studio on cancel
kv host_settings               # <host>, written only by studio (Hosts admin, API 1.16); every runner of the host polls it

# A remote host may create consumers on these two (its cancel watchers; contracts/README.md, Per-host limits), in
# HELM, outside its own account's caps: each stream caps its consumers. The nats CLI will not edit a KV's stream
# without a terminal, so the stream's own update request.
max_consumers() { # stream n
  out=$(nats req "\$JS.API.STREAM.UPDATE.$1" "$(nats stream info "$1" --json | jq -c ".config | .max_consumers = $2")" 2>/dev/null)
  echo "$out" | jq -e '.error == null' >/dev/null || { echo "max_consumers $1: $out" >&2; exit 1; }
}
max_consumers KV_cancels 1000    # a runner watches at most 3 (run, model, media job); each lingers 5 min after
                                 # (nats-py's inactive_threshold), so a fast fake runner holds about its last 5 min of runs
max_consumers KV_host_settings 16  # none in use (runners read their key by direct get); admin tools
nats stream ls
