#!/bin/sh
# Creates every missing compose secret of the helmstudio stack in deploy/secrets/ (git-ignored); never overwrites one
# (the files derived from them, nats_gpu_hosts.conf and s3_config.json, and nats.conf's gpu-hosts blocks are rewritten).
# Run from anywhere: .tools/make-secrets. Postgres reads the DB passwords only when its volume is first created:
# after deleting a secret, recreate the volumes too (docker compose -f deploy/docker-compose.yml down -v). A service
# added later (pipelines) gets its role on an existing volume from postgres/init.sh, re-run as that file says.
set -eu
dir="$(dirname "$0")/../deploy/secrets"
mkdir -p "$dir/providers" && chmod 700 "$dir" && cd "$dir"   # providers/: remote providers' key files (admin)
rand() { openssl rand -hex 24; }
new() { # name value
  if [ -s "$1" ]; then echo "keep   deploy/secrets/$1"; return; fi
  printf %s "$2" >"$1" && chmod 644 "$1" && echo "create deploy/secrets/$1"   # 644: containers run as other users
}

new postgres_password "$(rand)"
for svc in auth studio pipelines; do
  new "${svc}_db_password" "$(rand)"
  new "${svc}_database_url" "postgres://$svc:$(cat "${svc}_db_password")@postgres:5432/$svc?sslmode=disable"
done
for user in admin auth studio runner pipelines; do
  new "nats_${user}_password" "pw$(rand)"   # a letter first: nats.conf would parse a leading digit as a number
  new "nats_${user}_url" "nats://$user:$(cat "nats_${user}_password")@nats:4222"
done
# the native Mac runners (make runners), one NATS user per env, reach NATS from outside Docker on the loopback port
# compose publishes
for env in torch mlx native; do
  new "nats_runner_mac_${env}_password" "pw$(rand)"
  new "nats_runner_mac_${env}_url" \
    "nats://runner_mac_$env:$(cat "nats_runner_mac_${env}_password")@127.0.0.1:${NATS_HOST_PORT:-4322}"
done
new s3_access_key_id "helm-$(openssl rand -hex 8)"
new s3_secret_access_key "$(rand)"
# helm_ + 43 URL-safe characters (contracts/README.md); auth_service registers it as client "web" on every start
new web_api_key "helm_$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n')"
# the same for client "helm" (the CLI): helm login --api-key-file deploy/secrets/helm_api_key
new helm_api_key "helm_$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n')"
new file_url_secret "$(rand)"   # studio_service signs /files links with it, files_service verifies them
[ -s jwt_private_key ] && echo "keep   deploy/secrets/jwt_private_key" || {
  openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt_private_key 2>/dev/null
  chmod 644 jwt_private_key && echo "create deploy/secrets/jwt_private_key"
}
# helmstudio-test runs the fake runner over TLS (deploy/compose/tls.yml): the same user, a tls:// URL
new nats_runner_tls_url "tls://runner:$(cat nats_runner_password)@nats:4222"

# Remote GPU hosts (contracts/README.md, A remote GPU host): one NATS user runner_<h>_torch and one S3 identity
# runner-<h> each. GPU_HOSTS="gcp lab" adds hosts; hosts already here stay; none at all = gcp (the test rig). To drop a
# host, delete its nats_runner_<h>_* and s3_runner_<h>_* files and run this again (then make gpu-host-reload).
# The URL file is what the GPU host's runner uses: TLS through the SSH tunnel (GPU_HOST_NATS_ADDR, default
# 127.0.0.1:4222 on the GPU host); edit its address for a stack that publishes its TLS port instead.
hosts=$( { echo "${GPU_HOSTS:-}" | tr ', ' '\n\n'
           ls | sed -n 's/^nats_runner_\([a-z0-9]*\)_torch_password$/\1/p' | grep -vx mac; } | grep . | sort -u || :)
[ -n "$hosts" ] || hosts=gcp
for h in $hosts; do
  case "$h" in *[!a-z0-9]*|mac|fake) echo "GPU host name '$h': lower-case letters and digits, not mac or fake" >&2
    exit 2;; esac
  new "nats_runner_${h}_torch_password" "pw$(rand)"
  new "nats_runner_${h}_torch_url" \
    "tls://runner_${h}_torch:$(cat "nats_runner_${h}_torch_password")@${GPU_HOST_NATS_ADDR:-127.0.0.1:4222}"
  new "s3_runner_${h}_access_key_id" "runner-$h-$(openssl rand -hex 8)"
  new "s3_runner_${h}_secret_access_key" "$(rand)"
done
# helmstudio-test's second fake host (contract_tests/tests/test_hosts.py: service runner-b, host fakeb, env fake) is
# made exactly like a remote host, so the suite proves the per-host user and identity: its URL is the compose address
new nats_runner_fakeb_fake_password "pw$(rand)"
new nats_runner_fakeb_fake_url "tls://runner_fakeb_fake:$(cat nats_runner_fakeb_fake_password)@nats:4222"
new s3_runner_fakeb_access_key_id "runner-fakeb-$(openssl rand -hex 8)"
new s3_runner_fakeb_secret_access_key "$(rand)"
pairs="$(for h in $hosts; do echo "$h torch"; done; echo "fakeb fake")"

# Rewritten when they change, in place (bind mounts keep the inode; an unchanged file keeps its mtime, so the root
# Makefile's nats_reload does not restart NATS for nothing): nats_gpu_hosts.conf (the hosts' NATS passwords as
# config variables, included by nats.conf) and s3_config.json (SeaweedFS -s3.config: the stack's admin key plus, for
# each runner-<h>, no actions of its own and the policy runner: get under u/ and packs/*/looks/, put only under the
# prefixes a runner writes, never delete or list); and the blocks between the gpu-hosts markers of
# deploy/nats/nats.conf (no secrets in them; the file changes only when the host list does).
bucket="${S3_BUCKET:-helmstudio}"
echo "$pairs" | while read -r h e; do
  printf 'NATS_RUNNER_%s_%s_PASSWORD: "%s"\n' "$(echo "$h" | tr a-z A-Z)" "$(echo "$e" | tr a-z A-Z)" \
    "$(cat "nats_runner_${h}_${e}_password")"
done >.nats_gpu_hosts.conf.new
{ printf '{"identities": [\n  {"name": "admin", "credentials": [{"accessKey": "%s", "secretKey": "%s"}],' \
    "$(cat s3_access_key_id)" "$(cat s3_secret_access_key)"
  printf ' "actions": ["Admin", "Read", "Write", "List", "Tagging"]}'
  for h in $hosts fakeb; do
    printf ',\n  {"name": "runner-%s", "credentials": [{"accessKey": "%s", "secretKey": "%s"}],' \
      "$h" "$(cat "s3_runner_${h}_access_key_id")" "$(cat "s3_runner_${h}_secret_access_key")"
    printf ' "actions": [], "policyNames": ["runner"]}'
  done
  # the keys a runner reads (its command's inputs, LoRAs, its own outputs after the upload, the looks' thumbnails)
  # and writes (contracts/README.md, Object store: run outputs, exports, frames, ask thumbnails, look thumbnails);
  # per owner and per run is not possible with a static identity (the remaining gap, written there)
  a="arn:aws:s3:::$bucket"
  printf '\n],\n"policies": [{"name": "runner", "content": "{\\"Version\\": \\"2012-10-17\\", \\"Statement\\": ['
  printf '{\\"Effect\\": \\"Allow\\", \\"Action\\": [\\"s3:GetObject\\"], \\"Resource\\": [\\"%s/u/*\\", \\"%s/packs/*/looks/*\\"]}, ' "$a" "$a"
  printf '{\\"Effect\\": \\"Allow\\", \\"Action\\": [\\"s3:PutObject\\", \\"s3:AbortMultipartUpload\\", \\"s3:ListMultipartUploadParts\\"], '
  printf '\\"Resource\\": [\\"%s/u/*/runs/*\\", \\"%s/u/*/exports/*\\", \\"%s/u/*/frames/*\\", \\"%s/u/*/llm/thumbs/*\\", \\"%s/packs/*/looks/*\\"]}' \
    "$a" "$a" "$a" "$a" "$a"
  printf ']}"}]}\n'; } >.s3_config.json.new
for f in nats_gpu_hosts.conf s3_config.json; do cmp -s ".$f.new" "$f" || cat ".$f.new" >"$f"; rm -f ".$f.new"; done
chmod 644 nats_gpu_hosts.conf s3_config.json

user_block() { # host env: user runner_<h>_<e> with exactly the permissions contracts/README.md lists
  u="runner_$1_$2" k="$1.$2" d="$1-$2" v="NATS_RUNNER_$(echo "$1_$2" | tr a-z A-Z)_PASSWORD"
  cat <<EOF
      {user: $u, password: \$$v, permissions: {
        publish: [
          "evt.run.$1.>", "dlq.cmd.run.$k", "dlq.cmd.model.$k", "dlq.cmd.media.$k",
          "evt.model.$1.>", "evt.media.$1.>", "\$KV.registry.$k.>", "\$KV.hosts.$k",
          "\$JS.API.INFO", "\$JS.API.STREAM.INFO.CMD",
          "\$JS.API.CONSUMER.CREATE.CMD.runner-$d.cmd.run.$k", "\$JS.API.CONSUMER.INFO.CMD.runner-$d",
          "\$JS.API.CONSUMER.MSG.NEXT.CMD.runner-$d", "\$JS.ACK.CMD.runner-$d.>",
          "\$JS.API.CONSUMER.CREATE.CMD.models-$d.cmd.model.$k", "\$JS.API.CONSUMER.INFO.CMD.models-$d",
          "\$JS.API.CONSUMER.MSG.NEXT.CMD.models-$d", "\$JS.ACK.CMD.models-$d.>",
          "\$JS.API.CONSUMER.CREATE.CMD.media-$d.cmd.media.$k", "\$JS.API.CONSUMER.INFO.CMD.media-$d",
          "\$JS.API.CONSUMER.MSG.NEXT.CMD.media-$d", "\$JS.ACK.CMD.media-$d.>",
          "\$JS.API.STREAM.INFO.KV_host_settings", "\$JS.API.DIRECT.GET.KV_host_settings.\$KV.host_settings.$1",
          "\$JS.API.CONSUMER.CREATE.KV_host_settings.*.\$KV.host_settings.$1", "\$JS.API.CONSUMER.INFO.KV_host_settings.>",
          "\$JS.API.CONSUMER.DELETE.KV_host_settings.>", "\$JS.FC.KV_host_settings.>",
          "\$JS.API.STREAM.INFO.KV_registry", "\$JS.API.STREAM.INFO.KV_hosts",
          "\$JS.API.STREAM.INFO.KV_cancels", "\$JS.API.DIRECT.GET.KV_cancels.>", "\$JS.FC.KV_cancels.>",
          "\$JS.API.CONSUMER.CREATE.KV_cancels", "\$JS.API.CONSUMER.CREATE.KV_cancels.>",
          "\$JS.API.CONSUMER.INFO.KV_cancels.>", "\$JS.API.CONSUMER.DELETE.KV_cancels.>"
        ]
        subscribe: [
          "_INBOX_$u.>", "runner.unload.$k",
          "\$JS.EVENT.ADVISORY.CONSUMER.MAX_DELIVERIES.CMD.runner-$d"
        ]
        allow_responses: true
      }}
EOF
}
# Each remote host is its own NATS account HOST_<H> (contracts/README.md, A remote GPU host: per-host limits): its
# connections, subscriptions per connection and message size are capped there, and HELM (the streams and KV) exports
# to it exactly the subjects its user may use, as services (a request and its reply; a pull's many replies: stream),
# plus its inbox and its advisory as streams (push deliveries of its KV watchers); HELM imports its unload subject.
# A changed account layout needs a NATS restart, not a reload (Makefile: nats_reload).
acct() { echo "HOST_$(echo "$1" | tr a-z A-Z)"; }
own() { # host env: what only this host imports from HELM, one subject a line ("next ": a pull, many replies)
  k="$1.$2" d="$1-$2"
  printf '%s\n' "evt.run.$1.>" "evt.model.$1.>" "evt.media.$1.>" "dlq.cmd.run.$k" "dlq.cmd.model.$k" \
    "dlq.cmd.media.$k" "\$KV.registry.$k.>" "\$KV.hosts.$k" \
    "\$JS.API.DIRECT.GET.KV_host_settings.\$KV.host_settings.$1" \
    "\$JS.API.CONSUMER.CREATE.KV_host_settings.*.\$KV.host_settings.$1"
  for c in "runner cmd.run" "models cmd.model" "media cmd.media"; do set -- $c
    printf '%s\n' "\$JS.API.CONSUMER.CREATE.CMD.$1-$d.$2.$k" "\$JS.API.CONSUMER.INFO.CMD.$1-$d" \
      "\$JS.ACK.CMD.$1-$d.>" "next \$JS.API.CONSUMER.MSG.NEXT.CMD.$1-$d"
  done
}
shared='$JS.API.INFO $JS.API.STREAM.INFO.CMD $JS.API.STREAM.INFO.KV_registry $JS.API.STREAM.INFO.KV_hosts
$JS.API.STREAM.INFO.KV_host_settings $JS.API.CONSUMER.INFO.KV_host_settings.> $JS.API.CONSUMER.DELETE.KV_host_settings.>
$JS.FC.KV_host_settings.> $JS.API.STREAM.INFO.KV_cancels $JS.API.DIRECT.GET.KV_cancels.> $JS.FC.KV_cancels.>
$JS.API.CONSUMER.CREATE.KV_cancels $JS.API.CONSUMER.CREATE.KV_cancels.> $JS.API.CONSUMER.INFO.KV_cancels.>
$JS.API.CONSUMER.DELETE.KV_cancels.>'
all=$(echo "$pairs" | while read -r h e; do acct "$h"; done | paste -sd, - | sed 's/,/, /g')
{ echo "    exports: ["
  for s in $shared; do printf '      {service: "%s", accounts: [%s]}\n' "$s" "$all"; done
  echo "$pairs" | while read -r h e; do a=$(acct "$h")
    own "$h" "$e" | while read -r x y; do
      if [ "$x" = next ]; then printf '      {service: "%s", response: stream, accounts: [%s]}\n' "$y" "$a"
      else printf '      {service: "%s", accounts: [%s]}\n' "$x" "$a"; fi
    done
    printf '      {stream: "%s", accounts: [%s]}\n' "_INBOX_runner_${h}_$e.>" "$a" \
      "\$JS.EVENT.ADVISORY.CONSUMER.MAX_DELIVERIES.CMD.runner-$h-$e" "$a"
  done
  echo "    ]"
  echo "    imports: ["
  echo "$pairs" | while read -r h e; do
    printf '      {service: {account: %s, subject: "runner.unload.%s.%s"}}\n' "$(acct "$h")" "$h" "$e"; done
  echo "    ]"; } >.gpu-hosts.helm
# ponytail: one env per remote host (an account per pair); a host with two envs needs one account for both
echo "$pairs" | while read -r h e; do a=$(acct "$h")
  echo "  $a {"
  echo "    limits: {max_connections: 8, max_subscriptions: 100, max_payload: 1MB}"
  echo "    users: ["; user_block "$h" "$e"; echo "    ]"
  printf '    exports: [{service: "runner.unload.%s.%s", accounts: [HELM]}]\n' "$h" "$e"
  echo "    imports: ["
  { for s in $shared; do echo "$s"; done; own "$h" "$e" | sed 's/^next //'; } |
    while read -r s; do printf '      {service: {account: HELM, subject: "%s"}}\n' "$s"; done
  printf '      {stream: {account: HELM, subject: "%s"}}\n' "_INBOX_runner_${h}_$e.>" \
    "\$JS.EVENT.ADVISORY.CONSUMER.MAX_DELIVERIES.CMD.runner-$h-$e"
  echo "    ]"
  echo "  }"
done >.gpu-hosts.accounts
conf=../nats/nats.conf
awk 'FILENAME == ARGV[1] { h = h $0 "\n"; next } FILENAME == ARGV[2] { a = a $0 "\n"; next }
     /# END gpu-hosts helm/ { printf "%s", h; skip = 0 } /# END gpu-hosts accounts/ { printf "%s", a; skip = 0 }
     !skip { print } /# BEGIN gpu-hosts (helm|accounts)/ { skip = 1 }' .gpu-hosts.helm .gpu-hosts.accounts "$conf" \
  >.nats.conf.new
if cmp -s .nats.conf.new "$conf"; then echo "keep   deploy/nats/nats.conf accounts of GPU hosts:" $hosts
else cat .nats.conf.new >"$conf" && echo "update deploy/nats/nats.conf accounts of GPU hosts:" $hosts; fi
rm -f .gpu-hosts.helm .gpu-hosts.accounts .nats.conf.new

# TLS for NATS and S3 (deploy/compose/tls.yml): a self-signed CA (its key is not kept) and one server cert for both,
# SANs localhost, 127.0.0.1, nats, seaweedfs plus STACK_TLS_NAMES (e.g. "DNS:stack.example.com,IP:203.0.113.7"). To
# change the names, delete stack_tls_cert, stack_tls_key and tls_ca and run this again (GPU hosts need the new tls_ca).
if [ -s stack_tls_cert ] && [ -s stack_tls_key ] && [ -s tls_ca ]; then echo "keep   deploy/secrets/stack_tls_*, tls_ca"
else
  t=$(mktemp -d) && trap 'rm -rf "$t"' EXIT
  printf '[req]\ndistinguished_name=dn\n[dn]\n[ca]\nbasicConstraints=critical,CA:TRUE\n%s\n%s\n' \
    'keyUsage=critical,keyCertSign,cRLSign' 'subjectKeyIdentifier=hash' >"$t/ca.cnf"
  printf '%s%s\n%s\n%s\n%s\n%s\n' 'subjectAltName=DNS:localhost,IP:127.0.0.1,DNS:nats,DNS:seaweedfs' \
    "${STACK_TLS_NAMES:+,$STACK_TLS_NAMES}" 'basicConstraints=CA:FALSE' 'keyUsage=critical,digitalSignature,keyEncipherment' \
    'extendedKeyUsage=serverAuth' 'authorityKeyIdentifier=keyid,issuer' >"$t/srv.ext"
  openssl req -x509 -newkey rsa:2048 -nodes -keyout "$t/ca.key" -out tls_ca -days 3650 -subj "/CN=helmstudio CA" \
    -config "$t/ca.cnf" -extensions ca 2>/dev/null
  openssl req -new -newkey rsa:2048 -nodes -keyout stack_tls_key -out "$t/srv.csr" -subj "/CN=helmstudio stack" \
    -config "$t/ca.cnf" 2>/dev/null
  openssl x509 -req -in "$t/srv.csr" -CA tls_ca -CAkey "$t/ca.key" -set_serial "0x$(openssl rand -hex 8)" \
    -days 825 -extfile "$t/srv.ext" -out stack_tls_cert 2>/dev/null
  chmod 644 tls_ca stack_tls_cert stack_tls_key && echo "create deploy/secrets/stack_tls_cert, stack_tls_key, tls_ca"
fi
