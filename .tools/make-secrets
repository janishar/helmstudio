#!/bin/sh
# Creates every missing compose secret of the helmstudio stack in deploy/secrets/ (git-ignored); never overwrites.
# Run from anywhere: .tools/make-secrets. Postgres reads the DB passwords only when its volume is first created:
# after deleting a secret, recreate the volumes too (docker compose -f deploy/docker-compose.yml down -v).
set -eu
dir="$(dirname "$0")/../deploy/secrets"
mkdir -p "$dir" && chmod 700 "$dir" && cd "$dir"
rand() { openssl rand -hex 24; }
new() { # name value
  if [ -s "$1" ]; then echo "keep   deploy/secrets/$1"; return; fi
  printf %s "$2" >"$1" && chmod 644 "$1" && echo "create deploy/secrets/$1"   # 644: containers run as other users
}

new postgres_password "$(rand)"
for svc in auth studio; do
  new "${svc}_db_password" "$(rand)"
  new "${svc}_database_url" "postgres://$svc:$(cat "${svc}_db_password")@postgres:5432/$svc?sslmode=disable"
done
for user in admin auth studio runner; do
  new "nats_${user}_password" "pw$(rand)"   # a letter first: nats.conf would parse a leading digit as a number
  new "nats_${user}_url" "nats://$user:$(cat "nats_${user}_password")@nats:4222"
done
# the native Mac runner (make runners) reaches NATS from outside Docker, on the loopback port compose publishes
new nats_runner_mac_password "pw$(rand)"
new nats_runner_mac_url "nats://runner_mac:$(cat nats_runner_mac_password)@127.0.0.1:${NATS_HOST_PORT:-4322}"
new s3_access_key_id "helm-$(openssl rand -hex 8)"
new s3_secret_access_key "$(rand)"
# helm_ + 43 URL-safe characters (contracts/README.md); auth_service registers it as client "web" on every start
new web_api_key "helm_$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n')"
# the same for client "helm" (the CLI): helm login --api-key-file deploy/secrets/helm_api_key
new helm_api_key "helm_$(openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n')"
new file_url_secret "$(rand)"   # studio_service signs /files links with it, files_service verifies them
[ -s jwt_private_key ] && echo "keep   deploy/secrets/jwt_private_key" || {
  openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt_private_key 2>/dev/null
  chmod 644 jwt_private_key && echo "create deploy/secrets/jwt_private_key"
}
