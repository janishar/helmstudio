{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helmstudio.local/contracts/tools/catalog.json",
  "title": "The tools the in-app assistant and helm mcp share (API 1.44)",
  "description": "Not a message: one entry per tool (plan 18, 22.7). `input` is model-facing and self-contained (no $ref); `output` is what the tool answers, in the API's own shapes. `surfaces`: assistant (the in-app assistant) and mcp (helm mcp, plan 16). `served_by`: studio answers it on studio.tools as the thread's owner (`routes` are the API calls it stands for), pipelines answers it itself (memory, web search). `roles`: empty = every user; an admin tool is never offered to anyone else and studio checks the role again. `card`: the card kind (actions.json) the user's Yes must answer first. A tool for mcp only is called by helm mcp over Kong as the signed-in user (`routes` are the calls it makes; served_by stays studio). `destructive` (plan 16, the deletes): helm mcp marks it destructiveHint so the client asks before each call.",
  "tools": {
    "sessions": {
      "description": "Your Create sessions, newest first; with session_id, that session's runs and takes.",
      "surfaces": [
        "assistant"
      ],
      "served_by": "studio",
      "read_only": true,
      "roles": [],
      "routes": [
        "GET /v1/studio/sessions",
        "GET /v1/studio/sessions/{session_id}/runs",
        "GET /v1/studio/sessions/{session_id}/takes"
      ],
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "session_id": {
            "type": "string",
            "format": "uuid",
            "description": "one session: its runs and takes"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20,
            "description": "at most 20; default 10"
          }
        }
      },
      "output": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sessions": {
            "$ref": "../openapi.yaml#/components/schemas/SessionList"
          },
          "runs": {
            "$ref": "../openapi.yaml#/components/schemas/RunList"
          },
          "takes": {
            "$ref": "../openapi.yaml#/components/schemas/TakePage"
          }
        },
        "description": "without session_id: sessions; with it: runs and takes"
      }
    },
