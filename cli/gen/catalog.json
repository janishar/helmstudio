    "search_takes": {
      "description": "Search your takes (the Gallery): words in the title, prompt, @elements, workflow or model.",
      "surfaces": [
        "assistant",
        "mcp"
      ],
      "served_by": "studio",
      "read_only": true,
      "roles": [],
