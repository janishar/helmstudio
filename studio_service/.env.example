# studio_service settings, in the order you're most likely to change them. Compose overrides the infrastructure values.
# Any VAR can instead come from a file: VAR_FILE=/run/secrets/... (the stack does this for DATABASE_URL, NATS_PASSWORD
# and FILE_URL_SECRET).

# ============================================================================================
# 1. LIMITS
# ============================================================================================
# request body cap (MB) on every route (all JSON)
MAX_BODY_MB=1

# ============================================================================================
# 2. SIGNED FILE LINKS
# ============================================================================================
# /files/... links (files_service serves them): base URL clients reach (Kong), HMAC secret (16+ random characters, the
# same as files_service's; on the stack the file_url_secret compose secret), lifetime
PUBLIC_BASE_URL=http://localhost:8300
FILE_URL_SECRET=
FILE_URL_TTL=1h

# ============================================================================================
# 3. INFRASTRUCTURE
# ============================================================================================
PORT=8080
# own database + role (created by deploy/postgres); compose overrides it with a secret
DATABASE_URL=postgres://studio:CHANGE_ME@postgres:5432/studio?sslmode=disable
NATS_URL=nats://nats:4222
NATS_USER=
NATS_PASSWORD=
