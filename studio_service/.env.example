# catalog_service settings, in the order you're most likely to change them. Compose overrides the infrastructure and
# storage values. Any VAR can instead come from a file: VAR_FILE=/run/secrets/... (the stack does this for DATABASE_URL,
# NATS_URL, FILE_URL_SECRET and the S3 keys).

# ============================================================================================
# 1. LIMITS
# ============================================================================================
# request body caps (MB): every route, and raw image uploads (500 files of 25 MiB at most per call)
MAX_BODY_MB=256
RAW_MAX_BODY_MB=512

# ============================================================================================
# 2. SIGNED FILE LINKS
# ============================================================================================
# /files/... links (files_service serves them): base URL clients reach (Kong), HMAC secret (16+ random characters, the
# same as files_service's; on the stack the file_url_secret compose secret), lifetime
PUBLIC_BASE_URL=http://localhost:8100
FILE_URL_SECRET=
FILE_URL_TTL=1h

# ============================================================================================
# 3. OBJECT STORE
# ============================================================================================
# s3 (SeaweedFS locally, AWS S3 when S3_ENDPOINT is empty) or memory (tests)
STORAGE_DRIVER=s3
S3_BUCKET=ora
S3_REGION=us-east-1
S3_ENDPOINT=http://seaweedfs:8333
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=ora-local
S3_SECRET_ACCESS_KEY=ora-local-secret

# ============================================================================================
# 4. INFRASTRUCTURE
# ============================================================================================
PORT=8080
# own database + user (created by deploy/postgres/init.sh); compose overrides it with the catalog_database_url secret
DATABASE_URL=postgres://catalog:catalog@postgres:5432/catalog?sslmode=disable
NATS_URL=nats://nats:4222
NATS_USER=
NATS_PASSWORD=
