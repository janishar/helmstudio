# Scratch database owned by the studio role (row-level security only applies to a non-superuser); the tests drop and
# recreate its public schema. deploy/postgres creates studio_test next to studio. Postgres is published on
# 127.0.0.1:${POSTGRES_HOST_PORT:-5463}; the password is the studio role's (deploy/secrets).
TEST_DATABASE_URL=postgres://studio:CHANGE_ME@127.0.0.1:5464/studio_test?sslmode=disable
