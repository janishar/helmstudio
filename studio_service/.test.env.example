# Start it with .tools/test-db (the ora-catalog-test Postgres, never the live one on 5443).
# scratch database owned by the catalog role (row-level security only applies to a non-superuser); the tests drop and
# recreate its public schema. deploy/postgres/init.sh creates it (.tools/test-db runs it on an existing volume too).
# the password: deploy/secrets/catalog_db_password (.tools/make-secrets)
TEST_DATABASE_URL=postgres://catalog:catalog@127.0.0.1:5444/catalog_test?sslmode=disable
