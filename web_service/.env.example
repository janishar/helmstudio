# web_service server-side settings (never exposed to the browser), in the order you're most likely to change them.

# ============================================================================================
# 1. COOKIES
# ============================================================================================
# "false" only for plain-http hosts other than localhost (browsers accept Secure cookies on localhost)
COOKIE_SECURE=true

# ============================================================================================
# 2. CONNECTION
# ============================================================================================
# Kong, the only upstream: /auth/* -> auth_service, /v1/catalog/* -> catalog_service, /files/* -> files_service
KONG_URL=http://127.0.0.1:8100
# this web app's own client API key (issue one: docker compose -f deploy/docker-compose.yml run --rm auth apikey web);
# WEB_API_KEY_FILE (a file holding it) wins: the stack mounts the web_api_key secret, which auth registers on start
WEB_API_KEY=

# ============================================================================================
# 3. DEV VIEWS
# ============================================================================================
# "true" adds Jobs (dev) to the account menu: /dev/jobs lists the signed-in user's own jobs and their nodes
DEV_VIEWS=false
