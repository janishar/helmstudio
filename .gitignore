# macOS
.DS_Store
._*
.Spotlight-V100
.Trashes

# Editors
.vscode/
.idea/
*.swp
*~

# Local assistant and tooling state — CLAUDE.md itself is tracked
.claude/
.cursor/
.aider*
.github/copilot-instructions.md

# Go build output. release-helm.yml builds helm into build/ and dist/: ignored,
# so helm --version does not call a release built beside them modified.
/build/
/dist/
/bin/
/out/
# The built site: make site writes it, and the site workflow builds it again
# where it is published (docs/decisions.md M10 Q8).
/site/out/
*.exe
*.test
*.prof
coverage.out
.gocache/
.gomodcache/

# Node — packages/ui and packages/css
node_modules/
.npm/
*.tsbuildinfo
/packages/*/dist/

# Python — helm dev may create an environment for a local studio
__pycache__/
*.py[cod]
.venv/
venv/
# What setuptools leaves beside the runtime SDK's source when it is built there,
# by python -m build as publish-python.yml runs it or by installing from the
# directory. Scoped: packages/helm-css/cmd/build is source.
/packages/helm-runtime-sdk/python/build/
/packages/helm-runtime-sdk/python/dist/
*.egg-info/

# Mac app packaging (where the app lives in the tree is an M9 kickoff question)
/packages/app/release/
DerivedData/
*.dmg
*.zip.blockmap

# helmstudio's own runtime state. None of this is ever committed: the store is
# a user's library, and a stray .db in a diff is somebody's generation history.
# helm dev keeps a studio's data in .helm beside the manifest it runs, which
# for the fixture studios under test/studios is inside this repository.
.helm/
*.db
*.db-wal
*.db-shm
*.db.bak.*
/testdata/tmp/
/tmp/

# Generated clients ARE committed on purpose — the gate regenerates them and
# fails on a diff, which only works if the checked-in copy is there to compare.
