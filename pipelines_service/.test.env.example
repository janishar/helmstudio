# Start it with .tools/test-db (the helmstudio-test compose project's Postgres on 5464, never the live one on 5463).
# The maintenance database of a scratch Postgres server: each test run creates and drops its own database. Without
# TEST_DATABASE_URL the engine tests skip. The password is deploy/secrets/postgres_password.
TEST_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5464/postgres?sslmode=disable
