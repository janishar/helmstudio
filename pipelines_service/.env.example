# pipelines_service (`make dev`). Compose sets the same names, with secrets as <VAR>_FILE.
DATABASE_URL=postgresql://pipelines:change-me@localhost:5463/pipelines
NATS_URL=nats://pipelines:change-me@localhost:4322
HEALTH_PORT=8082
# rows driven at once (a parked row holds nothing)
PIPELINES_DRIVE_CONCURRENCY=8
# M4b stage B: calls that leave the machine (off by default), provider key files, local-server hosts
PIPELINES_REMOTE_MODELS=false
# test tooling only: let a remote provider resolve to a private or loopback address (never link-local)
PIPELINES_REMOTE_ALLOW_PRIVATE=false
# providers' key files (key_secret); several folders joined by ":" are searched in order (API 1.51)
PIPELINES_PROVIDER_KEYS_DIR=/run/secrets
PIPELINES_SERVER_HOSTS=
