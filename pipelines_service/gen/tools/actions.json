{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helmstudio.local/contracts/tools/actions.json",
  "title": "The assistant's screen actions and cards (API 1.44)",
  "description": "Not a message: what a screen registers for the assistant (plan 18, 22.5 and 22.6), assistant only. Each action calls the screen's existing entry point in the tab that sent the message. `effect`: line (an action line), undo (a line with Undo), card (the card of kind `card` first; Yes is the user's click), dialog (opens the screen's own dialog prefilled; resolves on close with the new id and @handle, or cancelled). The shell's actions are on every screen; a screen with `roles` registers only for them. `input` is model-facing and self-contained.",
  "tags": {
    "gpu": "uses the GPU",
    "egress": "sends to <provider>",
    "final": "can't be undone",
    "machine": "uses the machine",
    "disk": "uses disk and network"
  },
  "cards": {
    "generate": {
      "tags": [
        "gpu"
      ],
      "shows": "model and version, machine and place in line, size, run count, time and memory (runs/plan), the prompt"
    },
    "batch": {
      "tags": [
        "gpu",
        "egress"
      ],
      "shows": "rows, caps, what leaves the machine"
    },
    "stop": {
      "tags": [
        "final"
      ],
      "shows": "rows that stop"
    },
    "pick": {
      "tags": [
        "gpu"
      ],
      "shows": "the row, the take, what runs next"
    },
    "judge_test": {
      "tags": [
        "gpu",
        "egress"
      ],
      "shows": "takes, criteria, provider"
    },
    "export": {
      "tags": [
        "machine"
      ],
      "shows": "preset, size, fps, time (export/plan)"
    },
    "hear": {
      "tags": [
        "gpu"
      ],
      "shows": "tries, voice model"
    },
    "download": {
      "tags": [
        "disk"
      ],
      "shows": "size, machine, licence state; Yes is the row's own Download, on only once ticked"
    },
    "web_search": {
      "tags": [
        "egress"
      ],
      "shows": "the query, the provider"
    },
    "look": {
      "tags": [
        "gpu"
      ],
      "shows": "the takes, the question, machine and place in line"
    },
    "delete": {
      "tags": [
        "final"
      ],
      "shows": "what goes, what stays"
    }
  },
  "screens": {
    "shell": {
      "routes": [
        "*"
      ],
      "actions": {
        "navigate": {
          "description": "Go to a screen with the right thing open. Actions after it in the same batch are dropped; the new screen's summary comes back.",
          "effect": "line",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "to": {
                "enum": [
                  "/",
                  "/gallery",
                  "/timeline",
                  "/pipelines",
                  "/pipelines/{id}",
                  "/pipelines/batches/{id}",
                  "/pipelines/batches/{id}/review",
                  "/pipelines/batches/{id}/rows/{row}",
                  "/models",
                  "/admin"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "row": {
                "type": "integer",
                "minimum": 1,
                "maximum": 500
              },
              "query": {
                "type": "object",
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 200
                },
                "propertyNames": {
                  "enum": [
                    "s",
                    "reuse",
                    "use",
                    "w",
                    "batch",
                    "t",
                    "view",
                    "attempt",
                    "tab"
                  ]
                }
              }
            },
            "required": [
              "to"
            ]
          }
        },
        "await": {
          "description": "Wait for a run, model job, download, export or clone in this tab (at most 10 min, then still running).",
          "effect": "line",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "what": {
                "enum": [
                  "run",
                  "job",
                  "download",
                  "export",
                  "clone"
                ]
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "required": [
              "what",
              "id"
            ]
          }
        }
      }
    },
    "create": {
      "routes": [
        "/"
      ],
      "actions": {
        "change": {
          "description": "Set one form field (prompt, size, variant, Enhance, Think, references, bindings, source, LoRAs, looks, dialogue…). Refused when the form shows it greyed or hidden.",
          "effect": "undo",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "value": {
                "description": "a form value, as the field takes it"
              }
            },
            "required": [
              "key",
              "value"
            ]
          }
        },
        "switchTo": {
          "description": "Switch the form to another workflow.",
          "effect": "undo",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "workflow": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "workflow"
            ]
          }
        },
        "preset": {
          "description": "Apply a preset (refused when greyed).",
          "effect": "undo",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "name"
            ]
          }
        },
        "runOn": {
          "description": "Pick Auto or a machine the form allows, with a reason.",
          "effect": "undo",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": {
                "type": "string",
                "pattern": "^(auto|[a-z0-9]{1,32})$"
              },
              "reason": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "host",
              "reason"
            ]
          }
        },
        "seeds": {
          "description": "How many takes to make.",
          "effect": "undo",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "n": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              }
            },
            "required": [
              "n"
            ]
          }
        },
        "view": {
          "description": "Studio or Graph view.",
          "effect": "line",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "view": {
                "enum": [
                  "studio",
                  "graph"
                ]
              }
            },
            "required": [
              "view"
            ]
          }
        },
        "newSession": {
          "description": "Start a new session.",
          "effect": "line",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          }
        },
        "renameWorkflow": {
          "description": "Rename this workflow.",
          "effect": "line",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "required": [
              "title"
            ]
          }
        },
        "duplicateWorkflow": {
          "description": "Duplicate this workflow.",
          "effect": "line",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          }
        },
        "deleteWorkflow": {
          "description": "Delete this workflow (its takes stay).",
          "effect": "card",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          },
          "card": "delete"
        },
        "frameIn": {
          "description": "Use a take as the first or last frame.",
          "effect": "line",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "take_id": {
                "type": "string",
                "format": "uuid",
                "description": "a take"
              },
              "at": {
                "enum": [
                  "first",
                  "last"
                ]
              }
            },
            "required": [
              "take_id",
              "at"
            ]
          }
        },
        "select": {
          "description": "Select a take.",
          "effect": "undo",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "take_id": {
                "type": "string",
                "format": "uuid",
                "description": "a take"
              }
            },
            "required": [
              "take_id"
            ]
          }
        },
        "star": {
          "description": "Star or unstar a take.",
          "effect": "undo",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "take_id": {
                "type": "string",
                "format": "uuid",
                "description": "a take"
              },
              "on": {
                "type": "boolean"
              }
            },
            "required": [
              "take_id",
              "on"
            ]
          }
        },
        "stop": {
          "description": "Stop a run.",
          "effect": "line",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "run_id": {
                "type": "string",
                "format": "uuid",
                "description": "the run"
              }
            },
            "required": [
              "run_id"
            ]
          }
        },
        "generate": {
          "description": "Generate with the form as it is.",
          "effect": "card",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          },
          "card": "generate"
        },
        "saveAsLook": {
          "description": "Open Save as look, prefilled.",
          "effect": "dialog",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "take_id": {
                "type": "string",
                "format": "uuid",
                "description": "a take"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          }
        },
        "saveAsElement": {
          "description": "Open Save as element, prefilled.",
          "effect": "dialog",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "take_id": {
                "type": "string",
                "format": "uuid",
                "description": "a take"
              },
              "handle": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            }
          }
        },
        "editItem": {
          "description": "Open a library item's Edit.",
          "effect": "dialog",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "item_id": {
                "type": "string",
                "format": "uuid",
                "description": "the item"
              }
            },
            "required": [
              "item_id"
            ]
          }
        },
        "cloneVoice": {
          "description": "Open Clone a voice, prefilled.",
          "effect": "dialog",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "take_id": {
                "type": "string",
                "format": "uuid",
                "description": "a take"
              },
              "from_s": {
                "type": "number",
                "minimum": 0
              },
              "to_s": {
                "type": "number",
                "minimum": 0
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "take_id"
            ]
          }
        },
        "designVoice": {
          "description": "Open Design a voice, prefilled.",
          "effect": "dialog",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "description": {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            }
          }
        },
        "hear": {
          "description": "Hear tries in the open clone or design dialog.",
          "effect": "card",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          },
          "card": "hear"
        },
        "deleteItem": {
          "description": "Delete a library item.",
          "effect": "card",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "item_id": {
                "type": "string",
                "format": "uuid",
                "description": "the item"
              }
            },
            "required": [
              "item_id"
            ]
          },
          "card": "delete"
        },
        "renameLora": {
          "description": "Rename a LoRA.",
          "effect": "line",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "lora_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            },
            "required": [
              "lora_id",
              "name"
            ]
          }
        },
        "deleteLora": {
          "description": "Delete a LoRA.",
          "effect": "card",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "lora_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "required": [
              "lora_id"
            ]
          },
          "card": "delete"
        }
      }
    },
    "graph": {
      "routes": [
        "/"
      ],
      "actions": {
        "addNode": {
          "description": "Add a node, wired around the selected one.",
          "effect": "undo",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "near": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "removeNodes": {
          "description": "Remove nodes and their wires.",
          "effect": "undo",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "ids": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                }
              }
            },
            "required": [
              "ids"
            ]
          }
        },
        "connect": {
          "description": "Wire `ref` (<node>.<output>) into a node's input.",
          "effect": "undo",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "node": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 130
              }
            },
            "required": [
              "node",
              "key",
              "ref"
            ]
          }
        },
        "disconnect": {
          "description": "Remove the wire into a node's input.",
          "effect": "undo",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "node": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "required": [
              "node",
              "key"
            ]
          }
        },
        "setParam": {
          "description": "Set a node's param.",
          "effect": "undo",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "node": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "key": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "value": {
                "description": "a form value, as the field takes it"
              }
            },
            "required": [
              "node",
              "key",
              "value"
            ]
          }
        },
        "setBypass": {
          "description": "Bypass a node or not.",
          "effect": "undo",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "node": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "on": {
                "type": "boolean"
              }
            },
            "required": [
              "node",
              "on"
            ]
          }
        },
        "generate": {
          "description": "Generate with the graph as it is.",
          "effect": "card",
          "input": {
            "type": "object",
            "additionalProperties": false,
            "properties": {}
          },
          "card": "generate"
        }
      }
    },
