    "batches": {
      "routes": [
        "/pipelines",
        "/pipelines/batches/{id}",
        "/pipelines/batches/{id}/review",
        "/pipelines/batches/{id}/rows/{row}"
      ],
      "actions": {
        "newBatch": {
          "description": "Fill New batch: rows, seeds, looks.",
          "effect": "undo",
          "input": {
