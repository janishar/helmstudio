            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              },
              "fields": {
                "type": "object"
              }
            },
            "required": [
              "kind"
            ]
          }
        },
        "setNode": {
          "description": "Change a node's fields.",
