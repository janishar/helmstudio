{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helmstudio.local/contracts/messages/evt.pipeline.batch.schema.json",
  "title": "pipelines → studio's projector: a batch's status changed",
  "description": "Subject evt.pipeline.<batch_id>.batch (stream EVT), Nats-Msg-Id <batch_id>:<seq>. pipelines_service is the only writer of a batch's status. `seq` is per batch over both evt.pipeline.* kinds, allocated and committed before publishing (gaps are normal, a seq is never reused); the projector dedupes on (job_id, seq) and ignores a batch event whose seq is not above the last batch event it applied.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "evt.pipeline.batch"
    },
    "version": {
      "const": 1
    },
    "job_id": {
      "$ref": "defs.schema.json#/$defs/uuid",
      "description": "the batch id"
    },
    "data": {
      "type": "object",
      "required": [
        "seq",
        "status"
      ],
      "properties": {
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "$ref": "defs.schema.json#/$defs/batchStatus"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000,
          "description": "why it is paused or failed, user-readable: `paused by you`, `the pipeline service restarted; press Resume`, `3 rows in a row failed: <error>`; required (non-empty) with paused and failed"
        },
        "memory": {
          "$ref": "defs.schema.json#/$defs/memorySnapshot",
          "description": "from API 1.14, a pipeline batch: the memory snapshot it reads, sent from its first running event on"
        },
        "director": {
          "type": "object",
          "required": [
            "node",
            "state",
            "wakes",
            "max_wakes"
          ],
          "additionalProperties": false,
          "description": "from API 1.15, a batch whose pipeline has a director: its chat's state",
          "properties": {
            "node": {
              "$ref": "defs.schema.json#/$defs/nodeId"
            },
            "state": {
              "enum": [
                "idle",
                "waiting",
                "thinking",
                "off"
              ],
              "description": "idle: asleep until a message or a row ends; waiting: a turn's call is queued or held (Pause); thinking: a call or its tools are running; off: the batch ended or max_wakes was reached"
            },
            "wakes": {
              "type": "integer",
              "minimum": 0
            },
            "max_wakes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          }
        },
        "remote": {
          "type": "object",
          "required": [
            "calls",
            "tokens",
            "network_failures",
            "max_calls",
            "max_tokens"
          ],
          "additionalProperties": false,
          "description": "from API 1.15, a batch with remote enabled: what left the machine so far against the per-batch caps",
          "properties": {
            "calls": {
              "type": "integer",
              "minimum": 0
            },
            "tokens": {
              "type": "integer",
              "minimum": 0
            },
            "network_failures": {
              "type": "integer",
              "minimum": 0
            },
            "max_calls": {
              "type": "integer",
              "minimum": 1
            },
            "max_tokens": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "if": {
        "properties": {
          "status": {
            "enum": [
              "paused",
              "failed"
            ]
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
