{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helmstudio.local/contracts/messages/evt.media.status.schema.json",
  "title": "runner → studio: a media job's lifecycle",
  "description": "From API 1.17. Subject evt.media.<host>.status (stream EVT), Nats-Msg-Id <job_id>:<delivery>:<seq>. `running` when the runner starts it (each delivery), then one terminal status; `succeeded` only after every output object is written and checked. The projector (durable studio-media, filter evt.media.>) dedupes on (job_id, delivery, seq), ignores events of a terminal job, and on succeeded makes the take in the same transaction (README, Timeline: export).",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "evt.media.status"
    },
    "version": {
      "const": 1
    },
    "job_id": {
      "$ref": "defs.schema.json#/$defs/uuid",
      "description": "the media job id"
    },
    "data": {
      "type": "object",
      "required": [
        "seq",
        "delivery",
        "status"
      ],
      "properties": {
        "seq": {
          "$ref": "defs.schema.json#/$defs/seq",
          "description": "per delivery, from 1, over status and progress"
        },
        "delivery": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "encoder": {
          "enum": [
            "h264_videotoolbox",
            "h264_nvenc",
            "libx264",
            "copy"
          ],
          "description": "running and succeeded exports: the video encoder used (h264_nvenc from API 1.18: a cuda container whose GPU encodes)"
        },
        "failure": {
          "type": "object",
          "required": [
            "class",
            "detail"
          ],
          "additionalProperties": false,
          "properties": {
            "class": {
              "enum": [
                "input",
                "invalid",
                "ffmpeg",
                "verify",
                "internal"
              ],
              "description": "input: an input object is missing or unreadable, or ffprobe cannot read it; invalid: the args were refused; ffmpeg: it exited non-zero; verify: the output failed the check; internal"
            },
            "detail": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500,
              "description": "one line (ffmpeg: its last error line); never a local path, a URL or a stack trace"
            }
          }
        },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "description": "succeeded: an export's or a frame's take (key, width, height, bytes); (1.48) a thumbs job's `thumbs` (no key); (1.79) a mux's take: key mux.mp4 and its `video` (as an export's, poster mux.poster.png at frame 0, last mux.last.png); (1.82) a bake's: key bake.mp4, as an export's (bake.poster.png, bake.last.png, its thumb bake.thumb.webp)",
          "properties": {
            "key": {
              "allOf": [
                {
                  "$ref": "defs.schema.json#/$defs/objectKey"
                },
                {
                  "pattern": "/(export\\.mp4|frame\\.png|mux\\.mp4|bake\\.mp4)$"
                }
              ]
            },
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            },
            "etag": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "mode": {
              "enum": [
                "copy",
                "conform"
              ],
              "description": "export: what it did"
            },
            "reason": {
              "type": "string",
              "maxLength": 300,
              "description": "export planned copy, done conform: which probe differed (`clip input 2: extradata_sha256 differs`)"
            },
            "video": {
              "type": "object",
              "required": [
                "duration_s",
                "fps",
                "frames",
                "has_audio",
                "poster",
                "last"
              ],
              "additionalProperties": false,
              "description": "export, (1.79) mux and (1.82) bake: as evt.run.output video",
              "properties": {
                "duration_s": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "fps": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "frames": {
                  "type": "integer",
                  "minimum": 1
                },
                "has_audio": {
                  "type": "boolean"
                },
                "poster": {
                  "type": "object",
                  "required": [
                    "key",
                    "width",
                    "height",
                    "bytes"
                  ],
                  "additionalProperties": false,
                  "description": "export.poster.png: the frame at a tenth of the length (a fade-in never gives a black poster)",
                  "properties": {
                    "key": {
                      "allOf": [
                        {
                          "$ref": "defs.schema.json#/$defs/objectKey"
                        },
                        {
                          "pattern": "\\.poster\\.png$"
                        }
                      ]
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "last": {
                  "type": "object",
                  "required": [
                    "key",
                    "width",
                    "height",
                    "bytes"
                  ],
                  "additionalProperties": false,
                  "description": "export.last.png: the last frame",
                  "properties": {
                    "key": {
                      "allOf": [
                        {
                          "$ref": "defs.schema.json#/$defs/objectKey"
                        },
                        {
                          "pattern": "\\.last\\.png$"
                        }
                      ]
                    },
                    "width": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "height": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "bytes": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "stream": {
                  "$ref": "defs.schema.json#/$defs/videoStream"
                }
              }
            },
            "thumb": {
              "allOf": [
                {
                  "$ref": "defs.schema.json#/$defs/takeThumb"
                },
                {
                  "properties": {
                    "key": {
                      "pattern": "/(export|frame|bake)\\.thumb\\.webp$"
                    }
                  }
                }
              ],
              "description": "API 1.48, export and frame (and from 1.82 bake: bake.thumb.webp): the thumbnail of the poster (export.thumb.webp) or of the frame (frame.thumb.webp) under output_prefix; absent when it would save nothing"
            },
            "thumbs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "description": "API 1.48, a thumbs job: one item per input, by its index: the thumbnail written at <output_prefix><index>.webp, `skip` (the input needs none: its short side is at most 360 px (until 2026-11-23: 512), or the WebP is not smaller), or `error` (it could not be read; the job goes on)",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "required": [
                      "index",
                      "key",
                      "width",
                      "height",
                      "bytes"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "index": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 19
                      },
                      "key": {
                        "allOf": [
                          {
                            "$ref": "defs.schema.json#/$defs/objectKey"
                          },
                          {
                            "pattern": "/thumbs/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[0-9]+\\.webp$"
                          }
                        ]
                      },
                      "width": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1024
                      },
                      "height": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 1024
                      },
                      "bytes": {
                        "type": "integer",
                        "minimum": 1
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "index",
                      "skip"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "index": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 19
                      },
                      "skip": {
                        "const": true
                      }
                    }
                  },
                  {
                    "type": "object",
                    "required": [
                      "index",
                      "error"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "index": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 19
                      },
                      "error": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 300
                      }
                    }
                  }
                ]
              }
            }
          },
          "anyOf": [
            {
              "required": [
                "key",
                "width",
                "height",
                "bytes"
              ],
              "not": {
                "required": [
                  "thumbs"
                ]
              }
            },
            {
              "required": [
                "thumbs"
              ],
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "key"
                    ]
                  },
                  {
                    "required": [
                      "thumb"
                    ]
                  }
                ]
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "required": [
              "failure"
            ]
          },
          "else": {
            "not": {
              "required": [
                "failure"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "succeeded"
              }
            }
          },
          "then": {
            "required": [
              "result"
            ]
          },
          "else": {
            "not": {
              "required": [
                "result"
              ]
            }
          }
        }
      ]
    }
  }
}
