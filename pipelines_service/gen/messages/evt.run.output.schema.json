{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helmstudio.local/contracts/messages/evt.run.output.schema.json",
  "title": "runner → studio: one output object written",
  "description": "Subject evt.run.<session_id>.output (stream EVT), Nats-Msg-Id <run_id>:<attempt>:<seq>. Sent after the object is fully written to the object store, before the terminal status. `key` is under the command's output_prefix: an image is <output_prefix><index>.png, a video <output_prefix><index>.mp4 (H.264 yuv420p + AAC, moov atom first: -movflags +faststart) with its poster <output_prefix><index>.poster.png (frame 0, the video's size), both written before this event.",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "evt.run.output"
    },
    "version": {
      "const": 1
    },
    "job_id": {
      "$ref": "defs.schema.json#/$defs/uuid",
      "description": "the run id"
    },
    "data": {
      "type": "object",
      "required": [
        "seq",
        "index",
        "key",
        "kind",
        "bytes"
      ],
      "properties": {
        "seq": {
          "$ref": "defs.schema.json#/$defs/seq"
        },
        "index": {
          "type": "integer",
          "minimum": 0,
          "description": "the output's number in the run, from 0 (key <output_prefix><index>.<ext>)"
        },
        "key": {
          "$ref": "defs.schema.json#/$defs/objectKey"
        },
        "kind": {
          "enum": [
            "image",
            "video"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "object size"
        },
        "etag": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "description": "the object's content hash: md5 hex of its bytes (the S3 ETag of the single-part PUT); studio stores it as the take's etag, so the take can be used as an input image without re-reading it. Absent: studio hashes the object when the take is first used"
        },
        "seed": {
          "$ref": "defs.schema.json#/$defs/seed",
          "description": "the seed this output was made with"
        },
        "attempt": {
          "$ref": "defs.schema.json#/$defs/attempt",
          "description": "the attempt of cmd.run.execute this event belongs to; absent = 1. seq restarts at 1 for each attempt; the projector dedupes on (job_id, attempt, seq) and drops events of an attempt that is not the run's current one"
        },
        "video": {
          "type": "object",
          "description": "kind video only (required then, absent for an image): the clip's metadata, from the file the runner wrote",
          "required": [
            "duration_s",
            "fps",
            "frames",
            "has_audio",
            "poster"
          ],
          "additionalProperties": false,
          "properties": {
            "duration_s": {
              "type": "number",
              "exclusiveMinimum": 0,
              "description": "frames / fps, the video stream's length in seconds"
            },
            "fps": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 240
            },
            "frames": {
              "type": "integer",
              "minimum": 1
            },
            "has_audio": {
              "type": "boolean",
              "description": "true when the MP4 has an audio track (LTX: AAC 48 kHz stereo)"
            },
            "poster": {
              "type": "object",
              "required": [
                "key",
                "width",
                "height",
                "bytes"
              ],
              "additionalProperties": false,
              "description": "the poster image: frame 0 as PNG, the take's thumbnail",
              "properties": {
                "key": {
                  "allOf": [
                    {
                      "$ref": "defs.schema.json#/$defs/objectKey"
                    },
                    {
                      "pattern": "\\.poster\\.png$"
                    }
                  ],
                  "description": "<output_prefix><index>.poster.png"
                },
                "width": {
                  "type": "integer",
                  "minimum": 1
                },
                "height": {
                  "type": "integer",
                  "minimum": 1
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "video"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "video",
              "width",
              "height"
            ],
            "properties": {
              "key": {
                "pattern": "\\.mp4$"
              }
            }
          },
          "else": {
            "not": {
              "required": [
                "video"
              ]
            }
          }
        }
      ]
    }
  }
}
