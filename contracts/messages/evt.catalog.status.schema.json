{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ora.local/contracts/messages/evt.catalog.status.schema.json",
  "title": "lifecycle of a process or run job (projected into the session's processing / the run row)",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "evt.catalog.status"
    },
    "version": {
      "const": 1
    },
    "job_id": {
      "$ref": "defs.schema.json#/$defs/uuid"
    },
    "data": {
      "type": "object",
      "required": [
        "seq",
        "attempt",
        "session_id",
        "work",
        "status",
        "error"
      ],
      "properties": {
        "seq": {
          "$ref": "defs.schema.json#/$defs/seq"
        },
        "attempt": {
          "$ref": "defs.schema.json#/$defs/attempt"
        },
        "session_id": {
          "$ref": "defs.schema.json#/$defs/uuid"
        },
        "work": {
          "enum": [
            "process",
            "run"
          ]
        },
        "status": {
          "enum": [
            "running",
            "succeeded",
            "failed"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "error": {
            "type": "string"
          }
        }
      }
    }
  }
}
