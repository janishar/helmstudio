{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ora.local/contracts/messages/req.catalog.interpret.schema.json",
  "title": "NATS request/reply catalog.interpret: a typed Processing request → one action and a short reply",
  "description": "Core NATS request/reply on subject `catalog.interpret` (queue group agents), bare JSON, no envelope. The reply never turns text it cannot map into feedback: that is `not_understood`. catalog_service checks the action against the session and may replace `reply` with what actually happened.",
  "$defs": {
    "request": {
      "type": "object",
      "required": [
        "owner_id",
        "session_id",
        "text",
        "selected_image_ids",
        "state"
      ],
      "properties": {
        "owner_id": {
          "$ref": "defs.schema.json#/$defs/uuid"
        },
        "session_id": {
          "$ref": "defs.schema.json#/$defs/uuid"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "selected_image_ids": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/uuid"
          }
        },
        "state": {
          "type": "object",
          "required": [
            "categories",
            "skus",
            "latest_run_image_ids"
          ],
          "properties": {
            "categories": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "category",
                  "name",
                  "poses"
                ],
                "properties": {
                  "category": {
                    "$ref": "defs.schema.json#/$defs/libraryId"
                  },
                  "name": {
                    "type": "string"
                  },
                  "poses": {
                    "type": "array",
                    "items": {
                      "$ref": "defs.schema.json#/$defs/libraryId"
                    }
                  },
                  "custom_poses": {
                    "type": "array",
                    "items": {
                      "$ref": "defs.schema.json#/$defs/customPose"
                    },
                    "description": "the session's custom shots among this category's poses (their names); absent = none"
                  }
                }
              }
            },
            "skus": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "sku_id",
                  "code",
                  "name",
                  "category",
                  "group_key",
                  "status"
                ],
                "properties": {
                  "sku_id": {
                    "$ref": "defs.schema.json#/$defs/uuid"
                  },
                  "code": {
                    "$ref": "defs.schema.json#/$defs/skuCode"
                  },
                  "name": {
                    "type": "string"
                  },
                  "category": {
                    "$ref": "defs.schema.json#/$defs/libraryId"
                  },
                  "group_key": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "status": {
                    "enum": [
                      "Not run",
                      "Queued",
                      "Running",
                      "To review",
                      "Approved",
                      "Redo"
                    ]
                  }
                }
              }
            },
            "latest_run_image_ids": {
              "type": "array",
              "items": {
                "$ref": "defs.schema.json#/$defs/uuid"
              },
              "description": "images of the latest run still to review (feedback without a selection)"
            }
          }
        }
      }
    },
    "reply": {
      "oneOf": [
        {
          "$ref": "#/$defs/ok"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    },
    "ok": {
      "type": "object",
      "required": [
        "action",
        "reply",
        "args"
      ],
      "properties": {
        "action": {
          "enum": [
            "run",
            "approve",
            "add_pose",
            "remove_pose",
            "set_poses",
            "open_pose_editor",
            "download",
            "feedback",
            "reply",
            "not_understood"
          ]
        },
        "reply": {
          "type": "string",
          "maxLength": 1000
        },
        "args": {
          "type": "object",
          "description": "run: scope (+ category, group_key or sku_ids); approve: image_ids, sku_ids or category; add_pose/remove_pose: category, pose_id; set_poses/open_pose_editor: category (+ poses); feedback: feedback (+ image_ids)",
          "properties": {
            "scope": {
              "enum": [
                "sample",
                "batch",
                "all",
                "skus"
              ]
            },
            "category": {
              "$ref": "defs.schema.json#/$defs/libraryId"
            },
            "group_key": {
              "type": "string"
            },
            "sku_ids": {
              "type": "array",
              "items": {
                "$ref": "defs.schema.json#/$defs/uuid"
              }
            },
            "image_ids": {
              "type": "array",
              "items": {
                "$ref": "defs.schema.json#/$defs/uuid"
              }
            },
            "pose_id": {
              "$ref": "defs.schema.json#/$defs/libraryId"
            },
            "poses": {
              "type": "array",
              "items": {
                "$ref": "defs.schema.json#/$defs/libraryId"
              }
            },
            "feedback": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            }
          }
        }
      },
      "not": {
        "required": [
          "error"
        ]
      }
    },
    "error": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
