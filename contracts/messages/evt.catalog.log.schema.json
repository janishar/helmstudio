{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ora.local/contracts/messages/evt.catalog.log.schema.json",
  "title": "a status line for the chat; a later line with the same key replaces it (spinner → tick)",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "evt.catalog.log"
    },
    "version": {
      "const": 1
    },
    "job_id": {
      "$ref": "defs.schema.json#/$defs/uuid"
    },
    "data": {
      "type": "object",
      "required": [
        "seq",
        "attempt",
        "session_id",
        "key",
        "text",
        "state"
      ],
      "properties": {
        "seq": {
          "$ref": "defs.schema.json#/$defs/seq"
        },
        "attempt": {
          "$ref": "defs.schema.json#/$defs/attempt"
        },
        "session_id": {
          "$ref": "defs.schema.json#/$defs/uuid"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9_.:-]{1,64}$"
        },
        "text": {
          "type": "string",
          "maxLength": 500,
          "examples": [
            "Images sorted — 18 SKUs (10 Rings, 5 Necklaces, 3 Anklets)"
          ]
        },
        "state": {
          "enum": [
            "running",
            "done",
            "error"
          ]
        },
        "detail": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000,
          "description": "optional longer text behind the line (the chat's View details), several lines allowed, e.g. each guideline document and whether it was read; absent or null = none"
        }
      }
    }
  }
}
