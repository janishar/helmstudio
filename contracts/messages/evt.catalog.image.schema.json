{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ora.local/contracts/messages/evt.catalog.image.schema.json",
  "title": "one image of a run changed: rendering, ready for review (key), or failed",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "evt.catalog.image"
    },
    "version": {
      "const": 1
    },
    "job_id": {
      "$ref": "defs.schema.json#/$defs/uuid"
    },
    "data": {
      "type": "object",
      "required": [
        "seq",
        "attempt",
        "session_id",
        "image_id",
        "sku_id",
        "status",
        "key",
        "review",
        "attempts",
        "first_pass",
        "error"
      ],
      "properties": {
        "seq": {
          "$ref": "defs.schema.json#/$defs/seq"
        },
        "attempt": {
          "$ref": "defs.schema.json#/$defs/attempt"
        },
        "session_id": {
          "$ref": "defs.schema.json#/$defs/uuid"
        },
        "image_id": {
          "$ref": "defs.schema.json#/$defs/uuid"
        },
        "sku_id": {
          "$ref": "defs.schema.json#/$defs/uuid"
        },
        "status": {
          "enum": [
            "generating",
            "to_review",
            "failed"
          ],
          "description": "generating = a progress event while the image renders: key and review null, attempts_detail the tries so far (each stored as it rendered; the last one's review null while the reviewer looks at it, best always false); catalog stores the tries on the still-generating image and ignores a progress event after the final one. to_review or failed = the final event"
        },
        "key": {
          "oneOf": [
            {
              "$ref": "defs.schema.json#/$defs/objectKey"
            },
            {
              "type": "null"
            }
          ]
        },
        "review": {
          "oneOf": [
            {
              "$ref": "#/$defs/review"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempts": {
          "type": "integer",
          "minimum": 0,
          "description": "renders made for this image (1 + regenerations); metrics: tries per image"
        },
        "attempts_detail": {
          "type": "array",
          "description": "every render try of this image in order, each stored under images/<image_id>/attempt_<n>.<ext>; the best one is also `key`. Absent = not kept",
          "items": {
            "type": "object",
            "required": [
              "n",
              "key",
              "review",
              "failed_goals",
              "best"
            ],
            "properties": {
              "n": {
                "type": "integer",
                "minimum": 1,
                "description": "1 = the first try"
              },
              "key": {
                "$ref": "defs.schema.json#/$defs/objectKey"
              },
              "review": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/review"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "failed_goals": {
                "type": "integer",
                "minimum": 0,
                "description": "blocking goals the review failed (the best try has the fewest, earliest on a tie)"
              },
              "best": {
                "type": "boolean",
                "description": "the try kept as the image (`key`)"
              }
            }
          }
        },
        "first_pass": {
          "type": "boolean",
          "description": "the first render passed review (attempts 1 and review.passed); false for a failed image. Metrics: first-try pass rate"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "to_review"
              }
            }
          },
          "then": {
            "properties": {
              "key": {
                "$ref": "defs.schema.json#/$defs/objectKey"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "properties": {
              "error": {
                "type": "string"
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "review": {
      "type": "object",
      "required": [
        "passed",
        "summary",
        "goals"
      ],
      "properties": {
        "passed": {
          "type": "boolean"
        },
        "summary": {
          "type": "string",
          "maxLength": 1000
        },
        "goals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "goal",
              "passed"
            ],
            "properties": {
              "goal": {
                "enum": [
                  "count",
                  "motif",
                  "finish",
                  "placement",
                  "background",
                  "identity",
                  "pieces",
                  "colour",
                  "print",
                  "drape",
                  "details",
                  "shape",
                  "material",
                  "extras"
                ],
                "description": "jewellery: count, motif, finish, placement, background, identity; garments: pieces, colour, print, drape, details, background, identity; furniture: shape, material, colour, background, extras"
              },
              "passed": {
                "type": "boolean"
              },
              "note": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        }
      }
    }
  }
}
