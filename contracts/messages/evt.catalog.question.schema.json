{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ora.local/contracts/messages/evt.catalog.question.schema.json",
  "title": "a processing check hit: a chat question with two answers (catalog upserts on (session_id, key); an answered key is never asked again)",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "evt.catalog.question"
    },
    "version": {
      "const": 1
    },
    "job_id": {
      "$ref": "defs.schema.json#/$defs/uuid"
    },
    "data": {
      "type": "object",
      "required": [
        "seq",
        "attempt",
        "session_id",
        "key",
        "check",
        "text",
        "options",
        "blocking",
        "sku_codes"
      ],
      "properties": {
        "seq": {
          "$ref": "defs.schema.json#/$defs/seq"
        },
        "attempt": {
          "$ref": "defs.schema.json#/$defs/attempt"
        },
        "session_id": {
          "$ref": "defs.schema.json#/$defs/uuid"
        },
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9_.:-]{1,128}$",
          "description": "dedupe key, e.g. guidelines_vs_images:rings"
        },
        "check": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$",
          "description": "a catalog_checks id"
        },
        "text": {
          "type": "string",
          "maxLength": 1000
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "required": [
              "label",
              "apply"
            ],
            "properties": {
              "label": {
                "type": "string",
                "maxLength": 100
              },
              "apply": {
                "type": "array",
                "description": "SKU changes catalog_service makes when this option is chosen",
                "items": {
                  "type": "object",
                  "required": [
                    "sku_code"
                  ],
                  "minProperties": 2,
                  "properties": {
                    "sku_code": {
                      "$ref": "defs.schema.json#/$defs/skuCode"
                    },
                    "brief": {
                      "type": "object",
                      "properties": {
                        "model": {
                          "$ref": "defs.schema.json#/$defs/choiceId"
                        },
                        "background": {
                          "$ref": "defs.schema.json#/$defs/choiceId"
                        },
                        "poses": {
                          "type": "array",
                          "items": {
                            "$ref": "defs.schema.json#/$defs/libraryId"
                          }
                        }
                      }
                    },
                    "attributes": {
                      "$ref": "defs.schema.json#/$defs/attributesPatch"
                    },
                    "confirmed": {
                      "type": "boolean"
                    },
                    "category": {
                      "$ref": "defs.schema.json#/$defs/libraryId",
                      "description": "move the SKU to this product (a library category), as the drawer does: code and images stay"
                    },
                    "subcategory": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
                      "description": "set the SKU's subcategory, one of its (target) product's; null clears it"
                    },
                    "merge_into": {
                      "$ref": "defs.schema.json#/$defs/skuCode",
                      "description": "fold this SKU's raw images into that SKU and delete it"
                    }
                  }
                }
              }
            }
          }
        },
        "blocking": {
          "type": "boolean"
        },
        "sku_codes": {
          "type": "array",
          "items": {
            "$ref": "defs.schema.json#/$defs/skuCode"
          }
        }
      }
    }
  }
}
