{
  "description": "API 1.32 dialogue scripts (README, Dialogue and Timeline audio: scripts; check.py expand_script, echo_dialogue, script_check). `library` holds the caller's elements as studio reads them (a deleted voice already null), `voices` the voices it can use now (own and live starter ones, LibraryItems). Each case lays `params` over the workflow and expands it; `take` is what the fake echo/dialogue makes of the lines. `checks` are write-script/v1 answers checked against a cast",
  "workflows": {
    "echo-dialogue": {
      "title": "Echo dialogue",
      "family": "echo",
      "env": "fake",
      "nodes": {
        "dialogue": {
          "kind": "echo/dialogue",
          "params": {
            "script": "",
            "lines": [],
            "pause": 0.35,
            "seed": -1,
            "delay_ms": 300
          }
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "dialogue.audio"
          }
        }
      }
    },
    "echo-dialogue-pinned": {
      "title": "Echo dialogue, presets and clips only",
      "family": "echo",
      "env": "fake",
      "nodes": {
        "dialogue": {
          "kind": "echo/dialogue",
          "params": {
            "script": "",
            "lines": [],
            "pause": 0.35,
            "seed": -1,
            "delay_ms": 300
          },
          "only": {
            "lines": [
              "preset",
              "clip"
            ]
          }
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "dialogue.audio"
          }
        }
      }
    },
    "qwen3-tts-dialogue": {
      "title": "Qwen3-TTS Dialogue",
      "family": "qwen3-tts",
      "env": "torch",
      "nodes": {
        "seed": {
          "kind": "seed",
          "params": {
            "seed": -1
          }
        },
        "model": {
          "kind": "qwen3-tts/model",
          "params": {
            "variant": "custom_voice",
            "precision": "bf16"
          },
          "only": {
            "variant": [
              "custom_voice"
            ]
          }
        },
        "dialogue": {
          "kind": "qwen3-tts/dialogue",
          "in": {
            "model": "model.model",
            "seed": "seed.seed"
          },
          "params": {
            "script": "",
            "lines": [],
            "pause": 0.35,
            "language": "auto",
            "temperature": 0.3
          }
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "dialogue.audio"
          }
        }
      }
    },
    "zonos3-dialogue": {
      "title": "ZONOS3 Dialogue",
      "family": "zonos3",
      "env": "native",
      "nodes": {
        "seed": {
          "kind": "seed",
          "params": {
            "seed": -1
          }
        },
        "model": {
          "kind": "zonos3/model",
          "params": {
            "variant": "mini",
            "precision": "int8"
          }
        },
        "dialogue": {
          "kind": "zonos3/dialogue",
          "in": {
            "model": "model.model",
            "seed": "seed.seed"
          },
          "params": {
            "script": "",
            "lines": [],
            "pause": 0.35,
            "language": "en-US",
            "emotion": 0.5,
            "energy": 0.5,
            "whisper": 0,
            "speaking_rate": 1,
            "guidance": 2
          }
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "dialogue.audio"
          }
        }
      }
    }
  },
