  "cases": [
    {
      "description": "the board's script on echo: a style, a capital handle, an empty line doubles the pause before line 3; the script goes empty, typed keeps it; Jon's cloned clip is a parent",
      "workflow": "echo-dialogue",
      "params": {
        "dialogue.script": "@mara (quiet): You said you'd be back by noon.\n@Jon: I know. The road was closed.\n\n@mara: Then you should have called."
      },
      "expect": {
        "inputs": {
          "dialogue.script": "",
          "dialogue.lines": [
            {
              "voice": {
                "voice_id": "echo/ada"
              },
              "text": "You said you'd be back by noon.",
              "style": "quiet",
              "pause_s": 0.35
            },
            {
              "voice": {
                "voice_id": "5a0c1e2f-3b4d-4e5f-8a6b-7c8d9e0f1a22"
              },
              "text": "I know. The road was closed.",
              "style": "",
              "pause_s": 0.7
            },
            {
              "voice": {
                "voice_id": "echo/ada"
              },
              "text": "Then you should have called.",
              "style": "",
              "pause_s": 0
            }
          ]
