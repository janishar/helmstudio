{
  "description": "voice_fit (README, Voices: fit): GET /library?workflow= for voices, and looks and elements in a workflow whose media is audio (look_fit); items are LibraryItems",
  "workflows": {
    "echo-voice-over": {
      "title": "Echo voice-over",
      "family": "echo",
      "env": "fake",
      "nodes": {
        "prompt": {
          "kind": "prompt",
          "params": {
            "text": "Hello there, how are you, Ada?"
          }
        },
        "speak": {
          "kind": "echo/speak",
          "in": {
            "text": "prompt.text"
          },
          "params": {
            "voice": null,
            "seed": -1,
            "delay_ms": 300
          }
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "speak.audio"
          }
        }
      }
    },
    "echo": {
      "title": "Echo",
      "family": "echo",
      "env": "fake",
      "nodes": {
        "prompt": {
          "kind": "prompt",
          "params": {
            "text": "a fox"
          }
        },
        "echo": {
          "kind": "echo/echo",
          "in": {
            "text": "prompt.text"
          }
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "echo.image"
          }
        }
      }
    },
    "test-speak": {
      "title": "Test speak",
      "family": "test",
      "env": "fake",
      "nodes": {
        "prompt": {
          "kind": "prompt",
          "params": {
            "text": "A line of exactly thirty chars"
          }
        },
        "speak": {
          "kind": "test/speak",
          "in": {
            "text": "prompt.text"
          }
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "speak.audio"
          }
        }
      }
    },
    "speak-bypassed": {
      "title": "Echo voice-over",
      "family": "echo",
      "env": "fake",
      "nodes": {
        "prompt": {
          "kind": "prompt",
          "params": {
            "text": "Hello there, how are you, Ada?"
          }
        },
        "speak": {
          "kind": "echo/speak",
          "in": {
            "text": "prompt.text"
          },
          "params": {
            "voice": null,
            "seed": -1,
            "delay_ms": 300
          },
          "bypass": true
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "speak.audio"
          }
        }
      }
    }
  },
