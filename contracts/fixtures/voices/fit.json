{
  "description": "voice_fit (README, Voices: fit): GET /library?workflow= for voices, and looks and elements in a workflow whose media is audio (look_fit); items are LibraryItems",
  "workflows": {
    "echo-voice-over": {
      "title": "Echo voice-over",
      "family": "echo",
      "env": "fake",
      "nodes": {
        "prompt": {
          "kind": "prompt",
          "params": {
            "text": "Hello there, how are you, Ada?"
          }
        },
        "speak": {
          "kind": "echo/speak",
          "in": {
            "text": "prompt.text"
          },
          "params": {
            "voice": null,
            "seed": -1,
            "delay_ms": 300
          }
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "speak.audio"
          }
        }
      }
    },
    "echo": {
      "title": "Echo",
      "family": "echo",
      "env": "fake",
      "nodes": {
        "prompt": {
          "kind": "prompt",
          "params": {
            "text": "a fox"
          }
        },
        "echo": {
          "kind": "echo/echo",
          "in": {
            "text": "prompt.text"
          }
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "echo.image"
          }
        }
      }
    },
    "test-speak": {
      "title": "Test speak",
      "family": "test",
      "env": "fake",
      "nodes": {
        "prompt": {
          "kind": "prompt",
          "params": {
            "text": "A line of exactly thirty chars"
          }
        },
        "speak": {
          "kind": "test/speak",
          "in": {
            "text": "prompt.text"
          }
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "speak.audio"
          }
        }
      }
    },
    "speak-bypassed": {
      "title": "Echo voice-over",
      "family": "echo",
      "env": "fake",
      "nodes": {
        "prompt": {
          "kind": "prompt",
          "params": {
            "text": "Hello there, how are you, Ada?"
          }
        },
        "speak": {
          "kind": "echo/speak",
          "in": {
            "text": "prompt.text"
          },
          "params": {
            "voice": null,
            "seed": -1,
            "delay_ms": 300
          },
          "bypass": true
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "speak.audio"
          }
        }
      }
    },
    "echo-presets-only": {
      "title": "Echo voice-over, presets only",
      "family": "echo",
      "env": "fake",
      "nodes": {
        "prompt": {
          "kind": "prompt",
          "params": {
            "text": "Hello there, how are you, Ada?"
          }
        },
        "speak": {
          "kind": "echo/speak",
          "in": {
            "text": "prompt.text"
          },
          "params": {
            "voice": null,
            "seed": -1,
            "delay_ms": 300
          },
          "only": {
            "voice": [
              "preset"
            ]
          }
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "speak.audio"
          }
        }
      }
    },
    "zonos3-voice-over": {
      "title": "ZONOS3 Voice-over",
      "family": "zonos3",
      "env": "native",
      "nodes": {
        "prompt": {
          "kind": "prompt",
          "params": {
            "text": ""
          }
        },
        "seed": {
          "kind": "seed",
          "params": {
            "seed": -1
          }
        },
        "model": {
          "kind": "zonos3/model",
          "params": {
            "variant": "mini",
            "precision": "int8"
          }
        },
        "speak": {
          "kind": "zonos3/speak",
          "in": {
            "model": "model.model",
            "text": "prompt.text",
            "seed": "seed.seed"
          },
          "params": {
            "voice": null,
            "language": "en-US",
            "emotion": 0.5,
            "energy": 0.5,
            "whisper": 0,
            "speaking_rate": 1,
            "guidance": 2
          },
          "only": {
            "voice": [
              "preset",
              "clip"
            ]
          }
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "speak.audio"
          }
        }
      },
      "studio": {
        "composer": [
          "prompt.text"
        ],
        "quick": [
          "speak.voice",
          "speak.language",
          "seed.seed"
        ],
        "inspector": [
          {
            "title": "Delivery",
            "items": [
              "speak.emotion",
              "speak.energy",
              "speak.whisper",
              "speak.speaking_rate",
              "speak.guidance"
            ]
          }
        ],
        "presets": {
          "Neutral": {
            "speak.emotion": 0.5,
            "speak.energy": 0.5,
            "speak.whisper": 0,
            "speak.speaking_rate": 1,
            "speak.guidance": 2
          },
          "Warm": {
            "speak.emotion": 0.7,
            "speak.energy": 0.45,
            "speak.whisper": 0,
            "speak.speaking_rate": 0.95,
            "speak.guidance": 2
          },
          "Tense": {
            "speak.emotion": 0.3,
            "speak.energy": 0.75,
            "speak.whisper": 0,
            "speak.speaking_rate": 1.1,
            "speak.guidance": 2.5
          },
          "Whisper": {
            "speak.emotion": 0.5,
            "speak.energy": 0.25,
            "speak.whisper": 0.9,
            "speak.speaking_rate": 0.9,
            "speak.guidance": 2
          }
        },
        "preset_order": [
          "Neutral",
          "Warm",
          "Tense",
          "Whisper"
        ]
      }
    },
    "qwen3-tts-voice-over": {
      "title": "Qwen3-TTS Voice-over",
      "family": "qwen3-tts",
      "env": "torch",
      "nodes": {
        "prompt": {
          "kind": "prompt",
          "params": {
            "text": ""
          }
        },
        "seed": {
          "kind": "seed",
          "params": {
            "seed": -1
          }
        },
        "model": {
          "kind": "qwen3-tts/model",
          "params": {
            "variant": "custom_voice",
            "precision": "bf16"
          },
          "only": {
            "variant": [
              "custom_voice"
            ]
          }
        },
        "speak": {
          "kind": "qwen3-tts/speak",
          "in": {
            "model": "model.model",
            "text": "prompt.text",
            "seed": "seed.seed"
          },
          "params": {
            "voice": null,
            "language": "auto",
            "style": "",
            "temperature": 0.3
          },
          "only": {
            "voice": [
              "preset"
            ]
          }
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "speak.audio"
          }
        }
      },
      "studio": {
        "composer": [
          "prompt.text"
        ],
        "quick": [
          "speak.voice",
          "speak.language",
          "seed.seed"
        ],
        "inspector": [
          {
            "title": "Voice",
            "items": [
              "speak.style",
              "speak.temperature"
            ]
          }
        ],
        "presets": {
          "Steady": {
            "speak.temperature": 0.3
          },
          "Lively": {
            "speak.temperature": 0.9
          }
        },
        "preset_order": [
          "Steady",
          "Lively"
        ]
      }
    },
