{
  "id": "echo",
  "title": "Echo",
  "family": "echo",
  "env": "fake",
  "nodes": {
    "prompt": {
      "kind": "prompt",
      "params": {
        "text": ""
      }
    },
    "echo": {
      "kind": "echo/echo",
      "in": {
        "text": "prompt.text"
      },
      "params": {
        "steps": 10,
        "delay_ms": 300,
        "fail": false,
        "refs": []
      }
    },
    "output": {
      "kind": "output",
      "in": {
        "media": "echo.image"
      }
    }
  },
  "node_schemas": {
    "prompt": {
      "kind": "prompt",
      "title": "Prompt",
      "family": null,
      "help": "The text the workflow starts from.",
      "params": [
        {
          "name": "text",
          "type": "text",
          "label": "Prompt",
          "default": "",
          "min": 0,
          "max": 4000
        }
      ],
      "inputs": [],
      "outputs": [
        {
          "name": "text",
          "type": "Text"
        }
      ]
    },
    "echo/echo": {
      "kind": "echo/echo",
      "title": "Echo",
      "family": "echo",
      "help": "Fake model: draws its text on a gradient, one progress step at a time.",
      "params": [
        {
          "name": "steps",
          "type": "int",
          "label": "Steps",
          "default": 10,
          "min": 1,
          "max": 200,
          "help": "Progress steps to report."
        },
        {
          "name": "delay_ms",
          "type": "int",
          "label": "Delay per step (ms)",
          "default": 300,
          "min": 0,
          "max": 10000
        },
        {
          "name": "fail",
          "type": "bool",
          "label": "Fail",
          "default": false,
          "help": "Fail after the last step, without an output, to test errors."
        },
        {
          "name": "refs",
          "type": "rows",
          "label": "References",
          "default": [],
          "min": 0,
          "max": 10,
          "item": {
            "image": "Image"
          },
          "mention": "<image{n}>",
          "help": "Images the fake runner reads (and checks) before it echoes; the PNG is unchanged."
        }
      ],
      "inputs": [
        {
          "name": "text",
          "type": "Text"
        }
      ],
      "outputs": [
        {
          "name": "image",
          "type": "Image"
        }
      ]
    },
    "output": {
      "kind": "output",
      "title": "Output",
      "family": null,
      "help": "Stores its input as a run output.",
      "params": [],
      "inputs": [
        {
          "name": "media",
          "type": "Image"
        }
      ],
      "outputs": []
    }
  },
  "source": "template",
  "problems": []
}
