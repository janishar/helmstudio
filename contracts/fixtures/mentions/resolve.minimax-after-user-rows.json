{
  "description": "minimax-h3-image, an element after a user row: it is appended as <Picture 2>; the auto canvas is not pinned (it follows the first row, still the user's)",
  "workflow": {
    "title": "MiniMax H3 Image",
    "family": "minimax-h3-image",
    "env": "torch",
    "nodes": {
      "prompt": {
        "kind": "prompt",
        "params": {
          "text": "Put @owl into <Picture 1>"
        }
      },
      "seed": {
        "kind": "seed"
      },
      "canvas": {
        "kind": "minimax-h3-image/canvas"
      },
      "model": {
        "kind": "minimax-h3-image/model"
      },
      "enhance": {
        "kind": "minimax-h3-image/enhance",
        "bypass": true,
        "in": {
          "prompt": "prompt.text",
          "canvas": "canvas.canvas",
          "seed": "seed.seed"
        }
      },
      "encode": {
        "kind": "minimax-h3-image/encode",
        "in": {
          "model": "model.model",
          "prompt": "enhance.text"
        },
        "params": {
          "refs": [
            {
              "image": {
                "take_id": "00000000-0000-4000-8000-000000000009"
              }
            }
          ]
        }
      },
      "sample": {
        "kind": "minimax-h3-image/sample",
        "in": {
          "model": "model.model",
          "cond": "encode.cond",
          "canvas": "enhance.canvas",
          "seed": "seed.seed"
        }
      },
      "decode": {
        "kind": "minimax-h3-image/decode",
        "in": {
          "model": "model.model",
          "latent": "sample.latent"
        }
      },
      "output": {
        "kind": "output",
        "in": {
          "media": "decode.image"
        }
      }
    }
  },
  "sizes": {
    "00000000-0000-4000-8000-000000000009": [
      1920,
      1080
    ]
  },
  "library": [
    {
      "id": "e0000000-0000-4000-8000-000000000004",
      "handle": "owl",
      "name": "Owl",
      "version": 1,
      "text": "",
      "images": [
        "00000000-0000-4000-8000-000000000011"
      ]
    }
  ],
  "expect": {
    "inputs": {
      "prompt.text": "Put Owl <Picture 2> into <Picture 1>",
      "encode.refs": [
        {
          "image": {
            "take_id": "00000000-0000-4000-8000-000000000009"
          }
        },
        {
          "image": {
            "take_id": "00000000-0000-4000-8000-000000000011"
          }
        }
      ]
    },
    "typed": {
      "prompt.text": "Put @owl into <Picture 1>",
      "encode.refs": [
        {
          "image": {
            "take_id": "00000000-0000-4000-8000-000000000009"
          }
        }
      ]
    },
    "elements": [
      {
        "id": "e0000000-0000-4000-8000-000000000004",
        "handle": "owl",
        "name": "Owl",
        "version": 1
      }
    ]
  }
}
