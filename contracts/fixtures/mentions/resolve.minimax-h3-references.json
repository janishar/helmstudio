{
  "description": "minimax-h3-references: an element's images go to generate.refs as <Picture n> after the user's row; the user's video row (generate.videos, <Video {n}>, a media field: never reference rows) is untouched",
  "workflow": {
    "title": "MiniMax H3 References",
    "family": "minimax-h3",
    "env": "native",
    "nodes": {
      "prompt": {
        "kind": "prompt",
        "params": {
          "text": "@hero walks out of <Video 1> into the rain"
        }
      },
      "seed": {
        "kind": "seed",
        "params": {
          "seed": -1
        }
      },
      "canvas": {
        "kind": "minimax-h3/canvas",
        "params": {
          "width": 864,
          "height": 480
        }
      },
      "duration": {
        "kind": "minimax-h3/duration",
        "params": {
          "frames": 124,
          "fps": 24
        }
      },
      "model": {
        "kind": "minimax-h3/model",
        "params": {
          "variant": "base",
          "precision": "int8"
        }
      },
      "generate": {
        "kind": "minimax-h3/generate",
        "in": {
          "model": "model.model",
          "prompt": "prompt.text",
          "seed": "seed.seed",
          "canvas": "canvas.canvas",
          "duration": "duration.duration"
        },
        "params": {
          "steps": 6,
          "speed": "exact",
          "refs": [
            {
              "image": {
                "take_id": "00000000-0000-4000-8000-00000000b003"
              }
            }
          ],
          "videos": [
            {
              "video": {
                "take_id": "00000000-0000-4000-8000-00000000b010",
                "in": 0,
                "out": 4.0
              },
              "sound": "keep"
            }
          ],
          "audios": []
        }
      },
      "output": {
        "kind": "output",
        "in": {
          "media": "generate.video"
        }
      }
    },
    "studio": {
      "composer": [
        "prompt.text",
        "generate.refs",
        "generate.videos",
        "generate.audios"
      ],
      "quick": [
        "elements",
        "generate.speed",
        "seed.seed"
      ],
      "inspector": [
        {
          "title": "Canvas",
          "items": [
            "canvas.width",
            "canvas.height"
          ]
        },
        {
          "title": "Duration",
          "items": [
            "duration.frames"
          ]
        },
        {
          "title": "Quality",
          "items": [
            "generate.steps"
          ]
        }
      ]
    }
  },
  "library": [
    {
      "id": "e0000000-0000-4000-8000-0000000000b1",
      "handle": "hero",
      "name": "Hero",
      "version": 1,
      "text": "a tall woman in a red coat",
      "images": [
        "00000000-0000-4000-8000-00000000b001",
        "00000000-0000-4000-8000-00000000b002"
      ]
    }
  ],
  "expect": {
    "inputs": {
      "generate.refs": [
        {
          "image": {
            "take_id": "00000000-0000-4000-8000-00000000b003"
          }
        },
        {
          "image": {
            "take_id": "00000000-0000-4000-8000-00000000b001"
          }
        },
        {
          "image": {
            "take_id": "00000000-0000-4000-8000-00000000b002"
          }
        }
      ],
      "prompt.text": "Hero <Picture 2> <Picture 3> walks out of <Video 1> into the rain\n\nHero: a tall woman in a red coat"
    },
    "typed": {
      "generate.refs": [
        {
          "image": {
            "take_id": "00000000-0000-4000-8000-00000000b003"
          }
        }
      ],
      "prompt.text": "@hero walks out of <Video 1> into the rain"
    },
    "elements": [
      {
        "id": "e0000000-0000-4000-8000-0000000000b1",
        "handle": "hero",
        "name": "Hero",
        "version": 1
      }
    ]
  }
}
