{
  "description": "minimax-h3-image-to-video: first is wired, so generate.refs (not_with first, last) is not reference rows; a mention becomes the element's name and text only, and the run does not hit the references refusal",
  "workflow": {
    "title": "MiniMax H3 Image to video",
    "family": "minimax-h3",
    "env": "native",
    "nodes": {
      "prompt": {
        "kind": "prompt",
        "params": {
          "text": "@hero turns to the camera"
        }
      },
      "seed": {
        "kind": "seed",
        "params": {
          "seed": -1
        }
      },
      "canvas": {
        "kind": "minimax-h3/canvas",
        "params": {
          "width": 864,
          "height": 480
        }
      },
      "duration": {
        "kind": "minimax-h3/duration",
        "params": {
          "frames": 124,
          "fps": 24
        }
      },
      "model": {
        "kind": "minimax-h3/model",
        "params": {
          "variant": "base",
          "precision": "int8"
        }
      },
      "first": {
        "kind": "image",
        "params": {
          "image": {
            "take_id": "00000000-0000-4000-8000-00000000b004"
          }
        }
      },
      "last": {
        "kind": "image",
        "optional": true,
        "params": {
          "image": null
        }
      },
      "generate": {
        "kind": "minimax-h3/generate",
        "in": {
          "model": "model.model",
          "prompt": "prompt.text",
          "seed": "seed.seed",
          "canvas": "canvas.canvas",
          "duration": "duration.duration",
          "first": "first.image",
          "last": "last.image"
        },
        "params": {
          "steps": 6,
          "layers": 50,
          "reuse": 1,
          "refs": [],
          "videos": [],
          "audios": []
        }
      },
      "output": {
        "kind": "output",
        "in": {
          "media": "generate.video"
        }
      }
    },
    "studio": {
      "composer": [
        "prompt.text",
        "first.image",
        "last.image"
      ],
      "quick": [
        "seed.seed"
      ],
      "inspector": [
        {
          "title": "Canvas",
          "items": [
            "canvas.width",
            "canvas.height"
          ]
        },
        {
          "title": "Duration",
          "items": [
            "duration.frames"
          ]
        },
        {
          "title": "Quality",
          "items": [
            "generate.steps"
          ]
        }
      ],
      "labels": {
        "first.image": "First frame",
        "last.image": "Last frame"
      }
    }
  },
  "library": [
    {
      "id": "e0000000-0000-4000-8000-0000000000b1",
      "handle": "hero",
      "name": "Hero",
      "version": 1,
      "text": "a tall woman in a red coat",
      "images": [
        "00000000-0000-4000-8000-00000000b001",
        "00000000-0000-4000-8000-00000000b002"
      ]
    }
  ],
  "expect": {
    "inputs": {
      "prompt.text": "Hero turns to the camera\n\nHero: a tall woman in a red coat"
    },
    "typed": {
      "prompt.text": "@hero turns to the camera"
    },
    "elements": [
      {
        "id": "e0000000-0000-4000-8000-0000000000b1",
        "handle": "hero",
        "name": "Hero",
        "version": 1
      }
    ]
  }
}
