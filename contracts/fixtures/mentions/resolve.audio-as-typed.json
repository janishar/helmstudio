{
  "description": "(API 1.30) an audio workflow's prompt reaches the runner as typed: literal @ (an address, @@, a time) is not a mention and nothing is expanded",
  "workflow": {
    "title": "Echo voice-over",
    "family": "echo",
    "env": "fake",
    "nodes": {
      "prompt": {
        "kind": "prompt",
        "params": {
          "text": "Mail mara@example.com at @ 3pm, say @@home."
        }
      },
      "speak": {
        "kind": "echo/speak",
        "in": {
          "text": "prompt.text"
        },
        "params": {
          "voice": null,
          "seed": -1,
          "delay_ms": 300
        }
      },
      "output": {
        "kind": "output",
        "in": {
          "media": "speak.audio"
        }
      }
    }
  },
  "library": [
    {
      "id": "e1a2b3c4-5d6e-4f70-8a91-b2c3d4e5f601",
      "handle": "mara",
      "name": "Mara",
      "version": 1,
      "text": "a tired courier",
      "images": []
    }
  ],
  "expect": {}
}
