{
  "description": "ltx (no reference rows): a mention becomes the element's name and its text; its images never go into keyframes.images",
  "workflow": {
    "title": "LTX-2.5 Image to video",
    "family": "ltx",
    "env": "mlx",
    "nodes": {
      "prompt": {
        "kind": "prompt",
        "params": {
          "text": "@fox runs"
        }
      },
      "seed": {
        "kind": "seed",
        "params": {
          "seed": -1
        }
      },
      "canvas": {
        "kind": "ltx/canvas",
        "params": {
          "width": 704,
          "height": 448
        }
      },
      "duration": {
        "kind": "ltx/duration",
        "params": {
          "frames": 49,
          "fps": 24
        }
      },
      "model": {
        "kind": "ltx/model",
        "params": {
          "variant": "distilled",
          "precision": "int8"
        }
      },
      "lora": {
        "kind": "ltx/lora-stack",
        "in": {
          "model": "model.model"
        },
        "params": {
          "rows": []
        }
      },
      "encode": {
        "kind": "ltx/encode",
        "in": {
          "model": "model.model",
          "prompt": "prompt.text"
        },
        "params": {
          "beats": []
        }
      },
      "keyframes": {
        "kind": "ltx/keyframes",
        "in": {
          "cond": "encode.cond"
        },
        "params": {
          "images": []
        }
      },
      "sample1": {
        "kind": "ltx/sample",
        "in": {
          "model": "lora.model",
          "cond": "keyframes.cond",
          "seed": "seed.seed",
          "canvas": "canvas.canvas",
          "duration": "duration.duration"
        },
        "params": {
          "role": "stage1",
          "steps": 8
        }
      },
      "upscale": {
        "kind": "ltx/upscale",
        "in": {
          "model": "model.model",
          "latent": "sample1.latent"
        },
        "params": {}
      },
      "sample2": {
        "kind": "ltx/sample",
        "in": {
          "model": "lora.model",
          "cond": "keyframes.cond",
          "seed": "seed.seed",
          "latent": "upscale.latent"
        },
        "params": {
          "role": "stage2",
          "steps": 3
        }
      },
      "decode": {
        "kind": "ltx/decode",
        "in": {
          "model": "model.model",
          "latent": "sample2.latent"
        },
        "params": {
          "audio": true
        }
      },
      "output": {
        "kind": "output",
        "in": {
          "media": "decode.video"
        }
      }
    },
    "studio": {
      "composer": [
        "prompt.text"
      ],
      "quick": [
        "keyframes.images",
        "elements",
        "look:film",
        "look:camera",
        "look:lighting",
        "model.variant",
        "decode.audio"
      ],
      "inspector": [
        {
          "title": "Canvas",
          "items": [
            "canvas.width",
            "canvas.height"
          ]
        },
        {
          "title": "Duration",
          "items": [
            "duration.frames",
            "duration.fps"
          ]
        },
        {
          "title": "Quality",
          "items": [
            "model.precision",
            "sample1.steps",
            "sample2.steps"
          ]
        },
        {
          "title": "Prompt beats",
          "items": [
            "encode.beats"
          ]
        },
        {
          "title": "LoRA",
          "items": [
            "lora.rows"
          ]
        }
      ],
      "labels": {
        "sample1.steps": "Stage 1 steps",
        "sample2.steps": "Stage 2 steps",
        "keyframes.images": "Frames"
      },
      "presets": {
        "Fast": {
          "model.precision": "int8"
        },
        "Quality": {
          "model.precision": "bf16"
        },
        "Low memory": {
          "model.precision": "int4"
        }
      }
    }
  },
  "library": [
    {
      "id": "e0000000-0000-4000-8000-0000000000a1",
      "handle": "fox",
      "name": "Fox",
      "version": 2,
      "text": "a red fox",
      "images": [
        "00000000-0000-4000-8000-00000000a002"
      ]
    }
  ],
  "expect": {
    "inputs": {
      "prompt.text": "Fox runs\n\nFox: a red fox"
    },
    "typed": {
      "prompt.text": "@fox runs"
    },
    "elements": [
      {
        "id": "e0000000-0000-4000-8000-0000000000a1",
        "handle": "fox",
        "name": "Fox",
        "version": 2
      }
    ]
  }
}
