{
  "description": "a prompt without mentions or @@ changes nothing",
  "workflow": {
    "title": "Qwen Image",
    "family": "qwen-image",
    "env": "torch",
    "nodes": {
      "prompt": {
        "kind": "prompt",
        "params": {
          "text": "a red fox, mail me@fox.com"
        }
      },
      "seed": {
        "kind": "seed"
      },
      "canvas": {
        "kind": "canvas"
      },
      "model": {
        "kind": "qwen-image/model"
      },
      "encode": {
        "kind": "qwen-image/encode",
        "in": {
          "model": "model.model",
          "prompt": "prompt.text"
        },
        "params": {
          "refs": [
            {
              "image": {
                "take_id": "00000000-0000-4000-8000-000000000009"
              }
            }
          ]
        }
      },
      "sample": {
        "kind": "qwen-image/sample",
        "in": {
          "model": "model.model",
          "cond": "encode.cond",
          "canvas": "canvas.canvas",
          "seed": "seed.seed"
        }
      },
      "decode": {
        "kind": "qwen-image/decode",
        "in": {
          "model": "model.model",
          "latent": "sample.latent"
        }
      },
      "output": {
        "kind": "output",
        "in": {
          "media": "decode.image"
        }
      }
    }
  },
  "library": [
    {
      "id": "e0000000-0000-4000-8000-000000000001",
      "handle": "fox",
      "name": "Fox",
      "version": 3,
      "text": "a small red fox with a white-tipped tail",
      "images": [
        "00000000-0000-4000-8000-000000000001",
        "00000000-0000-4000-8000-000000000002"
      ]
    }
  ],
  "expect": {}
}
