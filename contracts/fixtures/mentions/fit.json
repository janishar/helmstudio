    "echo": {
      "title": "Echo",
      "family": "echo",
      "env": "fake",
      "nodes": {
        "prompt": {
          "kind": "prompt",
          "params": {
            "text": ""
          }
        },
        "echo": {
          "kind": "echo/echo",
          "in": {
            "text": "prompt.text"
          },
          "params": {
            "steps": 10,
            "delay_ms": 300,
            "fail": false,
            "refs": []
          }
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "echo.image"
          }
        }
      }
