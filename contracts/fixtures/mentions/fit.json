{
  "description": "the fit rules (README, Looks: fit): item → the reason it cannot be applied to the workflow, null when it can; `loras` = LoRA id → detected family of the LoRAs the caller can use now",
  "workflows": {
    "qwen-basic": {
      "title": "Qwen Image",
      "family": "qwen-image",
      "env": "torch",
      "nodes": {
        "prompt": {
          "kind": "prompt",
          "params": {
            "text": "@fox in @snowfield at dusk"
          }
        },
        "seed": {
          "kind": "seed"
        },
        "canvas": {
          "kind": "canvas"
        },
        "model": {
          "kind": "qwen-image/model"
        },
        "encode": {
          "kind": "qwen-image/encode",
          "in": {
            "model": "model.model",
            "prompt": "prompt.text"
          },
          "params": {
            "refs": []
          }
        },
        "sample": {
          "kind": "qwen-image/sample",
          "in": {
            "model": "model.model",
            "cond": "encode.cond",
            "canvas": "canvas.canvas",
            "seed": "seed.seed"
          }
        },
        "decode": {
          "kind": "qwen-image/decode",
          "in": {
            "model": "model.model",
            "latent": "sample.latent"
          }
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "decode.image"
          }
        }
      }
    },
    "qwen-lora": {
      "title": "Qwen Image + LoRA",
      "family": "qwen-image",
      "env": "torch",
      "nodes": {
        "prompt": {
          "kind": "prompt",
          "params": {
            "text": ""
          }
        },
        "seed": {
          "kind": "seed",
          "params": {
            "seed": -1
          }
        },
        "canvas": {
          "kind": "canvas",
          "params": {
            "mode": "auto",
            "width": 1024,
            "height": 1024
          }
        },
        "model": {
          "kind": "qwen-image/model",
          "params": {
            "variant": "base",
            "precision": "int8"
          }
        },
        "lora": {
          "kind": "qwen-image/lora-stack",
          "in": {
            "model": "model.model"
          },
          "params": {
            "rows": [
              {
                "lora": {
                  "lora_id": "3f0a6c1e9b2d4a7c8e5f1b3d6a9c2e4f7b0d3a6c9e2f5b8d1a4c7e0f3b6d9a2c"
                },
                "strength": 0.8,
                "mode": "adapter"
              },
              {
                "lora": {
                  "lora_id": "2c4e6a8b-1d3f-4a5b-9c7d-0e2f4a6b8c10"
                },
                "strength": 1,
                "mode": "bake"
              }
            ]
          }
        },
        "encode": {
          "kind": "qwen-image/encode",
          "in": {
            "model": "model.model",
            "prompt": "prompt.text"
          },
          "params": {
            "transparent": false,
            "refs": []
          }
        },
        "sample": {
          "kind": "qwen-image/sample",
          "in": {
            "model": "lora.model",
            "cond": "encode.cond",
            "canvas": "canvas.canvas",
            "seed": "seed.seed"
          },
          "params": {
            "steps": 40
          }
        },
        "decode": {
          "kind": "qwen-image/decode",
          "in": {
            "model": "model.model",
            "latent": "sample.latent"
          },
          "params": {
            "tiled": "auto"
          }
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "decode.image"
          }
        }
      }
    },
