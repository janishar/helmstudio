{
  "description": "look LoRAs share the stack's row cap (max 8) with the user's rows: 2 user rows + 4 fit; the next look's new LoRAs (one is already in by the earlier look) do not",
  "workflow": {
    "title": "Qwen Image + LoRA",
    "family": "qwen-image",
    "env": "torch",
    "nodes": {
      "prompt": {
        "kind": "prompt",
        "params": {
          "text": "a cabin"
        }
      },
      "seed": {
        "kind": "seed",
        "params": {
          "seed": -1
        }
      },
      "canvas": {
        "kind": "canvas",
        "params": {
          "mode": "auto",
          "width": 1024,
          "height": 1024
        }
      },
      "model": {
        "kind": "qwen-image/model",
        "params": {
          "variant": "base",
          "precision": "int8"
        }
      },
      "lora": {
        "kind": "qwen-image/lora-stack",
        "in": {
          "model": "model.model"
        },
        "params": {
          "rows": [
            {
              "lora": {
                "lora_id": "3f0a6c1e9b2d4a7c8e5f1b3d6a9c2e4f7b0d3a6c9e2f5b8d1a4c7e0f3b6d9a2c"
              },
              "strength": 0.8,
              "mode": "adapter"
            },
            {
              "lora": {
                "lora_id": "2c4e6a8b-1d3f-4a5b-9c7d-0e2f4a6b8c10"
              },
              "strength": 1,
              "mode": "bake"
            }
          ]
        }
      },
      "encode": {
        "kind": "qwen-image/encode",
        "in": {
          "model": "model.model",
          "prompt": "prompt.text"
        },
        "params": {
          "transparent": false,
          "refs": []
        }
      },
      "sample": {
        "kind": "qwen-image/sample",
        "in": {
          "model": "lora.model",
          "cond": "encode.cond",
          "canvas": "canvas.canvas",
          "seed": "seed.seed"
        },
        "params": {
          "steps": 40
        }
      },
      "decode": {
        "kind": "qwen-image/decode",
        "in": {
          "model": "model.model",
          "latent": "sample.latent"
        },
        "params": {
          "tiled": "auto"
        }
      },
      "output": {
        "kind": "output",
        "in": {
          "media": "decode.image"
        }
      }
    }
  },
  "library": [],
  "looks": [
    {
      "id": "10000000-0000-4000-8000-000000000006",
      "source": "mine",
      "name": "Four",
      "version": 1,
      "text": "",
      "images": [],
      "loras": [
        {
          "lora_id": "5b1d0000-0000-4000-8000-000000000001",
