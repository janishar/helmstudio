{
  "description": "two elements in a family with references: images numbered from 1 (no rows of the user's), the mention becomes the name and its images' tokens, texts appended after a blank line in first-mention order (an empty text adds nothing); the auto canvas is pinned to fixed (element rows never change the output size)",
  "workflow": {
    "title": "Qwen Image",
    "family": "qwen-image",
    "env": "torch",
    "nodes": {
      "prompt": {
        "kind": "prompt",
        "params": {
          "text": "@fox in @snowfield at dusk"
        }
      },
      "seed": {
        "kind": "seed"
      },
      "canvas": {
        "kind": "canvas"
      },
      "model": {
        "kind": "qwen-image/model"
      },
      "encode": {
        "kind": "qwen-image/encode",
        "in": {
          "model": "model.model",
          "prompt": "prompt.text"
        },
        "params": {
          "refs": []
        }
      },
      "sample": {
        "kind": "qwen-image/sample",
        "in": {
          "model": "model.model",
          "cond": "encode.cond",
          "canvas": "canvas.canvas",
          "seed": "seed.seed"
        }
      },
      "decode": {
        "kind": "qwen-image/decode",
        "in": {
          "model": "model.model",
          "latent": "sample.latent"
        }
      },
      "output": {
        "kind": "output",
        "in": {
          "media": "decode.image"
        }
      }
    }
  },
  "library": [
    {
      "id": "e0000000-0000-4000-8000-000000000001",
      "handle": "fox",
      "name": "Fox",
      "version": 3,
      "text": "a small red fox with a white-tipped tail",
      "images": [
        "00000000-0000-4000-8000-000000000001",
        "00000000-0000-4000-8000-000000000002"
      ]
    },
    {
      "id": "e0000000-0000-4000-8000-000000000002",
      "handle": "snowfield",
      "name": "Snowfield",
      "version": 1,
      "text": "",
      "images": [
        "00000000-0000-4000-8000-000000000003"
      ]
    }
  ],
  "expect": {
    "inputs": {
      "prompt.text": "Fox <image1> <image2> in Snowfield <image3> at dusk\n\nFox: a small red fox with a white-tipped tail",
      "encode.refs": [
        {
          "image": {
            "take_id": "00000000-0000-4000-8000-000000000001"
          }
        },
        {
          "image": {
            "take_id": "00000000-0000-4000-8000-000000000002"
          }
        },
        {
          "image": {
            "take_id": "00000000-0000-4000-8000-000000000003"
          }
        }
      ],
      "canvas.mode": "fixed"
    },
    "typed": {
      "prompt.text": "@fox in @snowfield at dusk",
      "encode.refs": [],
      "canvas.mode": "auto"
    },
    "elements": [
      {
        "id": "e0000000-0000-4000-8000-000000000001",
        "handle": "fox",
        "name": "Fox",
        "version": 3
      },
      {
        "id": "e0000000-0000-4000-8000-000000000002",
        "handle": "snowfield",
        "name": "Snowfield",
        "version": 1
      }
    ]
  }
}
