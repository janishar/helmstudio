{
  "description": "a look that does not fit is refused with the reason: a starter LoRA file no live host has, a LoRA of no known model",
  "workflow": {
    "title": "Qwen Image + LoRA",
    "family": "qwen-image",
    "env": "torch",
    "nodes": {
      "prompt": {
        "kind": "prompt",
        "params": {
          "text": "a cabin"
        }
      },
      "seed": {
        "kind": "seed",
        "params": {
          "seed": -1
        }
      },
      "canvas": {
        "kind": "canvas",
        "params": {
          "mode": "auto",
          "width": 1024,
          "height": 1024
        }
      },
      "model": {
        "kind": "qwen-image/model",
        "params": {
          "variant": "base",
          "precision": "int8"
        }
      },
      "lora": {
        "kind": "qwen-image/lora-stack",
        "in": {
          "model": "model.model"
        },
        "params": {
          "rows": [
            {
              "lora": {
                "lora_id": "3f0a6c1e9b2d4a7c8e5f1b3d6a9c2e4f7b0d3a6c9e2f5b8d1a4c7e0f3b6d9a2c"
              },
              "strength": 0.8,
              "mode": "adapter"
            },
            {
              "lora": {
                "lora_id": "2c4e6a8b-1d3f-4a5b-9c7d-0e2f4a6b8c10"
              },
              "strength": 1,
              "mode": "bake"
            }
          ]
        }
      },
      "encode": {
        "kind": "qwen-image/encode",
        "in": {
          "model": "model.model",
          "prompt": "prompt.text"
        },
        "params": {
          "transparent": false,
          "refs": []
        }
      },
      "sample": {
        "kind": "qwen-image/sample",
        "in": {
          "model": "lora.model",
          "cond": "encode.cond",
          "canvas": "canvas.canvas",
          "seed": "seed.seed"
        },
        "params": {
          "steps": 40
        }
      },
      "decode": {
        "kind": "qwen-image/decode",
        "in": {
          "model": "model.model",
          "latent": "sample.latent"
        },
        "params": {
          "tiled": "auto"
        }
      },
      "output": {
        "kind": "output",
        "in": {
          "media": "decode.image"
        }
      }
    }
  },
  "library": [],
  "looks": [
    {
      "id": "qwen-image/kodak-portra",
      "source": "starter",
      "name": "Portra",
      "version": 1,
      "text": "",
      "images": [],
      "loras": [
        {
          "lora_id": null,
          "name": "kodak-portra",
          "strength": 1
        }
      ]
    },
    {
      "id": "10000000-0000-4000-8000-000000000004",
      "source": "mine",
      "name": "Flux style",
      "version": 1,
      "text": "flux style",
      "images": [],
      "loras": [
        {
          "lora_id": "9d4c2b7a1e6f3c8d5a0b9e4f2c7d1a6b3e8f5c0d9a4b2e7f1c6d3a8b5e0f9c4d",
          "name": "flux-style",
          "strength": 1
        }
      ]
    },
    {
      "id": "qwen-image/window-light",
      "source": "starter",
      "name": "Window",
      "version": 1,
      "text": "soft daylight from a single window, deep falloff into shadow",
      "images": [],
      "loras": []
    }
  ],
  "chosen": [
    "qwen-image/kodak-portra",
    "10000000-0000-4000-8000-000000000004",
    "qwen-image/window-light"
  ],
  "loras": {
    "3f0a6c1e9b2d4a7c8e5f1b3d6a9c2e4f7b0d3a6c9e2f5b8d1a4c7e0f3b6d9a2c": "qwen-image",
    "2c4e6a8b-1d3f-4a5b-9c7d-0e2f4a6b8c10": "qwen-image",
    "9d4c2b7a1e6f3c8d5a0b9e4f2c7d1a6b3e8f5c0d9a4b2e7f1c6d3a8b5e0f9c4d": "unknown",
    "5b1d0000-0000-4000-8000-000000000001": "qwen-image",
    "5b1d0000-0000-4000-8000-000000000002": "qwen-image",
    "5b1d0000-0000-4000-8000-000000000003": "qwen-image",
    "5b1d0000-0000-4000-8000-000000000004": "qwen-image",
    "5b1d0000-0000-4000-8000-000000000005": "qwen-image"
  },
  "expect": {
    "errors": [
      "looks[1]: look Portra does not fit this workflow (LoRA kodak-portra is on no live host)",
      "looks[2]: look Flux style does not fit this workflow (LoRA flux-style fits no known model)"
    ]
  }
}
