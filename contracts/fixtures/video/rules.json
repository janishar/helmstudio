    {
      "expr": "1 if r == 'Full' else 0.75 if r == '75%' else 0.6",
      "values": {
        "r": "75%"
      },
      "expect": 0.75
    },
    {
      "expr": "min(a, 360) + max(1, 2) + 2 ** 3",
      "values": {
        "a": 400
      },
      "expect": 370
    },
    {
      "expr": "2 ** -1 + 4 ** 0.5",
      "values": {},
      "expect": 2.5
    },
    {
      "expr": "a == 1",
      "values": {
        "a": "1"
      },
      "expect": false
