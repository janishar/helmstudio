  "cases": [
    {
      "description": "one video (sound kept) and one audio: trim fields get in 0 and out = min(duration, 15)",
      "workflow": "minimax-h3-references",
      "inputs": {
        "generate.refs": [
          {
            "image": {
              "take_id": "11111111-0000-4000-8000-000000000025"
            }
          }
        ],
        "generate.videos": [
          {
            "video": {
              "take_id": "11111111-0000-4000-8000-000000000021"
            },
            "sound": "keep"
          }
        ],
        "generate.audios": [
          {
            "audio": {
              "take_id": "11111111-0000-4000-8000-000000000024"
            }
          }
        ]
      },
      "expect": {
        "error": null,
        "dropped": [],
        "values": {
          "generate.audios": [
            {
              "audio": {
                "take_id": "11111111-0000-4000-8000-000000000024",
                "in": 0,
                "out": 3.0
              }
            }
          ],
          "generate.videos": [
            {
              "video": {
                "take_id": "11111111-0000-4000-8000-000000000021",
                "in": 0,
                "out": 8.0
              },
              "sound": "keep"
            }
          ]
        }
      }
    },
