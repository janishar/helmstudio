{
  "description": "an Image input bound into keyframes.images is a one-item list: the image at 0 s (its defaults)",
  "pipeline": {
    "title": "i2v",
    "nodes": {
      "inputs": {
        "kind": "inputs",
        "inputs": [
          {
            "name": "prompt",
            "type": "Text"
          },
          {
            "name": "first",
            "type": "Image"
          }
        ]
      },
      "clip": {
        "kind": "step",
        "workflow": "ltx-image-to-video",
        "bind": {
          "prompt.text": "$prompt",
          "keyframes.images": "$first"
        }
      },
      "output": {
        "kind": "output",
        "from": "clip.takes",
        "collection": "clips"
      }
    },
    "edges": [
      [
        "inputs",
        "clip"
      ],
      [
        "clip",
        "output"
      ]
    ]
  },
  "problems": []
}
