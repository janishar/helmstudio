{
  "description": "the workflows the caller can run in these fixtures: the canonical templates qwen-image and echo, and three of the caller's own (a qwen-image copy with a Draft preset, an upscale with a required image param, one that cannot run); checked against fixtures/graphs/palette.json",
  "workflows": {
    "qwen-image": {
      "title": "Qwen Image",
      "family": "qwen-image",
      "env": "torch",
      "nodes": {
        "prompt": {
          "kind": "prompt",
          "params": {
            "text": ""
          }
        },
        "seed": {
          "kind": "seed",
          "params": {
            "seed": -1
          }
        },
        "canvas": {
          "kind": "canvas",
          "params": {
            "mode": "auto",
            "width": 1024,
            "height": 1024
          }
        },
        "model": {
          "kind": "qwen-image/model",
          "params": {
            "variant": "base",
            "precision": "int8"
          }
        },
        "encode": {
          "kind": "qwen-image/encode",
          "in": {
            "model": "model.model",
            "prompt": "prompt.text"
          },
          "params": {
            "transparent": false,
            "refs": []
          }
        },
        "sample": {
          "kind": "qwen-image/sample",
          "in": {
            "model": "model.model",
            "cond": "encode.cond",
            "canvas": "canvas.canvas",
            "seed": "seed.seed"
          },
          "params": {
            "steps": 40
          }
        },
        "decode": {
          "kind": "qwen-image/decode",
          "in": {
            "model": "model.model",
            "latent": "sample.latent"
          },
          "params": {
            "tiled": "auto"
          }
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "decode.image"
          }
        }
      }
    },
    "echo": {
      "title": "Echo",
      "family": "echo",
      "env": "fake",
      "nodes": {
        "prompt": {
          "kind": "prompt",
          "params": {
            "text": ""
          }
        },
        "echo": {
          "kind": "echo/echo",
          "in": {
            "text": "prompt.text"
          },
          "params": {
            "steps": 10,
            "delay_ms": 300,
            "fail": false,
            "refs": []
          }
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "echo.image"
          }
        }
      }
    },
    "6f1c2a4e-0b7d-4c8e-9a51-3d2e1f0a9b88": {
      "title": "Qwen draft",
      "family": "qwen-image",
      "env": "torch",
      "nodes": {
        "prompt": {
          "kind": "prompt",
          "params": {
            "text": ""
          }
        },
        "seed": {
          "kind": "seed",
          "params": {
            "seed": -1
          }
        },
        "canvas": {
          "kind": "canvas",
          "params": {
            "mode": "auto",
            "width": 1024,
            "height": 1024
          }
        },
        "model": {
          "kind": "qwen-image/model",
          "params": {
            "variant": "base",
            "precision": "int8"
          }
        },
        "encode": {
          "kind": "qwen-image/encode",
          "in": {
            "model": "model.model",
            "prompt": "prompt.text"
          },
          "params": {
            "transparent": false,
            "refs": []
          }
        },
        "sample": {
          "kind": "qwen-image/sample",
          "in": {
            "model": "model.model",
            "cond": "encode.cond",
            "canvas": "canvas.canvas",
            "seed": "seed.seed"
          },
          "params": {
            "steps": 40
          }
        },
        "decode": {
          "kind": "qwen-image/decode",
          "in": {
            "model": "model.model",
            "latent": "sample.latent"
          },
          "params": {
            "tiled": "auto"
          }
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "decode.image"
          }
        }
      },
      "studio": {
        "presets": {
          "Draft": {
            "model.variant": "turbo"
          }
        }
      }
    },
    "7a2d3b5f-1c8e-4d9a-8b62-4e3f2a1b0c99": {
      "title": "Upscale",
      "family": "test",
      "env": "torch",
      "nodes": {
        "image": {
          "kind": "image"
        },
        "upscale": {
          "kind": "test/upscale",
          "in": {
            "image": "image.image"
          }
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "upscale.image"
          }
        }
      }
    },
    "8b3e4c6a-2d9f-4e0b-9c73-5f4a3b2c1d00": {
      "title": "No output",
      "family": "echo",
      "env": "fake",
      "nodes": {
        "prompt": {
          "kind": "prompt"
        }
      }
    },
    "ltx-image-to-video": {
      "title": "LTX-2.5 Image to video",
      "family": "ltx",
      "env": "mlx",
      "nodes": {
        "prompt": {
          "kind": "prompt",
          "params": {
            "text": ""
          }
        },
        "seed": {
          "kind": "seed",
          "params": {
            "seed": -1
          }
        },
        "canvas": {
          "kind": "ltx/canvas",
          "params": {
            "width": 704,
            "height": 448
          }
        },
        "duration": {
          "kind": "ltx/duration",
          "params": {
            "frames": 49,
            "fps": 24
          }
        },
        "model": {
          "kind": "ltx/model",
          "params": {
            "variant": "distilled",
            "precision": "int8"
          }
        },
        "lora": {
          "kind": "ltx/lora-stack",
          "in": {
            "model": "model.model"
          },
          "params": {
            "rows": []
          }
        },
        "encode": {
          "kind": "ltx/encode",
          "in": {
            "model": "model.model",
            "prompt": "prompt.text"
          },
          "params": {
            "beats": []
          }
        },
        "keyframes": {
          "kind": "ltx/keyframes",
          "in": {
            "cond": "encode.cond"
          },
          "params": {
            "images": []
          }
        },
        "sample1": {
          "kind": "ltx/sample",
          "in": {
            "model": "lora.model",
            "cond": "keyframes.cond",
            "seed": "seed.seed",
            "canvas": "canvas.canvas",
            "duration": "duration.duration"
          },
          "params": {
            "role": "stage1",
            "steps": 8
          }
        },
        "upscale": {
          "kind": "ltx/upscale",
          "in": {
            "model": "model.model",
            "latent": "sample1.latent"
          },
          "params": {}
        },
        "sample2": {
          "kind": "ltx/sample",
          "in": {
            "model": "lora.model",
            "cond": "keyframes.cond",
            "seed": "seed.seed",
            "latent": "upscale.latent"
          },
          "params": {
            "role": "stage2",
            "steps": 3
          }
        },
        "decode": {
          "kind": "ltx/decode",
          "in": {
            "model": "model.model",
            "latent": "sample2.latent"
          },
          "params": {
            "audio": true
          }
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "decode.video"
          }
        }
      },
      "studio": {
        "composer": [
          "prompt.text"
        ],
        "quick": [
          "keyframes.images",
          "elements",
          "look:film",
          "look:camera",
          "look:lighting",
          "model.variant",
          "decode.audio"
        ],
        "inspector": [
          {
            "title": "Canvas",
            "items": [
              "canvas.width",
              "canvas.height"
            ]
          },
          {
            "title": "Duration",
            "items": [
              "duration.frames",
              "duration.fps"
            ]
          },
          {
            "title": "Quality",
            "items": [
              "model.precision",
              "sample1.steps",
              "sample2.steps"
            ]
          },
          {
            "title": "Prompt beats",
            "items": [
              "encode.beats"
            ]
          },
          {
            "title": "LoRA",
            "items": [
              "lora.rows"
            ]
          }
        ],
        "labels": {
          "sample1.steps": "Stage 1 steps",
          "sample2.steps": "Stage 2 steps",
          "keyframes.images": "Frames"
        },
        "presets": {
          "Fast": {
            "model.precision": "int8"
          },
          "Quality": {
            "model.precision": "bf16"
          },
          "Low memory": {
            "model.precision": "int4"
          }
        }
      }
    },
    "llm-ask": {
      "title": "Ask Qwen3.8 27B",
      "family": "llm",
      "env": "mlx",
      "nodes": {
        "model": {
          "kind": "llm/model",
          "params": {
            "variant": "4bit",
            "precision": "int4"
          }
        },
        "ask": {
          "kind": "llm/ask",
          "params": {
            "max_tokens": 800
          },
          "in": {
            "model": "model.model"
          }
        },
        "answer": {
          "kind": "answer",
          "in": {
            "text": "ask.answer"
          }
        }
      }
    },
    "qwen-image-ask": {
      "title": "Ask Qwen Image (Qwen3-VL 8B)",
      "family": "qwen-image",
      "env": "torch",
      "nodes": {
        "model": {
          "kind": "qwen-image/model",
          "params": {
            "variant": "base",
            "precision": "int8"
          }
        },
        "ask": {
          "kind": "qwen-image/ask",
          "params": {
            "max_tokens": 800
          },
          "in": {
            "model": "model.model"
          }
        },
        "answer": {
          "kind": "answer",
          "in": {
            "text": "ask.answer"
          }
        }
      }
    }
  }
}
