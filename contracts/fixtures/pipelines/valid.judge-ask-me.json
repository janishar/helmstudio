{
  "description": "API 1.28, the PipelineGraph board's Judge tiles: Keep best 1 of 4, If none pass retry at most 2, On retry rewrite the prompt, Then Ask me (no `then`: at the cap the row parks for a pick, a reject fails it). As valid.judge-best-of-4 without its review gate; the same worst case",
  "pipeline": {
    "title": "Best still to clip, ask me",
    "nodes": {
      "inputs": {
        "kind": "inputs",
        "inputs": [
          {
            "name": "prompt",
            "type": "Text"
          },
          {
            "name": "motion",
            "type": "Text"
          }
        ]
      },
      "mem": {
        "kind": "memory",
        "op": "read",
        "limit": 8
      },
      "still": {
        "kind": "step",
        "workflow": "qwen-image",
        "seeds": 4,
        "inputs": {
          "model.variant": "turbo",
          "model.precision": "int8",
          "canvas.mode": "fixed",
          "canvas.width": 1024,
          "canvas.height": 1024
        },
        "bind": {
          "prompt.text": "$prompt"
        }
      },
      "judge": {
        "kind": "judge",
        "takes": "still",
        "criteria": {
          "must": [
            "No extra or missing limbs",
            "No text or watermarks",
            "Matches the brief"
          ],
          "nice": [
            "Subject is sharp"
          ]
        },
        "keep": 1,
        "mode": "suggest",
        "model": "auto",
        "memory": "mem"
      },
      "rewrite": {
        "kind": "write",
        "from": [
          "$prompt",
          "judge.reasons"
        ],
        "to": "$prompt",
        "instruction": "Fix what the reviewer found; keep everything else."
      },
      "clip": {
        "kind": "step",
        "workflow": "ltx-image-to-video",
        "inputs": {
          "model.precision": "int8",
          "canvas.width": 448,
          "canvas.height": 256,
          "duration.frames": 49
        },
        "bind": {
          "prompt.text": "$motion",
          "keyframes.images": "judge.picked"
        }
      },
      "out": {
        "kind": "output",
        "from": "clip.takes",
        "collection": "Best still to clip"
      }
    },
    "edges": [
      [
        "inputs",
        "mem"
      ],
      [
        "mem",
        "still"
      ],
      [
        "still",
        "judge"
      ],
      [
        "judge",
        {
          "pass": "clip",
          "fail": "rewrite",
          "max": 2
        }
      ],
      [
        "rewrite",
        "still"
      ],
      [
        "clip",
        "out"
      ]
    ]
  },
  "problems": [],
  "bounds": {
    "runs": 13,
    "llm_calls": 6,
    "tool_calls": 0,
    "remote_calls": 0,
    "remote_tokens": 0
  },
  "models": {
    "judge": "qwen-image-ask",
    "rewrite": "qwen-image-ask"
  }
}
