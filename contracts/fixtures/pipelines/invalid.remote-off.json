{
  "description": "remote_off (API 1.15): the deployment's remote switch is off (the default), so a remote model fails whatever the pipeline's `remote` says, and so does a network custom node; a server model is unaffected (it never leaves the machine's private network)",
  "providers": [
    {
      "name": "ollama",
      "kind": "server",
      "enabled": true,
      "models": [
        "qwen2.5:7b"
      ],
      "default_model": "qwen2.5:7b",
      "host": "mac",
      "memory_gb": 6.5
    }
  ],
  "custom": [
    {
      "name": "web/fetch",
      "title": "Fetch",
      "help": "",
      "network": true,
      "version": "aaaaaaaaaaaa",
      "input": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      }
    }
  ],
  "pipeline": {
    "title": "Remote off",
    "remote": {
      "enabled": true,
      "providers": [
        "fakeai"
      ]
    },
    "nodes": {
      "inputs": {
        "kind": "inputs",
        "inputs": [
          {
            "name": "prompt",
            "type": "Text"
          }
        ]
      },
      "fetch": {
        "kind": "custom",
        "node": "web/fetch",
        "bind": {
          "text": "$prompt"
        }
      },
      "fix": {
        "kind": "write",
        "from": [
          "$prompt",
          "fetch.text"
        ],
        "to": "$prompt",
        "model": "remote:fakeai/fake-large"
      },
      "tidy": {
        "kind": "write",
        "from": [
          "$prompt"
        ],
        "to": "$prompt",
        "model": "server:ollama"
      },
      "still": {
        "kind": "step",
        "workflow": "qwen-image",
        "inputs": {
          "model.variant": "turbo",
          "model.precision": "int8",
          "canvas.mode": "fixed",
          "canvas.width": 1024,
          "canvas.height": 1024
        },
        "bind": {
          "prompt.text": "$prompt"
        }
      },
      "out": {
        "kind": "output",
        "from": "still.takes",
        "collection": "Remote off"
      }
    },
    "edges": [
      [
        "inputs",
        "fetch"
      ],
      [
        "fetch",
        "fix"
      ],
      [
        "fix",
        "tidy"
      ],
      [
        "tidy",
        "still"
      ],
      [
        "still",
        "out"
      ]
    ]
  },
  "problems": [
    {
      "code": "remote_off",
      "node": "fix"
    },
    {
      "code": "remote_off",
      "node": "fetch"
    }
  ]
}
