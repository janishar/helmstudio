{
  "description": "a decide's then route counts for nothing against its cap: then = again loops back to still with no cap left (uncapped_cycle on both nodes)",
  "pipeline": {
    "title": "Decide loops forever",
    "nodes": {
      "inputs": {
        "kind": "inputs",
        "inputs": [
          {
            "name": "prompt",
            "type": "Text"
          },
          {
            "name": "motion",
            "type": "Text"
          }
        ]
      },
      "still": {
        "kind": "step",
        "workflow": "qwen-image",
        "seeds": 4,
        "inputs": {
          "model.variant": "turbo",
          "model.precision": "int8",
          "canvas.mode": "fixed",
          "canvas.width": 1024,
          "canvas.height": 1024
        },
        "bind": {
          "prompt.text": "$prompt"
        }
      },
      "check": {
        "kind": "decide",
        "question": "Good?",
        "from": [
          "$prompt"
        ],
        "routes": {
          "again": "make it again",
          "done": "keep it"
        }
      },
      "out": {
        "kind": "output",
        "from": "still.takes",
        "collection": "x"
      }
    },
    "edges": [
      [
        "inputs",
        "still"
      ],
      [
        "still",
        "check"
      ],
      [
        "check",
        {
          "routes": {
            "again": "still",
            "done": "out"
          },
          "max": 2,
          "then": "again"
        }
      ]
    ]
  },
  "problems": [
    {
      "code": "uncapped_cycle",
      "node": "still"
    },
    {
      "code": "uncapped_cycle",
      "node": "check"
    }
  ]
}
