{
  "description": "remote rules (API 1.15), the deployment's switch on: a provider missing from the pipeline's `remote.providers` is remote_not_enabled (no unknown_model: that is checked only once it is enabled); a network custom node passes here (both switches on) and is listed in egress; a custom node with a missing required field and an unknown field (custom_input, port = the field); an unknown custom node (unknown_custom)",
  "remote_deployment": true,
  "providers": [
    {
      "name": "ollama",
      "kind": "server",
      "enabled": true,
      "models": [
        "qwen2.5:7b",
        "llama3.2:3b"
      ],
      "default_model": "qwen2.5:7b",
      "host": "mac",
      "memory_gb": 6.5
    },
    {
      "name": "fakeai",
      "kind": "remote",
      "enabled": true,
      "models": [
        "fake-large"
      ],
      "default_model": "fake-large"
    }
  ],
  "custom": [
    {
      "name": "web/fetch",
      "title": "Fetch",
      "help": "",
      "network": true,
      "version": "aaaaaaaaaaaa",
      "input": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          }
        },
        "required": [
          "url"
        ]
      },
      "output": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      }
    }
  ],
  "pipeline": {
    "title": "Remote",
    "remote": {
      "enabled": true,
      "providers": []
    },
    "nodes": {
      "inputs": {
        "kind": "inputs",
        "inputs": [
          {
            "name": "prompt",
            "type": "Text"
          }
        ]
      },
      "fetch": {
        "kind": "custom",
        "node": "web/fetch",
        "inputs": {
          "depth": 2
        }
      },
      "pre": {
        "kind": "custom",
        "node": "text/prefix",
        "bind": {
          "text": "$prompt"
        }
      },
      "check": {
        "kind": "write",
        "from": [
          "$prompt"
        ],
        "to": "$prompt",
        "model": "remote:fakeai/fake-large"
      },
      "still": {
        "kind": "step",
        "workflow": "qwen-image",
        "inputs": {
          "model.variant": "turbo",
          "model.precision": "int8",
          "canvas.mode": "fixed",
          "canvas.width": 1024,
          "canvas.height": 1024
        },
        "bind": {
          "prompt.text": "$prompt"
        }
      },
      "out": {
        "kind": "output",
        "from": "still.takes",
        "collection": "Remote"
      }
    },
    "edges": [
      [
        "inputs",
        "fetch"
      ],
      [
        "fetch",
        "pre"
      ],
      [
        "pre",
        "check"
      ],
      [
        "check",
        "still"
      ],
      [
        "still",
        "out"
      ]
    ]
  },
  "problems": [
    {
      "code": "remote_not_enabled",
      "node": "check"
    },
    {
      "code": "custom_input",
      "node": "fetch",
      "port": "url"
    },
    {
      "code": "custom_input",
      "node": "fetch",
      "port": "depth"
    },
    {
      "code": "unknown_custom",
      "node": "pre"
    }
  ]
}
