{
  "description": "agent rules (API 1.15): two directors (director_count on both); rows.edit on an agent that is not the director (agent_tools); an agent with routes whose edge is plain (decide_routes, refused: a dead end); a judge on a local server (model_media) and an unknown server model (unknown_model, run); an agent reading takes in from (bind_source from)",
  "providers": [
    {
      "name": "ollama",
      "kind": "server",
      "enabled": true,
      "models": [
        "qwen2.5:7b",
        "llama3.2:3b"
      ],
      "default_model": "qwen2.5:7b",
      "host": "mac",
      "memory_gb": 6.5
    },
    {
      "name": "fakeai",
      "kind": "remote",
      "enabled": true,
      "models": [
        "fake-large"
      ],
      "default_model": "fake-large"
    }
  ],
  "pipeline": {
    "title": "Broken agents 2",
    "nodes": {
      "inputs": {
        "kind": "inputs",
        "inputs": [
          {
            "name": "prompt",
            "type": "Text"
          }
        ]
      },
      "a": {
        "kind": "agent",
        "instruction": "Plan.",
        "director": true,
        "from": [
          "$prompt"
        ]
      },
      "still": {
        "kind": "step",
        "workflow": "qwen-image",
        "seeds": 2,
        "inputs": {
          "model.variant": "turbo",
          "model.precision": "int8",
          "canvas.mode": "fixed",
          "canvas.width": 1024,
          "canvas.height": 1024
        },
        "bind": {
          "prompt.text": "$prompt"
        }
      },
      "judge": {
        "kind": "judge",
        "takes": "still",
        "criteria": {
          "must": [
            "Clean"
          ]
        },
        "model": "server:ollama"
      },
      "b": {
        "kind": "agent",
        "instruction": "Edit rows.",
        "director": true,
        "tools": [
          "rows.edit"
        ],
        "from": [
          "still.takes"
        ],
        "model": "server:ollama/mistral"
      },
      "c": {
        "kind": "agent",
        "instruction": "Route.",
        "tools": [
          "rows.edit"
        ],
        "routes": {
          "x": "one",
          "y": "two"
        }
      },
      "out": {
        "kind": "output",
        "from": "judge.picked",
        "collection": "Broken"
      }
    },
    "edges": [
      [
        "inputs",
        "a"
      ],
      [
        "a",
        "still"
      ],
      [
        "still",
        "judge"
      ],
      [
        "judge",
        "b"
      ],
      [
        "b",
        "out"
      ],
      [
        "c",
        "out"
      ]
    ]
  },
  "problems": [
    {
      "code": "director_count",
      "node": "a"
    },
    {
      "code": "director_count",
      "node": "b"
    },
    {
      "code": "agent_tools",
      "node": "c"
    },
    {
      "code": "decide_routes",
      "node": "c"
    },
    {
      "code": "unreachable",
      "node": "c"
    },
    {
      "code": "dead_end",
      "node": "c"
    },
    {
      "code": "model_media",
      "node": "judge"
    },
    {
      "code": "unknown_model",
      "node": "b"
    },
    {
      "code": "bind_source",
      "node": "b",
      "port": "from"
    }
  ]
}
