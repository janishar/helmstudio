{
  "description": "an Auto judge on the 27B (named model), then a decide whose retry route loops back (capped at 1: the then route `accept` is forced after it), a memory write node noting the judge's reasons for the next batches. Decide `auto` resolves to the ask of the nearest step before it (still: qwen-image-ask). Worst case: still 4 × 2 + clip 1 = 9 runs; judge 2 + check 2 = 4 LLM calls",
  "pipeline": {
    "title": "Judge then decide",
    "nodes": {
      "inputs": {
        "kind": "inputs",
        "inputs": [
          {
            "name": "prompt",
            "type": "Text"
          },
          {
            "name": "motion",
            "type": "Text"
          }
        ]
      },
      "still": {
        "kind": "step",
        "workflow": "qwen-image",
        "seeds": 4,
        "inputs": {
          "model.variant": "turbo",
          "model.precision": "int8",
          "canvas.mode": "fixed",
          "canvas.width": 1024,
          "canvas.height": 1024
        },
        "bind": {
          "prompt.text": "$prompt"
        }
      },
      "judge": {
        "kind": "judge",
        "takes": "still",
        "criteria": {
          "must": [
            "Matches the brief"
          ]
        },
        "keep": 1,
        "mode": "auto",
        "model": "llm-ask"
      },
      "check": {
        "kind": "decide",
        "question": "Is the kept still good enough to animate, or should the stills be made again?",
        "from": [
          "$prompt",
          "judge.reasons"
        ],
        "routes": {
          "retry": "the takes miss the brief",
          "accept": "good enough to animate"
        }
      },
      "note": {
        "kind": "memory",
        "op": "write",
        "key": "briefs",
        "from": [
          "judge.reasons"
        ]
      },
      "clip": {
        "kind": "step",
        "workflow": "ltx-image-to-video",
        "inputs": {
          "model.precision": "int8",
          "canvas.width": 448,
          "canvas.height": 256,
          "duration.frames": 49
        },
        "bind": {
          "prompt.text": "$motion",
          "keyframes.images": "judge.picked"
        }
      },
      "out": {
        "kind": "output",
        "from": "clip.takes",
        "collection": "Judge then decide"
      }
    },
    "edges": [
      [
        "inputs",
        "still"
      ],
      [
        "still",
        "judge"
      ],
      [
        "judge",
        "check"
      ],
      [
        "check",
        {
          "routes": {
            "retry": "still",
            "accept": "note"
          },
          "max": 1,
          "then": "accept"
        }
      ],
      [
        "note",
        "clip"
      ],
      [
        "clip",
        "out"
      ]
    ]
  },
  "problems": [],
  "bounds": {
    "runs": 9,
    "llm_calls": 4,
    "tool_calls": 0,
    "remote_calls": 0,
    "remote_tokens": 0
  },
  "models": {
    "judge": "llm-ask",
    "check": "qwen-image-ask"
  }
}
