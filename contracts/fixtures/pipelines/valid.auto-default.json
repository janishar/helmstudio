{
  "description": "the pipelines default model (API 1.74): Auto on a remote default. The write's auto runs on fakeai with no pipeline remote switch (the admin's choice for every pipeline) and is listed in egress and bounds; the judge's auto keeps its family's vision model (judges send thumbnails). Without auto_model the write is llm-ask",
  "remote_deployment": true,
  "auto_model": "remote:fakeai/fake-large",
  "providers": [
    {
      "name": "fakeai",
      "kind": "remote",
      "enabled": true,
      "models": [
        "fake-large"
      ],
      "default_model": "fake-large"
    }
  ],
  "pipeline": {
    "title": "Auto default",
    "nodes": {
      "inputs": {
        "kind": "inputs",
        "inputs": [
          {
            "name": "prompt",
            "type": "Text"
          }
        ]
      },
      "rewrite": {
        "kind": "write",
        "from": [
          "$prompt"
        ],
        "to": "$prompt"
      },
      "still": {
        "kind": "step",
        "workflow": "qwen-image",
        "inputs": {
          "model.variant": "turbo",
          "model.precision": "int8",
          "canvas.mode": "fixed",
          "canvas.width": 1024,
          "canvas.height": 1024
        },
        "bind": {
          "prompt.text": "$prompt"
        }
      },
      "judge": {
        "kind": "judge",
        "takes": "still",
        "criteria": {
          "must": [
            "Matches the brief"
          ]
        },
        "mode": "auto"
      },
      "out": {
        "kind": "output",
        "from": "judge.picked",
        "collection": "Auto"
      }
    },
    "edges": [
      [
        "inputs",
        "rewrite"
      ],
      [
        "rewrite",
        "still"
      ],
      [
        "still",
        "judge"
      ],
      [
        "judge",
        "out"
      ]
    ]
  },
  "problems": [],
  "bounds": {
    "runs": 1,
    "llm_calls": 2,
    "tool_calls": 0,
    "remote_calls": 2,
    "remote_tokens": 19184
  },
  "models": {
    "rewrite": "remote:fakeai/fake-large",
    "judge": "qwen-image-ask"
  },
  "egress": [
    {
      "node": "rewrite",
      "where": "remote",
      "provider": "fakeai",
      "model": "fake-large",
      "fields": [
        "instruction",
        "$prompt"
      ],
      "thumbnails": 0,
      "per_row": {
        "calls": 2,
        "tokens": 19184
      },
      "chat": null
    }
  ],
  "reserved": []
}
