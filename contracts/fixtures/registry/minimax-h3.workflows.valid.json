{
  "schema_version": 1,
  "host": "mac",
  "env": "native",
  "published_at": "2026-11-19T10:00:00Z",
  "published_by": "runner native 0.1.0",
  "workflows": [
    {
      "id": "minimax-h3-text-to-video",
      "title": "MiniMax H3 Text to video",
      "family": "minimax-h3",
      "env": "native",
      "media": "video",
      "nodes": {
        "prompt": {
          "kind": "prompt",
          "params": {
            "text": ""
          }
        },
        "seed": {
          "kind": "seed",
          "params": {
            "seed": -1
          }
        },
        "canvas": {
          "kind": "minimax-h3/canvas",
          "params": {
            "width": 864,
            "height": 480
          }
        },
        "duration": {
          "kind": "minimax-h3/duration",
          "params": {
            "frames": 124,
            "fps": 24
          }
        },
        "model": {
          "kind": "minimax-h3/model",
          "params": {
            "variant": "base",
            "precision": "int8"
          }
        },
        "generate": {
          "kind": "minimax-h3/generate",
          "in": {
            "model": "model.model",
            "prompt": "prompt.text",
            "seed": "seed.seed",
            "canvas": "canvas.canvas",
            "duration": "duration.duration"
          },
          "params": {
            "steps": 20,
            "layers": 45,
            "reuse": 2,
            "core_reuse": 1,
            "token_reduction": false,
            "render": "Full",
            "quality": "lossless",
            "flow_shift": 12,
            "audio_flow_shift": 3,
            "lora": "none",
            "refs": [],
            "videos": [],
            "audios": []
          }
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "generate.video"
          }
        }
      },
      "studio": {
        "composer": [
          "prompt.text"
        ],
        "quick": [
          "model.variant",
          "seed.seed"
        ],
        "inspector": [
          {
            "title": "Canvas",
            "items": [
              "canvas.width",
              "canvas.height"
            ]
          },
          {
            "title": "Duration",
            "items": [
              "duration.frames"
            ]
          },
          {
            "title": "Quality",
            "help": "On NVIDIA (Base fp8) a preset sets only Steps (and Turbo the LoRA), so Fast and Default run the same there; Mode and the flow shifts are NVIDIA only.",
            "items": [
              "model.precision",
              "generate.steps",
              "generate.quality",
              "generate.flow_shift",
              "generate.audio_flow_shift",
              "generate.lora"
            ]
          },
          {
            "title": "Advanced",
            "help": "h3's speed settings on a Mac (Base). Hidden on Base fp8: the NVIDIA run ignores them.",
            "items": [
              "generate.layers",
              "generate.reuse",
              "generate.core_reuse",
              "generate.render",
              "generate.token_reduction"
            ]
          }
        ],
        "presets": {
          "Draft": {
            "generate.steps": 4,
            "generate.layers": 50,
            "generate.reuse": 1,
            "generate.token_reduction": false,
            "generate.core_reuse": 1,
            "generate.lora": "none"
          },
          "Fast": {
            "generate.steps": 20,
            "generate.layers": 45,
            "generate.reuse": 2,
            "generate.token_reduction": true,
            "generate.core_reuse": 1,
            "generate.lora": "none"
          },
          "Turbo": {
            "generate.steps": 8,
            "generate.layers": 50,
            "generate.reuse": 1,
            "generate.token_reduction": false,
            "generate.core_reuse": 1,
            "generate.lora": "turbo",
            "generate.flow_shift": 12,
            "generate.audio_flow_shift": 3
          },
          "Default": {
            "generate.steps": 20,
            "generate.layers": 45,
            "generate.reuse": 2,
            "generate.token_reduction": false,
            "generate.core_reuse": 1,
            "generate.lora": "none"
          },
          "Reference": {
            "generate.steps": 50,
            "generate.layers": 50,
            "generate.reuse": 1,
            "generate.token_reduction": false,
            "generate.core_reuse": 1,
            "generate.lora": "none"
          }
        },
        "preset_help": [
          {
            "text": "NVIDIA: a preset sets only the steps and the LoRA (Draft 4, Turbo 8 with the Turbo LoRA, Fast and Default 20, Reference 50).",
            "when": "model.variant == 'base-fp8'"
          },
          {
            "text": "Draft 4 steps; Turbo 8 steps with the Turbo LoRA (an add-on); Fast 20 steps, 45 layers, reuse 2, token reduction; Default the same without token reduction; Reference 50 steps, every layer. On NVIDIA a preset sets only the steps and the LoRA."
          }
        ],
        "preset_order": [
          "Draft",
          "Fast",
          "Turbo",
          "Default",
          "Reference"
        ]
      }
    },
