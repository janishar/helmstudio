{
  "schema_version": 1,
  "host": "mac",
  "env": "torch",
  "published_at": "2026-11-14T10:00:00Z",
  "published_by": "runner torch 0.2.0",
  "workflows": [
    {
      "id": "qwen-image",
      "title": "Qwen Image",
      "action": "Edit",
      "family": "qwen-image",
      "env": "torch",
      "nodes": {
        "prompt": {
          "kind": "prompt",
          "params": {
            "text": ""
          }
        },
        "seed": {
          "kind": "seed",
          "params": {
            "seed": -1
          }
        },
        "canvas": {
          "kind": "canvas",
          "params": {
            "mode": "auto",
            "width": 1024,
            "height": 1024
          }
        },
        "model": {
          "kind": "qwen-image/model",
          "params": {
            "variant": "base",
            "precision": "int8"
          }
        },
        "lora": {
          "kind": "qwen-image/lora-stack",
          "in": {
            "model": "model.model"
          },
          "params": {
            "rows": []
          }
        },
        "encode": {
          "kind": "qwen-image/encode",
          "in": {
            "model": "model.model",
            "prompt": "prompt.text"
          },
          "params": {
            "transparent": false,
            "refs": []
          }
        },
        "sample": {
          "kind": "qwen-image/sample",
          "in": {
            "model": "lora.model",
            "cond": "encode.cond",
            "canvas": "canvas.canvas",
            "seed": "seed.seed"
          },
          "params": {
            "steps": 40
          }
        },
        "decode": {
          "kind": "qwen-image/decode",
          "in": {
            "model": "model.model",
            "latent": "sample.latent"
          },
          "params": {
            "tiled": "auto"
          }
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "decode.image"
          }
        }
      }
    },
    {
      "id": "qwen-image-ask",
      "title": "Ask Qwen Image (Qwen3-VL 8B)",
      "family": "qwen-image",
      "env": "torch",
      "media": "text",
      "nodes": {
        "model": {
          "kind": "qwen-image/model",
          "params": {
            "variant": "base",
            "precision": "int8"
          }
        },
        "ask": {
          "kind": "qwen-image/ask",
          "params": {
            "max_tokens": 800
          },
          "in": {
            "model": "model.model"
          }
        },
        "answer": {
          "kind": "answer",
          "in": {
            "text": "ask.answer"
          }
        }
      }
    }
  ]
}
