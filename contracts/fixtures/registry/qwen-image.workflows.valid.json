{
  "schema_version": 1,
  "host": "mac",
  "env": "torch",
  "published_at": "2026-11-14T10:00:00Z",
  "published_by": "runner torch 0.2.0",
  "workflows": [
    {
      "id": "qwen-image",
      "title": "Qwen Image",
      "action": "Edit",
      "family": "qwen-image",
      "env": "torch",
      "nodes": {
        "prompt": {
          "kind": "prompt",
          "params": {
            "text": ""
          }
        },
        "seed": {
          "kind": "seed",
          "params": {
            "seed": -1
          }
        },
        "canvas": {
          "kind": "canvas",
          "params": {
            "mode": "auto",
            "width": 1024,
            "height": 1024
          }
        },
        "model": {
          "kind": "qwen-image/model",
          "params": {
            "variant": "base",
            "precision": "int8"
          }
        },
        "lora": {
          "kind": "qwen-image/lora-stack",
          "in": {
            "model": "model.model"
          },
          "params": {
            "rows": []
          }
        },
        "enhance": {
          "kind": "qwen-image/enhance",
          "bypass": true,
          "in": {
            "prompt": "prompt.text",
            "canvas": "canvas.canvas",
            "seed": "seed.seed"
          },
          "params": {
            "think": false
          }
        },
        "encode": {
          "kind": "qwen-image/encode",
          "in": {
            "model": "model.model",
            "prompt": "enhance.text"
          },
          "params": {
            "transparent": false,
            "refs": []
          }
        },
        "sample": {
          "kind": "qwen-image/sample",
          "in": {
            "model": "lora.model",
            "cond": "encode.cond",
            "canvas": "enhance.canvas",
            "seed": "seed.seed"
          },
          "params": {
            "steps": 40
          }
        },
        "decode": {
          "kind": "qwen-image/decode",
          "in": {
            "model": "model.model",
            "latent": "sample.latent"
          },
          "params": {
            "tiled": "auto"
          }
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "decode.image"
          }
        }
      },
      "studio": {
        "composer": [
          "prompt.text",
          "encode.refs"
        ],
        "quick": [
          "elements",
          "look:film",
          "look:camera",
          "look:colour",
          "look:lighting",
          "model.variant",
          "enhance.bypass",
          "seed.seed"
        ],
        "inspector": [
          {
            "title": "Canvas",
            "items": [
              "canvas.mode",
              "canvas.width",
              "canvas.height"
            ]
          },
          {
            "title": "Quality",
            "items": [
              "model.precision",
              "sample.steps",
              "decode.tiled"
            ]
          },
          {
            "title": "LoRA",
            "items": [
              "lora.rows"
            ]
          },
          {
            "title": "Enhance",
            "items": [
              "enhance.think"
            ]
          },
          {
            "title": "Options",
            "items": [
              "encode.transparent"
            ]
          }
        ],
        "labels": {
          "enhance.bypass": "No enhance"
        },
        "presets": {
          "Plain": {
            "enhance.bypass": true
          },
          "Enhanced": {
            "enhance.bypass": false,
            "enhance.think": false
          },
          "Enhanced, think": {
            "enhance.bypass": false,
            "enhance.think": true
          }
        },
        "preset_order": [
          "Plain",
          "Enhanced",
          "Enhanced, think"
        ]
      }
    },
    {
      "id": "qwen-image-ask",
      "title": "Ask Qwen Image (Qwen3-VL 8B)",
      "family": "qwen-image",
      "env": "torch",
      "media": "text",
      "nodes": {
        "model": {
          "kind": "qwen-image/model",
          "params": {
            "variant": "base",
            "precision": "int8"
          }
        },
        "ask": {
          "kind": "qwen-image/ask",
          "params": {
            "max_tokens": 800
          },
          "in": {
            "model": "model.model"
          }
        },
        "answer": {
          "kind": "answer",
          "in": {
            "text": "ask.answer"
          }
        }
      }
    }
  ]
}
