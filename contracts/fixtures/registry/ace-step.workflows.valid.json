  "workflows": [
    {
      "id": "ace-step-music",
      "title": "ACE-Step Music",
      "family": "ace-step",
      "env": "torch",
      "media": "audio",
      "nodes": {
        "prompt": {
          "kind": "prompt",
          "params": {
            "text": ""
          }
        },
        "seed": {
          "kind": "seed",
          "params": {
            "seed": -1
          }
        },
        "model": {
          "kind": "ace-step/model",
          "params": {
            "variant": "turbo-2b",
            "precision": "bf16"
          }
        },
        "song": {
          "kind": "ace-step/song",
          "params": {
            "lyrics": "",
            "instrumental": false,
            "seconds": 0,
            "bpm": 0,
            "key": "auto",
            "time": "auto",
            "language": "auto"
          }
        },
        "plan": {
          "kind": "ace-step/plan",
          "in": {
            "model": "model.model",
            "song": "song.song",
            "text": "prompt.text",
            "seed": "seed.seed"
          },
          "params": {}
        },
        "compose": {
          "kind": "ace-step/compose",
          "in": {
            "model": "model.model",
            "song": "plan.song",
            "text": "plan.style",
            "seed": "seed.seed"
          },
          "params": {
            "reference": [],
            "steps": 8
          }
        },
        "decode": {
          "kind": "ace-step/decode",
          "in": {
            "model": "model.model",
            "latent": "compose.latent"
          },
          "params": {}
        },
        "output": {
          "kind": "output",
          "in": {
            "media": "decode.audio"
          }
        }
      },
      "studio": {
        "composer": [
          "prompt.text",
          "song.lyrics",
          "compose.reference"
        ],
        "quick": [
          "model.variant",
          "song.instrumental",
          "song.seconds",
          "song.bpm",
          "song.key",
          "song.time",
          "song.language"
        ],
        "groups": [
          {
            "label": "BPM · key",
            "items": [
              "song.bpm",
              "song.key",
              "song.time"
            ]
          }
        ],
        "inspector": [
          {
            "title": "Advanced",
            "items": [
              "seed.seed",
              "compose.steps",
              "plan.bypass"
            ]
          }
        ],
        "labels": {
          "plan.bypass": "No rewrite"
        }
      },
      "standard": {
        "kind": "music",
        "model": "ACE-Step 1.5",
        "fields": {
          "prompt": "prompt.text",
          "lyrics": "song.lyrics",
          "instrumental": "song.instrumental",
          "length": "song.seconds",
          "key": "song.key",
          "bpm": "song.bpm",
          "seed": "seed.seed"
        },
        "seconds": 0.55
      }
    },
