      "inputs": [
        {
          "name": "model",
          "type": "Model"
        }
      ],
      "outputs": [
        {
          "name": "answer",
          "type": "Text"
        },
        {
          "name": "transcript",
          "type": "Text"
        }
      ],
      "component": "whole model",
      "help": "Answers one question about a video or audio take: it hears the sound and watches the picture (2 frames a second), and writes down the speech."
