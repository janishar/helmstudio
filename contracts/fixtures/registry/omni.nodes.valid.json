            "video",
            "audio"
          ],
          "max_s": 120,
          "help": "The video or audio take to listen to."
        },
        {
          "name": "question",
          "type": "string",
          "label": "Question",
          "default": "",
          "max": 500,
          "help": "What to listen for."
        },
        {
          "name": "transcript",
          "type": "bool",
          "label": "Transcript",
          "default": true,
          "help": "Also write down the speech (Qwen3-ASR); empty when the take has no sound."
