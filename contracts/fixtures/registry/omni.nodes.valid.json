            "q8",
            "3b"
          ],
          "default": "q8",
          "label": "Variant"
        },
        {
          "name": "precision",
          "type": "enum",
          "enum": [
            "int8"
          ],
          "default": "int8",
          "label": "Precision",
          "help": "Stored Q8_0; loaded as it is. Not a choice."
        }
      ],
      "inputs": [],
      "outputs": [
        {
          "name": "model",
          "type": "Model"
        }
      ],
      "help": "Qwen3-Omni 30B (A3B, GGUF Q8_0), or the smaller Qwen2.5-Omni 3B, hears and watches a take; Qwen3-ASR 1.7B writes down its speech."
