        {
          "name": "latent",
          "type": "Latent"
        }
      ],
      "outputs": [
        {
          "name": "audio",
          "type": "Audio"
        }
      ],
      "component": "vocoder",
      "help": "Turns the latent into 44.1 kHz stereo audio with the vocoder, window by window, and stitches the windows.",
      "sound": "music"
    },
    {
      "kind": "output",
      "title": "Output",
      "family": null,
      "params": [],
      "inputs": [
