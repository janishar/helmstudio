    {
      "family": "qwen-image",
      "title": "Qwen Image 2.1",
      "nodes": [
        {
          "kind": "qwen-image/model",
          "title": "Qwen Image 2.1",
          "family": "qwen-image",
          "help": "Which weights to load and at what precision.",
          "params": [
            {
              "name": "variant",
              "type": "enum",
              "label": "Variant",
              "default": "base",
              "enum": [
                "base",
                "turbo"
              ],
              "help": "Turbo: 8 fixed steps, much faster."
            },
            {
              "name": "precision",
              "type": "enum",
              "label": "Precision",
              "default": "int8",
              "enum": [
                "bf16",
                "int8"
              ],
              "help": "int8 quantizes the transformer and text encoder at load: about half the memory."
            }
          ],
          "inputs": [],
          "outputs": [
            {
              "name": "model",
              "type": "Model"
            }
          ],
          "envs": [
            "torch"
          ]
        },
        {
          "kind": "qwen-image/lora-stack",
          "title": "LoRA Stack",
          "family": "qwen-image",
          "help": "Applies LoRAs to the model's transformer, in order. Empty: the model as it is.",
          "params": [
            {
              "name": "rows",
              "type": "rows",
              "label": "LoRAs",
              "default": [],
              "min": 0,
              "max": 8,
              "item": {
                "lora": "Lora",
                "strength": {
                  "type": "float",
                  "label": "Strength",
                  "default": 1,
                  "min": -4,
                  "max": 4,
                  "step": 0.05
                },
                "mode": {
                  "type": "enum",
                  "label": "Mode",
                  "default": "adapter",
                  "enum": [
                    "adapter",
                    "bake"
                  ],
                  "help": "Adapter: strength changes and swaps never reload the model. Bake: merged into the weights at load (its own copy in memory)."
                }
              },
              "help": "Each row: a LoRA that fits this model, its strength and how it is applied."
            }
          ],
          "inputs": [
            {
              "name": "model",
              "type": "Model"
            }
          ],
          "outputs": [
            {
              "name": "model",
              "type": "Model"
            }
          ],
          "envs": [
            "torch"
          ]
        },
        {
          "kind": "qwen-image/encode",
          "title": "Encode prompt",
          "family": "qwen-image",
          "help": "Encodes the prompt and up to 10 reference images; with references the run is an edit.",
          "params": [
            {
              "name": "transparent",
              "type": "bool",
              "label": "Transparent",
              "default": false,
              "help": "Ask for an RGBA image with a transparent background."
            },
            {
              "name": "refs",
              "type": "rows",
              "label": "References",
              "default": [],
              "min": 0,
              "max": 10,
              "item": {
                "image": "Image"
              },
              "mention": "<image{n}>",
              "help": "Images to edit or combine, in order; the prompt names them <image1>, <image2>, …"
            }
          ],
          "inputs": [
            {
              "name": "model",
              "type": "Model"
            },
            {
              "name": "prompt",
              "type": "Text"
            }
          ],
          "outputs": [
            {
              "name": "cond",
              "type": "Conditioning"
            }
          ],
          "envs": [
            "torch"
          ]
        },
        {
          "kind": "qwen-image/sample",
          "title": "Sample",
          "family": "qwen-image",
          "help": "Denoises from the seed's noise.",
          "params": [
            {
              "name": "steps",
              "type": "int",
              "label": "Steps",
              "default": 40,
              "min": 1,
              "max": 200,
              "step": 1,
              "when": "model.variant != 'turbo'",
              "help": "Turbo uses its own 8-step schedule and ignores this."
            }
          ],
          "inputs": [
            {
              "name": "model",
              "type": "Model"
            },
            {
              "name": "cond",
              "type": "Conditioning"
            },
            {
              "name": "canvas",
              "type": "Canvas"
            },
            {
              "name": "seed",
              "type": "Seed"
            }
          ],
          "outputs": [
            {
              "name": "latent",
              "type": "Latent"
            }
          ],
          "envs": [
            "torch"
          ]
        },
        {
          "kind": "qwen-image/decode",
          "title": "Decode",
          "family": "qwen-image",
          "help": "Turns the latent into an RGBA image with the VAE.",
          "params": [
            {
              "name": "tiled",
              "type": "enum",
              "label": "Tiled decode",
              "default": "auto",
              "enum": [
                "auto",
                "on",
                "off"
              ],
              "help": "Tiling cuts decode memory (27 GB vs 65 GB at 4 MP) but changes pixels; auto tiles only when needed."
            }
          ],
          "inputs": [
            {
              "name": "model",
              "type": "Model"
            },
            {
              "name": "latent",
              "type": "Latent"
            }
          ],
          "outputs": [
            {
              "name": "image",
              "type": "Image"
            }
          ],
          "envs": [
            "torch"
          ]
        },
        {
          "kind": "qwen-image/ask",
          "title": "Ask",
          "family": "qwen-image",
          "help": "Asks Qwen Image's own text encoder (Qwen3-VL 8B) one question about its takes: no extra load when it is resident. Temperature 0, thinking off, one more try in the same run when the answer does not match the schema.",
          "params": [
            {
              "name": "system",
              "type": "string",
              "label": "System",
              "default": "",
              "max": 4000,
              "help": "The system turn."
            },
            {
              "name": "prompt",
              "type": "string",
              "label": "Prompt",
              "default": "",
              "max": 32768,
              "help": "The filled template (pipelines writes it). Not scanned for mentions."
            },
            {
              "name": "media",
              "type": "rows",
              "label": "Takes",
              "default": [],
              "min": 0,
              "max": 8,
              "item": {
                "take": "Media"
              },
              "help": "Image or video takes, in order; each is sent as a thumbnail (a video as 3 keyframes)."
            },
            {
              "name": "schema",
              "type": "string",
              "label": "Answer schema",
              "default": "",
              "max": 16384,
              "help": "A JSON schema the answer must match; empty = plain text."
            },
            {
              "name": "max_tokens",
              "type": "int",
              "label": "Max tokens",
              "default": 800,
              "min": 16,
              "max": 4096
            }
          ],
          "inputs": [
            {
              "name": "model",
              "type": "Model"
            }
          ],
          "outputs": [
            {
              "name": "answer",
              "type": "Text"
            }
          ],
          "envs": [
            "torch"
          ]
        }
      ]
