{
  "groups": [
    {
      "family": null,
      "title": "Core",
      "nodes": [
        {
          "kind": "prompt",
          "title": "Prompt",
          "family": null,
          "help": "The text the workflow starts from.",
          "params": [
            {
              "name": "text",
              "type": "text",
              "label": "Prompt",
              "default": "",
              "min": 0,
              "max": 4000
            }
          ],
          "inputs": [],
          "outputs": [
            {
              "name": "text",
              "type": "Text"
            }
          ],
          "envs": [
            "fake",
            "torch"
          ]
        },
        {
          "kind": "output",
          "title": "Output",
          "family": null,
          "help": "Stores its input as a run output.",
          "params": [],
          "inputs": [
            {
              "name": "media",
              "type": "Image"
            }
          ],
          "outputs": [],
          "envs": [
            "fake",
            "torch"
          ]
        },
        {
          "kind": "seed",
          "title": "Seed",
          "family": null,
          "help": "The noise seed; -1 picks a random one, reported with the result.",
          "params": [
            {
              "name": "seed",
              "type": "seed",
              "label": "Seed",
              "default": -1,
              "min": -1,
              "max": 9007199254740991,
              "step": 1
            }
          ],
          "inputs": [],
          "outputs": [
            {
              "name": "seed",
              "type": "Seed"
            }
          ],
          "envs": [
            "torch"
          ]
        },
        {
          "kind": "canvas",
          "title": "Canvas",
          "family": null,
          "help": "The output size in pixels; auto follows the last reference in an edit.",
          "params": [
            {
              "name": "mode",
              "type": "enum",
              "label": "Size",
              "default": "auto",
              "enum": [
                "auto",
                "fixed"
              ],
              "help": "auto: with references, about 1 MP (1024 × 1024 area) at the last reference's aspect, sides rounded to 32; without, width × height. fixed: always width × height."
            },
            {
              "name": "width",
              "type": "int",
              "label": "Width",
              "default": 1024,
              "min": 256,
              "max": 4096,
              "step": 32
            },
            {
              "name": "height",
              "type": "int",
              "label": "Height",
              "default": 1024,
              "min": 256,
              "max": 4096,
              "step": 32
            }
          ],
          "inputs": [],
          "outputs": [
            {
              "name": "canvas",
              "type": "Canvas"
            }
          ],
          "envs": [
            "torch"
          ]
        },
        {
          "kind": "image",
          "title": "Image",
          "family": null,
          "help": "An image from the gallery, as an input.",
          "params": [
            {
              "name": "image",
              "type": "image",
              "label": "Image",
              "default": null
            }
          ],
          "inputs": [],
          "outputs": [
            {
              "name": "image",
              "type": "Image"
            }
          ],
          "envs": [
            "torch"
          ]
        }
      ]
    },
    {
      "family": "echo",
      "title": "Echo (fake)",
      "nodes": [
        {
          "kind": "echo/echo",
          "title": "Echo",
          "family": "echo",
          "help": "Fake model: draws its text on a gradient, one progress step at a time.",
          "params": [
            {
              "name": "steps",
              "type": "int",
              "label": "Steps",
              "default": 10,
              "min": 1,
              "max": 200,
              "help": "Progress steps to report."
            },
            {
              "name": "delay_ms",
              "type": "int",
              "label": "Delay per step (ms)",
              "default": 300,
              "min": 0,
              "max": 10000
            },
            {
              "name": "fail",
              "type": "bool",
              "label": "Fail",
              "default": false,
              "help": "Fail after the last step, without an output, to test errors."
            },
            {
              "name": "refs",
              "type": "rows",
              "label": "References",
              "default": [],
              "min": 0,
              "max": 10,
              "item": {
                "image": "Image"
              },
              "mention": "<image{n}>",
              "help": "Images the fake runner reads (and checks) before it echoes; the PNG is unchanged."
            }
          ],
          "inputs": [
            {
              "name": "text",
              "type": "Text"
            }
          ],
          "outputs": [
            {
              "name": "image",
              "type": "Image"
            }
          ],
          "envs": [
            "fake"
          ]
        },
        {
          "kind": "echo/lora-stack",
          "title": "LoRA Stack",
          "family": "echo",
          "help": "Fake LoRA stack: adds the LoRAs and strengths it received to the text. Empty: the text as it is.",
          "params": [
            {
              "name": "rows",
              "type": "rows",
              "label": "LoRAs",
              "default": [],
              "min": 0,
              "max": 8,
              "item": {
                "lora": "Lora",
                "strength": {
                  "type": "float",
                  "label": "Strength",
                  "default": 1,
                  "min": -4,
                  "max": 4,
                  "step": 0.05
                },
                "mode": {
                  "type": "enum",
                  "label": "Mode",
                  "default": "adapter",
                  "enum": [
                    "adapter",
                    "bake"
                  ]
                }
              },
              "help": "Each row: a LoRA, its strength and mode; the fake runner applies nothing, it only names them."
            }
          ],
          "inputs": [
            {
              "name": "text",
              "type": "Text"
            }
          ],
          "outputs": [
            {
              "name": "text",
              "type": "Text"
            }
          ],
          "envs": [
            "fake"
          ]
        }
      ]
    },
    {
      "family": "qwen-image",
      "title": "Qwen Image 2.1",
      "nodes": [
        {
          "kind": "qwen-image/model",
          "title": "Qwen Image 2.1",
          "family": "qwen-image",
          "help": "Which weights to load and at what precision.",
          "params": [
            {
              "name": "variant",
              "type": "enum",
              "label": "Variant",
              "default": "base",
              "enum": [
                "base",
                "turbo"
              ],
              "help": "Turbo: 8 fixed steps, much faster."
            },
            {
              "name": "precision",
              "type": "enum",
              "label": "Precision",
              "default": "int8",
              "enum": [
                "bf16",
                "int8"
              ],
              "help": "int8 quantizes the transformer and text encoder at load: about half the memory."
            }
          ],
          "inputs": [],
          "outputs": [
            {
              "name": "model",
              "type": "Model"
            }
          ],
          "envs": [
            "torch"
          ]
        },
        {
          "kind": "qwen-image/lora-stack",
          "title": "LoRA Stack",
          "family": "qwen-image",
          "help": "Applies LoRAs to the model's transformer, in order. Empty: the model as it is.",
          "params": [
            {
              "name": "rows",
              "type": "rows",
              "label": "LoRAs",
              "default": [],
              "min": 0,
              "max": 8,
              "item": {
                "lora": "Lora",
                "strength": {
                  "type": "float",
                  "label": "Strength",
                  "default": 1,
                  "min": -4,
                  "max": 4,
                  "step": 0.05
                },
                "mode": {
                  "type": "enum",
                  "label": "Mode",
                  "default": "adapter",
                  "enum": [
                    "adapter",
                    "bake"
                  ],
                  "help": "Adapter: strength changes and swaps never reload the model. Bake: merged into the weights at load (its own copy in memory)."
                }
              },
              "help": "Each row: a LoRA that fits this model, its strength and how it is applied."
            }
          ],
          "inputs": [
            {
              "name": "model",
              "type": "Model"
            }
          ],
          "outputs": [
            {
              "name": "model",
              "type": "Model"
            }
          ],
          "envs": [
            "torch"
          ]
        },
        {
          "kind": "qwen-image/encode",
          "title": "Encode prompt",
          "family": "qwen-image",
          "help": "Encodes the prompt and up to 10 reference images; with references the run is an edit.",
          "params": [
            {
              "name": "transparent",
              "type": "bool",
              "label": "Transparent",
              "default": false,
              "help": "Ask for an RGBA image with a transparent background."
            },
            {
              "name": "refs",
              "type": "rows",
              "label": "References",
              "default": [],
              "min": 0,
              "max": 10,
              "item": {
                "image": "Image"
              },
              "mention": "<image{n}>",
              "help": "Images to edit or combine, in order; the prompt names them <image1>, <image2>, …"
            }
          ],
          "inputs": [
            {
              "name": "model",
              "type": "Model"
            },
            {
              "name": "prompt",
              "type": "Text"
            }
          ],
          "outputs": [
            {
              "name": "cond",
              "type": "Conditioning"
            }
          ],
          "envs": [
            "torch"
          ]
        },
        {
          "kind": "qwen-image/sample",
          "title": "Sample",
          "family": "qwen-image",
          "help": "Denoises from the seed's noise.",
          "params": [
            {
              "name": "steps",
              "type": "int",
              "label": "Steps",
              "default": 40,
              "min": 1,
              "max": 200,
              "step": 1,
              "when": "model.variant != 'turbo'",
              "help": "Turbo uses its own 8-step schedule and ignores this."
            }
          ],
          "inputs": [
            {
              "name": "model",
              "type": "Model"
            },
            {
              "name": "cond",
              "type": "Conditioning"
            },
            {
              "name": "canvas",
              "type": "Canvas"
            },
            {
              "name": "seed",
              "type": "Seed"
            }
          ],
          "outputs": [
            {
              "name": "latent",
              "type": "Latent"
            }
          ],
          "envs": [
            "torch"
          ]
        },
        {
          "kind": "qwen-image/decode",
          "title": "Decode",
          "family": "qwen-image",
          "help": "Turns the latent into an RGBA image with the VAE.",
          "params": [
            {
              "name": "tiled",
              "type": "enum",
              "label": "Tiled decode",
              "default": "auto",
              "enum": [
                "auto",
                "on",
                "off"
              ],
              "help": "Tiling cuts decode memory (27 GB vs 65 GB at 4 MP) but changes pixels; auto tiles only when needed."
            }
          ],
          "inputs": [
            {
              "name": "model",
              "type": "Model"
            },
            {
              "name": "latent",
              "type": "Latent"
            }
          ],
          "outputs": [
            {
              "name": "image",
              "type": "Image"
            }
          ],
          "envs": [
            "torch"
          ]
        }
      ]
    },
    {
      "family": "test",
      "title": "Test",
      "nodes": [
        {
          "kind": "test/noise",
          "title": "Noise",
          "family": "test",
          "params": [],
          "inputs": [],
          "outputs": [
            {
              "name": "image",
              "type": "Image"
            }
          ],
          "envs": [
            "fake"
          ]
        },
        {
          "kind": "test/enhance",
          "title": "Enhance",
          "family": "test",
          "help": "Rewrites the prompt; bypassed, the prompt passes through.",
          "params": [
            {
              "name": "think",
              "type": "bool",
              "default": false
            }
          ],
          "inputs": [
            {
              "name": "prompt",
              "type": "Text"
            }
          ],
          "outputs": [
            {
              "name": "text",
              "type": "Text"
            }
          ],
          "envs": [
            "fake"
          ]
        },
        {
          "kind": "test/mix",
          "title": "Mix",
          "family": "test",
          "params": [
            {
              "name": "strength",
              "type": "int",
              "default": 5,
              "min": 0,
              "max": 10
            },
            {
              "name": "blend",
              "type": "float",
              "default": 0.5,
              "min": 0,
              "max": 1
            }
          ],
          "inputs": [
            {
              "name": "a",
              "type": "Image"
            },
            {
              "name": "b",
              "type": "Image",
              "optional": true
            }
          ],
          "outputs": [
            {
              "name": "image",
              "type": "Image"
            }
          ],
          "envs": [
            "fake"
          ]
        },
        {
          "kind": "test/count",
          "title": "Count",
          "family": "test",
          "params": [
            {
              "name": "value",
              "type": "int",
              "default": 1,
              "min": 0,
              "max": 100
            }
          ],
          "inputs": [],
          "outputs": [
            {
              "name": "value",
              "type": "Int"
            }
          ],
          "envs": [
            "fake"
          ]
        },
        {
          "kind": "test/model",
          "title": "Test model",
          "family": "test",
          "params": [],
          "inputs": [],
          "outputs": [
            {
              "name": "model",
              "type": "Model"
            }
          ],
          "envs": [
            "fake"
          ]
        },
        {
          "kind": "test/lora",
          "title": "LoRA",
          "family": "test",
          "params": [],
          "inputs": [
            {
              "name": "model",
              "type": "Model"
            }
          ],
          "outputs": [
            {
              "name": "model",
              "type": "Model"
            }
          ],
          "envs": [
            "fake"
          ]
        },
        {
          "kind": "test/upscale",
          "title": "Upscale",
          "family": "test",
          "params": [],
          "inputs": [
            {
              "name": "image",
              "type": "Image"
            }
          ],
          "outputs": [
            {
              "name": "image",
              "type": "Image"
            }
          ],
          "envs": [
            "torch"
          ]
        }
      ]
    }
  ]
}
