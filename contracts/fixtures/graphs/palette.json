              "name": "steps",
              "type": "int",
              "label": "Steps",
              "default": 4,
              "min": 2,
              "max": 4,
              "step": 1,
              "values": [
                2,
                4
              ],
              "values_by": {
                "param": "role",
                "values": {
                  "stage1": [
                    4
                  ],
                  "stage2": [
                    2
                  ]
                }
              },
              "help": "Fixed by the stage: stage1 runs 4 steps, stage2 runs 2."
