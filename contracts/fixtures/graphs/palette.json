    {
      "family": "echo",
      "title": "Echo (fake)",
      "nodes": [
        {
          "kind": "echo/echo",
          "title": "Echo",
          "family": "echo",
          "help": "Fake model: draws its text on a gradient, one progress step at a time.",
          "params": [
            {
              "name": "steps",
              "type": "int",
              "label": "Steps",
              "default": 10,
              "min": 1,
              "max": 200,
              "help": "Progress steps to report."
            },
            {
              "name": "delay_ms",
              "type": "int",
              "label": "Delay per step (ms)",
              "default": 300,
              "min": 0,
              "max": 10000
            },
            {
              "name": "fail",
              "type": "bool",
              "label": "Fail",
              "default": false,
              "help": "Fail after the last step, without an output, to test errors."
            },
            {
              "name": "refs",
              "type": "rows",
              "label": "References",
              "default": [],
              "min": 0,
              "max": 10,
              "item": {
                "image": "Image"
              },
              "mention": "<image{n}>",
              "help": "Images the fake runner reads (and checks) before it echoes; the PNG is unchanged."
            }
          ],
          "inputs": [
            {
              "name": "text",
              "type": "Text"
            }
          ],
          "outputs": [
            {
              "name": "image",
              "type": "Image"
            }
          ],
          "envs": [
            "fake"
          ]
        },
        {
          "kind": "echo/lora-stack",
          "title": "LoRA Stack",
          "family": "echo",
          "help": "Fake LoRA stack: adds the LoRAs and strengths it received to the text. Empty: the text as it is.",
          "params": [
            {
              "name": "rows",
              "type": "rows",
              "label": "LoRAs",
              "default": [],
              "min": 0,
              "max": 8,
              "item": {
                "lora": "Lora",
                "strength": {
                  "type": "float",
                  "label": "Strength",
                  "default": 1,
                  "min": -4,
                  "max": 4,
                  "step": 0.05
                },
                "mode": {
                  "type": "enum",
                  "label": "Mode",
                  "default": "adapter",
                  "enum": [
                    "adapter",
                    "bake"
                  ]
                }
              },
              "help": "Each row: a LoRA, its strength and mode; the fake runner applies nothing, it only names them."
            }
          ],
          "inputs": [
            {
              "name": "text",
              "type": "Text"
            }
          ],
          "outputs": [
            {
              "name": "text",
              "type": "Text"
            }
          ],
          "envs": [
            "fake"
          ]
        },
