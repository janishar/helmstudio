{
  "description": "from a Text output in an echo workflow: the family's kinds first (Ask (fake) takes Text into its prompt param; echo, echo/a2v, echo/extend, echo/retake, echo/sample, echo/speak, echo/tiny, from 1.79 the music and sound fakes (echo/music, lengthen, repaint, sound, foley, vary), echo-video and echo/keyframes take Text; its Text → Text LoRA stack), then core ones (answer takes Text; prompt takes Text into its text param)",
  "workflow": {
    "title": "Echo",
    "family": "echo",
    "env": "fake",
    "nodes": {
      "prompt": {
        "kind": "prompt",
        "params": {
          "text": ""
        }
      },
      "echo": {
        "kind": "echo/echo",
        "in": {
          "text": "prompt.text"
        },
        "params": {
          "steps": 10,
          "delay_ms": 300,
          "fail": false,
          "refs": []
        }
      },
      "output": {
        "kind": "output",
        "in": {
          "media": "echo.image"
        }
      }
    }
  },
  "from": {
    "node": "prompt",
    "port": "text",
    "side": "output"
  },
  "expect": [
    "echo/ask",
    "echo/echo",
    "echo/a2v",
    "echo/dialogue",
    "echo/extend",
    "echo/music",
    "echo/lengthen",
    "echo/repaint",
    "echo/retake",
    "echo/sample",
    "echo/sound",
    "echo/foley",
    "echo/speak",
    "echo/tiny",
    "echo/vary",
    "echo/video",
    "echo/keyframes",
    "echo/lora-stack",
    "answer",
    "prompt"
  ]
}
