{
  "description": "minimax-h3 first and last frame: a second core image node wired to generate's optional last input (how a user workflow adds a last frame to the image-to-video template)",
  "workflow": {
    "title": "MiniMax H3 First and last frame",
    "family": "minimax-h3",
    "env": "native",
    "nodes": {
      "prompt": {
        "kind": "prompt",
        "params": {
          "text": ""
        }
      },
      "seed": {
        "kind": "seed",
        "params": {
          "seed": -1
        }
      },
      "canvas": {
        "kind": "minimax-h3/canvas",
        "params": {
          "width": 864,
          "height": 480
        }
      },
      "duration": {
        "kind": "minimax-h3/duration",
        "params": {
          "frames": 124,
          "fps": 24
        }
      },
      "model": {
        "kind": "minimax-h3/model",
        "params": {
          "variant": "base",
          "precision": "int8"
        }
      },
      "first": {
        "kind": "image",
        "params": {
          "image": null
        }
      },
      "last": {
        "kind": "image",
        "params": {
          "image": null
        }
      },
      "generate": {
        "kind": "minimax-h3/generate",
        "in": {
          "model": "model.model",
          "prompt": "prompt.text",
          "seed": "seed.seed",
          "canvas": "canvas.canvas",
          "duration": "duration.duration",
          "first": "first.image",
          "last": "last.image"
        },
        "params": {
          "steps": 6,
          "layers": 50,
          "reuse": 1,
          "refs": []
        }
      },
      "output": {
        "kind": "output",
        "in": {
          "media": "generate.video"
        }
      }
    }
  },
  "problems": []
}
