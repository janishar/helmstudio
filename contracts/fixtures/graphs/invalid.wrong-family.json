{
  "description": "a test/ kind in an echo workflow (the Text wire itself is fine: Text is no handle)",
  "workflow": {
    "title": "Wrong family",
    "family": "echo",
    "env": "fake",
    "nodes": {
      "prompt": {
        "kind": "prompt",
        "params": {
          "text": ""
        }
      },
      "echo": {
        "kind": "echo/echo",
