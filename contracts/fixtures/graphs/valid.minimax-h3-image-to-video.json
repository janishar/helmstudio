{
  "description": "the canonical minimax-h3-image-to-video template: a core image node feeds generate's optional first input (its image param is null in a workflow); last stays unwired",
  "workflow": {
    "title": "MiniMax H3 Image to video",
    "family": "minimax-h3",
    "env": "native",
    "nodes": {
      "prompt": {
        "kind": "prompt",
        "params": {
          "text": ""
        }
      },
      "seed": {
        "kind": "seed",
        "params": {
          "seed": -1
        }
      },
      "canvas": {
        "kind": "minimax-h3/canvas",
        "params": {
          "width": 864,
          "height": 480
        }
      },
      "duration": {
        "kind": "minimax-h3/duration",
        "params": {
          "frames": 124,
          "fps": 24
        }
      },
      "model": {
        "kind": "minimax-h3/model",
        "params": {
          "variant": "base",
          "precision": "int8"
        }
      },
      "first": {
        "kind": "image",
        "params": {
          "image": null
        }
      },
      "generate": {
        "kind": "minimax-h3/generate",
        "in": {
          "model": "model.model",
          "prompt": "prompt.text",
          "seed": "seed.seed",
          "canvas": "canvas.canvas",
          "duration": "duration.duration",
          "first": "first.image"
        },
        "params": {
          "steps": 6,
          "speed": "exact",
          "refs": []
        }
      },
      "output": {
        "kind": "output",
        "in": {
          "media": "generate.video"
        }
      }
    },
    "studio": {
      "composer": [
        "prompt.text",
        "first.image"
      ],
      "quick": [
        "generate.speed",
        "seed.seed"
      ],
      "inspector": [
        {
          "title": "Canvas",
          "items": [
            "canvas.width",
            "canvas.height"
          ]
        },
        {
          "title": "Duration",
          "items": [
            "duration.frames"
          ]
        },
        {
          "title": "Quality",
          "items": [
            "generate.steps"
          ]
        }
      ],
      "labels": {
        "first.image": "First frame"
      }
    }
  },
  "problems": []
}
