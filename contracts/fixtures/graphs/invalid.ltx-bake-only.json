{
  "description": "a bake-only family (ltx/lora-stack mode enum [bake]) refuses an adapter row: param_invalid",
  "workflow": {
    "title": "LTX-2.5 Text to video",
    "family": "ltx",
    "env": "mlx",
    "nodes": {
      "prompt": {
        "kind": "prompt",
        "params": {
          "text": ""
        }
      },
      "seed": {
        "kind": "seed",
        "params": {
          "seed": -1
        }
      },
      "canvas": {
        "kind": "ltx/canvas",
        "params": {
          "width": 704,
          "height": 448
        }
      },
      "duration": {
        "kind": "ltx/duration",
        "params": {
          "frames": 49,
          "fps": 24
        }
      },
      "model": {
        "kind": "ltx/model",
        "params": {
          "variant": "distilled",
          "precision": "int8"
        }
      },
      "lora": {
        "kind": "ltx/lora-stack",
        "in": {
          "model": "model.model"
        },
        "params": {
          "rows": [
            {
              "lora": {
                "lora_id": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
              },
              "strength": 0.8,
              "mode": "adapter"
            }
          ]
        }
      },
      "encode": {
        "kind": "ltx/encode",
        "in": {
          "model": "model.model",
          "prompt": "prompt.text"
        },
        "params": {
          "beats": []
        }
      },
      "sample1": {
        "kind": "ltx/sample",
        "in": {
          "model": "lora.model",
          "cond": "encode.cond",
          "seed": "seed.seed",
          "canvas": "canvas.canvas",
          "duration": "duration.duration"
        },
        "params": {
          "role": "stage1",
          "steps": 8
        }
      },
      "upscale": {
        "kind": "ltx/upscale",
        "in": {
          "model": "model.model",
          "latent": "sample1.latent"
        },
        "params": {}
      },
      "sample2": {
        "kind": "ltx/sample",
        "in": {
          "model": "lora.model",
          "cond": "encode.cond",
          "seed": "seed.seed",
          "latent": "upscale.latent"
        },
        "params": {
          "role": "stage2",
          "steps": 3
        }
      },
      "decode": {
        "kind": "ltx/decode",
        "in": {
          "model": "model.model",
          "latent": "sample2.latent"
        },
        "params": {
          "audio": true
        }
      },
      "output": {
        "kind": "output",
        "in": {
          "media": "decode.video"
        }
      }
    },
    "studio": {
      "composer": [
        "prompt.text"
      ],
      "quick": [
        "elements",
        "look:film",
        "look:camera",
        "look:lighting",
        "model.variant",
        "decode.audio"
      ],
      "inspector": [
        {
          "title": "Canvas",
          "items": [
            "canvas.width",
            "canvas.height"
          ]
        },
        {
          "title": "Duration",
          "items": [
            "duration.frames",
            "duration.fps"
          ]
        },
        {
          "title": "Quality",
          "items": [
            "model.precision",
            "sample1.steps",
            "sample2.steps"
          ]
        },
        {
          "title": "Prompt beats",
          "items": [
            "encode.beats"
          ]
        },
        {
          "title": "LoRA",
          "items": [
            "lora.rows"
          ]
        }
      ],
      "labels": {
        "sample1.steps": "Stage 1 steps",
        "sample2.steps": "Stage 2 steps"
      },
      "presets": {
        "Fast": {
          "model.precision": "int8"
        },
        "Quality": {
          "model.precision": "bf16"
        },
        "Low memory": {
          "model.precision": "int4"
        }
      }
    }
  },
  "loras": {
    "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc": "ltx"
  },
  "problems": [
    {
      "code": "param_invalid",
      "node": "lora",
      "param": "rows"
    }
  ]
}
