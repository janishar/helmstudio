{
  "description": "from a Conditioning handle: only kinds of the same family",
  "workflow": {
    "title": "Qwen Image",
    "family": "qwen-image",
    "env": "torch",
    "nodes": {
      "prompt": {
        "kind": "prompt",
        "params": {
          "text": ""
        }
      },
      "seed": {
        "kind": "seed",
        "params": {
          "seed": -1
        }
      },
      "canvas": {
        "kind": "canvas",
        "params": {
          "mode": "auto",
          "width": 1024,
          "height": 1024
        }
      },
      "model": {
        "kind": "qwen-image/model",
        "params": {
          "variant": "base",
          "precision": "int8"
        }
      },
      "encode": {
        "kind": "qwen-image/encode",
        "in": {
          "model": "model.model",
          "prompt": "prompt.text"
        },
        "params": {
          "transparent": false,
          "refs": []
        }
      },
      "sample": {
        "kind": "qwen-image/sample",
        "in": {
          "model": "model.model",
          "cond": "encode.cond",
          "canvas": "canvas.canvas",
          "seed": "seed.seed"
        },
        "params": {
          "steps": 40
        }
      },
      "decode": {
        "kind": "qwen-image/decode",
        "in": {
          "model": "model.model",
          "latent": "sample.latent"
        },
        "params": {
          "tiled": "auto"
        }
      },
      "output": {
        "kind": "output",
        "in": {
          "media": "decode.image"
        }
      }
    }
  },
  "from": {
    "node": "encode",
    "port": "cond",
    "side": "output"
  },
  "expect": [
    "qwen-image/sample"
  ]
}
