{
  "description": "the canonical turn schema (contracts/README.md, Agents: a turn) as compact JSON with sorted keys: what pipelines sends as `ask.schema` for a local ask (its text is part of the replay key's inputs hash); server and remote calls send the same args schemas as OpenAI tools[].function.parameters",
  "cases": [
    {
      "description": "a list agent with tools (director in a row)",
      "node": {
        "tools": [
          "gallery.search",
          "library.read",
          "rows.add",
          "rows.edit"
        ],
        "list": {
          "max": 3
        }
      },
      "chat": false,
      "expect": "{\"additionalProperties\":false,\"properties\":{\"calls\":{\"items\":{\"anyOf\":[{\"additionalProperties\":false,\"properties\":{\"args\":{\"additionalProperties\":false,\"properties\":{\"collection\":{\"maxLength\":80,\"minLength\":1,\"type\":\"string\"},\"kind\":{\"enum\":[\"image\",\"video\"]},\"limit\":{\"maximum\":20,\"minimum\":1,\"type\":\"integer\"},\"starred\":{\"type\":\"boolean\"},\"text\":{\"maxLength\":200,\"type\":\"string\"}},\"type\":\"object\"},\"tool\":{\"const\":\"gallery_search\"}},\"required\":[\"tool\",\"args\"],\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"args\":{\"additionalProperties\":false,\"properties\":{\"group\":{\"enum\":[\"character\",\"location\",\"prop\",\"film\",\"camera\",\"colour\",\"lighting\"]},\"kind\":{\"enum\":[\"element\",\"look\"]},\"limit\":{\"maximum\":20,\"minimum\":1,\"type\":\"integer\"},\"text\":{\"maxLength\":100,\"type\":\"string\"}},\"type\":\"object\"},\"tool\":{\"const\":\"library_read\"}},\"required\":[\"tool\",\"args\"],\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"args\":{\"additionalProperties\":false,\"properties\":{\"inputs\":{\"additionalProperties\":{\"anyOf\":[{\"maxLength\":4000,\"type\":\"string\"},{\"type\":\"number\"},{\"additionalProperties\":false,\"properties\":{\"take_id\":{\"pattern\":\"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$\",\"type\":\"string\"}},\"required\":[\"take_id\"],\"type\":\"object\"}]},\"maxProperties\":16,\"minProperties\":1,\"propertyNames\":{\"pattern\":\"^[a-z][a-z0-9_]{0,63}$\"},\"type\":\"object\"}},\"required\":[\"inputs\"],\"type\":\"object\"},\"tool\":{\"const\":\"rows_add\"}},\"required\":[\"tool\",\"args\"],\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"args\":{\"additionalProperties\":false,\"properties\":{\"items\":{\"items\":{\"maxLength\":4000,\"minLength\":1,\"type\":\"string\"},\"maxItems\":3,\"minItems\":1,\"type\":\"array\"}},\"required\":[\"items\"],\"type\":\"object\"},\"tool\":{\"const\":\"set_items\"}},\"required\":[\"tool\",\"args\"],\"type\":\"object\"}]},\"maxItems\":4,\"type\":\"array\"},\"say\":{\"maxLength\":4000,\"type\":\"string\"}},\"required\":[\"say\",\"calls\"],\"type\":\"object\"}"
    },
    {
      "description": "an agent with routes and memory.read",
      "node": {
        "tools": [
          "memory.read"
        ],
        "routes": {
          "again": "one more try",
          "done": "finish"
        }
      },
      "chat": false,
      "expect": "{\"additionalProperties\":false,\"properties\":{\"calls\":{\"items\":{\"anyOf\":[{\"additionalProperties\":false,\"properties\":{\"args\":{\"additionalProperties\":false,\"properties\":{\"key\":{\"pattern\":\"^[a-z][a-z0-9_-]{0,63}$\",\"type\":\"string\"},\"kind\":{\"enum\":[\"note\",\"judge_example\"]},\"limit\":{\"maximum\":16,\"minimum\":1,\"type\":\"integer\"}},\"type\":\"object\"},\"tool\":{\"const\":\"memory_read\"}},\"required\":[\"tool\",\"args\"],\"type\":\"object\"},{\"additionalProperties\":false,\"properties\":{\"args\":{\"additionalProperties\":false,\"properties\":{\"reason\":{\"maxLength\":300,\"type\":\"string\"},\"to\":{\"enum\":[\"again\",\"done\"],\"type\":\"string\"}},\"required\":[\"to\",\"reason\"],\"type\":\"object\"},\"tool\":{\"const\":\"route\"}},\"required\":[\"tool\",\"args\"],\"type\":\"object\"}]},\"maxItems\":4,\"type\":\"array\"},\"say\":{\"maxLength\":4000,\"type\":\"string\"}},\"required\":[\"say\",\"calls\"],\"type\":\"object\"}"
    },
    {
      "description": "an agent with no tools: calls must be []",
      "node": {
        "instruction": "x"
      },
      "chat": false,
      "expect": "{\"additionalProperties\":false,\"properties\":{\"calls\":{\"maxItems\":0,\"type\":\"array\"},\"say\":{\"maxLength\":4000,\"type\":\"string\"}},\"required\":[\"say\",\"calls\"],\"type\":\"object\"}"
    },
    {
      "description": "the director's chat turn",
      "node": {
        "tools": [
          "gallery.search",
          "library.read",
