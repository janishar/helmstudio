            "args": {
              "to": "done",
              "reason": "The take matches."
            }
          }
        ]
      },
      "expect": {
        "calls": [
          {
            "tool": "memory_read",
            "args": {
              "limit": 4
            }
          },
          {
            "tool": "route",
            "args": {
              "to": "done",
              "reason": "The take matches."
            }
          }
        ],
        "final": true,
        "route": "done"
      }
