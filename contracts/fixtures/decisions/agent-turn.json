{
  "description": "agent turns (contracts/README.md, Agents: a turn): an answer (local: the turn JSON; server or remote: a native OpenAI assistant message, normalised) against the node's offered tools, routes, list, the visit's remaining tool calls and whether set_items was called earlier in the visit → the calls to run, whether the visit ends and its route, or the error the one re-ask is told. pipelines_service runs them. An expected error is a prefix of the actual one (a schema error adds the validator's text after `: `)",
  "cases": [
    {
      "description": "a tool call: runs, not final",
      "node": {
        "tools": [
          "memory.write"
        ]
      },
      "calls_left": 12,
      "answer": {
        "say": "Noting it.",
        "calls": [
          {
            "tool": "memory_write",
            "args": {
              "key": "briefs",
              "text": "Foxes look better in snow."
            }
          }
        ]
      },
      "expect": {
        "calls": [
          {
            "tool": "memory_write",
            "args": {
              "key": "briefs",
              "text": "Foxes look better in snow."
            }
          }
        ],
        "final": false,
        "route": null
      }
    },
    {
      "description": "no calls on a plain agent: the final answer",
