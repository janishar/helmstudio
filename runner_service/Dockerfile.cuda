# runner_service as the torch runner on Linux + NVIDIA (M6: a GPU host's container; deploy/gpu-host/ runs it with the
# NVIDIA container runtime). Base: the same slim Python as the fake runner, not nvidia/cuda: torch's PyPI wheels
# (uv.lock, extra "torch", sys_platform linux) already bundle CUDA 13 (cuda-toolkit, cudnn, nccl ... wheels), so a
# CUDA base image would carry a second copy; only the driver comes from the host, mounted by the NVIDIA runtime.
# Weights are never in the image: the host's models folder is bind-mounted at HELMSTUDIO_MODELS (read-only unless
# this host takes model jobs); RUNNER_CACHE (the LoRA cache, model hashes, download temp files) and TMPDIR are
# writable volumes. The `native` target (the last) runs the native runner (RUNNER_ENV=native: ZONOS3 by its CUDA
# zonos3-server, built in the zonos3 stage, Dockerfile.cuda.dockerignore lets its sources in; MiniMax H3 fp8 by
# SGLang, the sglang stage). Health check: `python health.py` (exit 0
# while NATS is connected).
FROM python:3.14.10-slim-trixie AS build
RUN pip install --no-cache-dir uv==0.13.8
WORKDIR /app
ENV UV_PROJECT_ENVIRONMENT=/app/.venv UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy
COPY pyproject.toml uv.lock ./
RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-dev --no-install-project --extra torch

# The native runner's zonos3-server (packs/zonos3, `make zonos3-cuda`): built with nvcc 13.2 (sm_120 needs 12.8 or
# later; 13.2 is the CUDA of torch's wheels) on Ubuntu 24.04, whose glibc and libstdc++ are older than trixie's, so the
# binary runs in the runtime stage; cargo 1.88 (textnorm's rust-version) from the official image. Only cudart and
# cuBLAS go into the runtime stage, beside the binary (its RUNPATH $ORIGIN/lib); libcuda comes from the driver.
FROM rust:1.88.0-slim-trixie AS rust
FROM nvidia/cuda:13.2.1-devel-ubuntu24.04 AS zonos3
RUN apt-get update && apt-get install -y --no-install-recommends cmake make g++ git && rm -rf /var/lib/apt/lists/*
COPY --from=rust /usr/local/cargo /usr/local/cargo
COPY --from=rust /usr/local/rustup /usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo RUSTUP_HOME=/usr/local/rustup PATH=/usr/local/cargo/bin:$PATH
WORKDIR /src
COPY Makefile ./
COPY vendor/zonos3 vendor/zonos3
RUN make zonos3-cuda && mkdir vendor/zonos3/build/lib \
    && cp -P /usr/local/cuda/lib64/libcudart.so.13* /usr/local/cuda/lib64/libcublas.so.13* \
        /usr/local/cuda/lib64/libcublasLt.so.13* vendor/zonos3/build/lib/

# The native runner's SGLang Diffusion (packs/minimax_h3 sgl.py, the fp8 variant): its own venv in /opt/sglang on a
# uv-managed Python 3.12 in /opt/python (sglang has no 3.14 wheel and pins torch 2.14.1, the torch runner 2.15), so
# neither env sees the other's packages; comfy-kitchen for int8 embeddings a ConvRot text encoder may carry; locked in
# sglang-requirements.txt. Several GB: only the `native` target below carries it.
FROM python:3.14.10-slim-trixie AS sglang
RUN pip install --no-cache-dir uv==0.13.8
ENV UV_PYTHON_INSTALL_DIR=/opt/python UV_LINK_MODE=copy UV_COMPILE_BYTECODE=1
COPY sglang-requirements.txt /tmp/
RUN --mount=type=cache,target=/root/.cache/uv uv venv --python 3.12 /opt/sglang \
    && VIRTUAL_ENV=/opt/sglang uv pip sync /tmp/sglang-requirements.txt
# SGLang's JIT kernels (QK norm, ConvRot int8) link -L<CUDA_HOME>/lib64 -lcudart: the nvcc wheel has lib/ and only
# libcudart.so.13
RUN cd /opt/sglang/lib/python3.12/site-packages/nvidia/cu13 && ln -s lib lib64 && ln -s libcudart.so.13 lib/libcudart.so

FROM python:3.14.10-slim-trixie AS runtime
WORKDIR /app
# compute for torch, video for NVENC (libnvidia-encode), utility for the driver version
ENV PATH=/app/.venv/bin:$PATH PYTHONUNBUFFERED=1 \
    NVIDIA_VISIBLE_DEVICES=all NVIDIA_DRIVER_CAPABILITIES=compute,utility,video \
    RUNNER_ENV=torch RUNNER_DEVICE=cuda HELMSTUDIO_MODELS=/models \
    RUNNER_CACHE=/cache TMPDIR=/cache/tmp
RUN useradd --system --create-home --uid 10001 runner \
    && mkdir -p /models /cache/tmp && chown runner:runner /models /cache /cache/tmp
# ffmpeg for media jobs: libx264, and h264_nvenc where the GPU encodes (core/media.py tries it at start)
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
COPY --from=build /app/.venv /app/.venv
COPY . .
COPY --from=zonos3 /src/vendor/zonos3/build/zonos3-server /app/vendor/zonos3/build/
COPY --from=zonos3 /src/vendor/zonos3/build/lib /app/vendor/zonos3/build/lib
USER runner
VOLUME ["/cache"]
EXPOSE 8081
HEALTHCHECK --interval=15s --timeout=5s --start-period=120s --retries=3 CMD ["python", "health.py"]
CMD ["python", "main.py"]

# The native runner on a GPU host (deploy/gpu-host runner-native): the runtime plus SGLang. `--target runtime` builds
# the torch runner's image without it.
FROM runtime AS native
COPY --from=sglang /opt/python /opt/python
COPY --from=sglang /opt/sglang /opt/sglang
# the JIT kernels' build: g++ for nvcc's host side, ninja and nvcc (the venv's wheels) found on PATH (appended: the
# runner's python stays first; deep_gemm takes CUDA_HOME from nvcc's folder)
USER root
RUN apt-get update && apt-get install -y --no-install-recommends g++ && rm -rf /var/lib/apt/lists/*
USER runner
ENV PATH=$PATH:/opt/sglang/bin:/opt/sglang/lib/python3.12/site-packages/nvidia/cu13/bin
