# runner_service (`make dev`). Compose sets the same names, with secrets as <VAR>_FILE.
NATS_URL=nats://runner:change-me@localhost:4222
HEALTH_PORT=8081
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=helmstudio
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
# which runner: fake/fake (the echo pack, compose) or a native one (`make runners`): mac/torch (needs
# `uv sync --extra torch`), mac/mlx (uv project envs/mlx) or mac/native (no extra; runs the vendored h3 binary,
# `make h3`). `make runners` sets HEALTH_PORT per env: torch 8091, mlx 8092, native 8093
RUNNER_HOST=fake
RUNNER_ENV=fake
HELMSTUDIO_MODELS=~/GenAI/models
# TLS for a remote GPU host (NATS_URL tls://…, S3_ENDPOINT https://…): the stack's CA; empty = the system CAs.
# NATS_CERT_FILE / NATS_KEY_FILE: an optional client cert. These are paths, never read into the environment.
NATS_CA_FILE=
NATS_CERT_FILE=
NATS_KEY_FILE=
S3_CA_FILE=
# torch device: empty = mps, then cuda, then cpu (the first present); set to force one
RUNNER_DEVICE=
# torch on CUDA: auto | dequant (how FP8 weights multiply)
RUNNER_FP8_MATMUL=auto
# residency: budget = RAM - reserve (CUDA: VRAM - reserve); after a run: unload | keep_warm | keep_pinned
# (RUNNER_PIN=transformer,vae). CUDA only: host RAM budget = RAM - RUNNER_RAM_RESERVE_GB
RUNNER_RESERVE_GB=12
RUNNER_RAM_RESERVE_GB=4
RUNNER_AFTER_RUN=keep_warm
RUNNER_IDLE_UNLOAD_S=600
RUNNER_PIN=
# (the four above are the defaults; the admin's Hosts settings, KV host_settings, replace them while they exist)

# model downloads: the Hub (the fake hub in tests and the fake overlay) and the file holding the host's Hub token,
# read only for a gated repo; absent = anonymous. Default ../deploy/secrets/hf_token. Never put a token here.
HF_ENDPOINT=https://huggingface.co
RUNNER_HF_TOKEN_FILE=
