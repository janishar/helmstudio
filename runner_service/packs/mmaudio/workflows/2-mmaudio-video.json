{
  "id": "mmaudio-video",
  "title": "MMAudio Sound from a video",
  "action": "Add sound",
  "family": "mmaudio",
  "env": "torch",
  "media": "audio",
  "nodes": {
    "prompt": {
      "kind": "prompt",
      "params": {
        "text": ""
      }
    },
    "seed": {
      "kind": "seed",
      "params": {
        "seed": -1
      }
    },
    "model": {
      "kind": "mmaudio/model",
      "params": {
        "variant": "large_44k_v2",
        "precision": "bf16"
      }
    },
    "foley": {
      "kind": "mmaudio/foley",
      "in": {
        "model": "model.model",
        "text": "prompt.text",
        "seed": "seed.seed"
      },
      "params": {
        "source": null,
        "seconds": 0,
        "avoid": "",
        "guidance": 4.5,
        "steps": 25
      }
    },
    "output": {
      "kind": "output",
      "in": {
        "media": "foley.audio"
      }
    },
    "output_video": {
      "kind": "output",
      "in": {
        "media": "foley.video"
      }
    }
  },
  "studio": {
    "composer": [
      "prompt.text",
      "foley.source",
      "foley.avoid"
    ],
    "quick": [
      "foley.seconds",
      "seed.seed"
    ],
    "inspector": [
      {
        "title": "Quality",
        "items": [
          "foley.guidance",
          "foley.steps"
        ]
      }
    ]
  }
}
