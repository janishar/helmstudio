{
  "id": "minimax-h3-references",
  "title": "MiniMax H3 References",
  "family": "minimax-h3",
  "env": "native",
  "media": "video",
  "nodes": {
    "prompt": {
      "kind": "prompt",
      "params": {
        "text": ""
      }
    },
    "seed": {
      "kind": "seed",
      "params": {
        "seed": -1
      }
    },
    "canvas": {
      "kind": "minimax-h3/canvas",
      "params": {
        "width": 864,
        "height": 480
      }
    },
    "duration": {
      "kind": "minimax-h3/duration",
      "params": {
        "frames": 124,
        "fps": 24
      }
    },
    "model": {
      "kind": "minimax-h3/model",
      "params": {
        "variant": "base",
        "precision": "int8"
      }
    },
    "generate": {
      "kind": "minimax-h3/generate",
      "in": {
        "model": "model.model",
        "prompt": "prompt.text",
        "seed": "seed.seed",
        "canvas": "canvas.canvas",
        "duration": "duration.duration"
      },
      "params": {
        "steps": 20,
        "layers": 45,
        "reuse": 2,
        "core_reuse": 1,
        "token_reduction": false,
        "render": "Full",
        "quality": "lossless",
        "flow_shift": 12,
        "audio_flow_shift": 3,
        "refs": [],
        "videos": [],
        "audios": []
      }
    },
    "output": {
      "kind": "output",
      "in": {
        "media": "generate.video"
      }
    }
  },
  "studio": {
    "composer": [
      "prompt.text",
      "generate.refs",
      "generate.videos",
      "generate.audios"
    ],
    "quick": [
      "elements",
      "model.variant",
      "seed.seed"
    ],
    "inspector": [
      {
        "title": "Canvas",
        "items": [
          "canvas.width",
          "canvas.height"
        ]
      },
      {
        "title": "Duration",
        "items": [
          "duration.frames"
        ]
      },
      {
        "title": "Quality",
        "help": "On NVIDIA (Base fp8) a preset sets only Steps, so Fast and Default run the same there; Mode and the flow shifts are NVIDIA only.",
        "items": [
          "model.precision",
          "generate.steps",
          "generate.quality",
          "generate.flow_shift",
          "generate.audio_flow_shift"
        ]
      },
      {
        "title": "Advanced",
        "help": "h3's speed settings on a Mac (Base). Hidden on Base fp8: the NVIDIA run ignores them.",
        "items": [
          "generate.layers",
          "generate.reuse",
          "generate.core_reuse",
          "generate.render",
          "generate.token_reduction"
        ]
      }
    ],
    "presets": {
      "Draft": {
        "generate.steps": 4,
        "generate.layers": 50,
        "generate.reuse": 1,
        "generate.token_reduction": false,
        "generate.core_reuse": 1
      },
      "Fast": {
        "generate.steps": 20,
        "generate.layers": 45,
        "generate.reuse": 2,
        "generate.token_reduction": true,
        "generate.core_reuse": 1
      },
      "Default": {
        "generate.steps": 20,
        "generate.layers": 45,
        "generate.reuse": 2,
        "generate.token_reduction": false,
        "generate.core_reuse": 1
      },
      "Reference": {
        "generate.steps": 50,
        "generate.layers": 50,
        "generate.reuse": 1,
        "generate.token_reduction": false,
        "generate.core_reuse": 1
      }
    },
    "preset_order": [
      "Draft",
      "Fast",
      "Default",
      "Reference"
    ]
  }
}
