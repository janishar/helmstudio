{
  "id": "minimax-h3-image-to-video",
  "title": "MiniMax H3 Image to video",
  "action": "Animate",
  "family": "minimax-h3",
  "env": "native",
  "media": "video",
  "nodes": {
    "prompt": {
      "kind": "prompt",
      "params": {
        "text": ""
      }
    },
    "seed": {
      "kind": "seed",
      "params": {
        "seed": -1
      }
    },
    "canvas": {
      "kind": "minimax-h3/canvas",
      "params": {
        "width": 864,
        "height": 480
      }
    },
    "duration": {
      "kind": "minimax-h3/duration",
      "params": {
        "frames": 124,
        "fps": 24
      }
    },
    "model": {
      "kind": "minimax-h3/model",
      "params": {
        "variant": "base",
        "precision": "int8"
      }
    },
    "first": {
      "kind": "image",
      "params": {
        "image": null
      }
    },
    "last": {
      "kind": "image",
      "optional": true,
      "params": {
        "image": null
      }
    },
    "generate": {
      "kind": "minimax-h3/generate",
      "in": {
        "model": "model.model",
        "prompt": "prompt.text",
        "seed": "seed.seed",
        "canvas": "canvas.canvas",
        "duration": "duration.duration",
        "first": "first.image",
        "last": "last.image"
      },
      "params": {
        "steps": 6,
        "speed": "exact",
        "refs": [],
        "videos": [],
        "audios": []
      }
    },
    "output": {
      "kind": "output",
      "in": {
        "media": "generate.video"
      }
    }
  },
  "studio": {
    "composer": [
      "prompt.text",
      "first.image",
      "last.image"
    ],
    "quick": [
      "generate.speed",
      "seed.seed"
    ],
    "inspector": [
      {
        "title": "Canvas",
        "items": [
          "canvas.width",
          "canvas.height"
        ]
      },
      {
        "title": "Duration",
        "items": [
          "duration.frames"
        ]
      },
      {
        "title": "Quality",
        "items": [
          "generate.steps"
        ]
      }
    ],
    "labels": {
      "first.image": "First frame",
      "last.image": "Last frame"
    }
  }
}
