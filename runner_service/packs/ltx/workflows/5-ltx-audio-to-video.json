{
  "id": "ltx-audio-to-video",
  "title": "LTX-2.5 Audio to video",
  "action": "Audio to video",
  "family": "ltx",
  "env": "mlx",
  "media": "video",
  "nodes": {
    "prompt": {
      "kind": "prompt",
      "params": {
        "text": ""
      }
    },
    "seed": {
      "kind": "seed",
      "params": {
        "seed": -1
      }
    },
    "canvas": {
      "kind": "ltx/canvas",
      "params": {
        "width": 704,
        "height": 448
      }
    },
    "model": {
      "kind": "ltx/model",
      "params": {
        "variant": "distilled",
        "precision": "int8"
      },
      "only": {
        "variant": [
          "distilled",
          "dev"
        ],
        "precision": [
          "int8",
          "int4"
        ]
      }
    },
    "encode": {
      "kind": "ltx/encode-guided",
      "in": {
        "model": "model.model",
        "prompt": "prompt.text"
      },
      "params": {
        "negative": ""
      }
    },
    "audio": {
      "kind": "ltx/encode-audio",
      "in": {
        "model": "model.model"
      },
      "params": {
        "source": null,
        "fps": 24
      }
    },
    "keyframes": {
      "kind": "ltx/keyframes",
      "in": {
        "cond": "encode.cond"
      },
      "params": {
        "images": []
      },
      "bypass": true
    },
    "sample1": {
      "kind": "ltx/sample-guided",
      "in": {
        "model": "model.model",
        "cond": "keyframes.cond",
        "seed": "seed.seed",
        "canvas": "canvas.canvas",
        "duration": "audio.duration",
        "audio": "audio.latent"
      },
      "params": {
        "steps": 30,
        "cfg": 3,
        "stg": 1,
        "detail": false
      }
    },
    "upscale": {
      "kind": "ltx/upscale",
      "in": {
        "model": "model.model",
        "latent": "sample1.latent"
      },
      "params": {}
    },
    "distill": {
      "kind": "ltx/distill",
      "in": {
        "model": "model.model"
      },
      "params": {}
    },
    "detail": {
      "kind": "ltx/ic-lora",
      "in": {
        "model": "distill.model"
      },
      "params": {
        "strength": 0.5
      },
      "bypass": true
    },
    "sample2": {
      "kind": "ltx/sample",
      "in": {
        "model": "detail.model",
        "cond": "keyframes.cond",
        "seed": "seed.seed",
        "latent": "upscale.latent",
        "reference": "sample1.latent"
      },
      "params": {
        "role": "stage2",
        "steps": 3,
        "detail": false
      }
    },
    "decode": {
      "kind": "ltx/decode",
      "in": {
        "model": "model.model",
        "latent": "sample2.latent"
      },
      "params": {
        "audio": true
      }
    },
    "output": {
      "kind": "output",
      "in": {
        "media": "decode.video"
      }
    }
  },
  "studio": {
    "composer": [
      "prompt.text",
      "audio.source"
    ],
    "quick": [
      "model.variant",
      "keyframes.bypass",
      "keyframes.images",
      "decode.audio"
    ],
    "inspector": [
      {
        "title": "Canvas",
        "items": [
          "canvas.width",
          "canvas.height"
        ]
      },
      {
        "title": "Quality",
        "help": "Distilled keeps the source sound frozen and runs its own 8 steps. Detail adds the detail pass, as on text to video. Mac only.",
        "items": [
          "model.precision",
          "sample1.steps",
          "sample1.cfg",
          "sample1.stg",
          "sample2.steps"
        ],
        "choices": [
          {
            "label": "Recipe",
            "options": [
              {
                "name": "Two-stage",
                "set": {
                  "detail.bypass": true,
                  "sample1.detail": false,
                  "sample2.detail": false
                }
              },
              {
                "name": "Detail",
                "help": "sharper, about a third slower",
                "set": {
                  "detail.bypass": false,
                  "sample1.detail": true,
                  "sample2.detail": true
                }
              }
            ]
          }
        ]
      },
      {
        "title": "Negative prompt",
        "help": "What the clip should not show, for Dev's guidance. Empty: the fixed negative prompt. Distilled has none.",
        "items": [
          "encode.negative"
        ]
      }
    ],
    "labels": {
      "keyframes.bypass": "No keyframes",
      "keyframes.images": "Frames",
      "sample1.steps": "Stage 1 steps",
      "sample2.steps": "Stage 2 steps"
    },
    "presets": {
      "Fast": {
        "model.precision": "int8"
      },
      "Low memory": {
        "model.precision": "int4"
      }
    }
  }
}
