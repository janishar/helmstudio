{
  "id": "ltx-retake",
  "title": "LTX-2.5 Retake",
  "action": "Retake a section",
  "family": "ltx",
  "env": "mlx",
  "media": "video",
  "nodes": {
    "prompt": {
      "kind": "prompt",
      "params": {
        "text": ""
      }
    },
    "seed": {
      "kind": "seed",
      "params": {
        "seed": -1
      }
    },
    "model": {
      "kind": "ltx/model",
      "params": {
        "variant": "distilled",
        "precision": "int8"
      },
      "only": {
        "variant": [
          "distilled",
          "dev"
        ],
        "precision": [
          "int8",
          "int4"
        ]
      }
    },
    "encode": {
      "kind": "ltx/encode-guided",
      "in": {
        "model": "model.model",
        "prompt": "prompt.text"
      },
      "params": {}
    },
    "source": {
      "kind": "ltx/encode-video",
      "in": {
        "model": "model.model"
      },
      "params": {
        "source": null
      }
    },
    "retake": {
      "kind": "ltx/retake",
      "in": {
        "model": "model.model",
        "cond": "encode.cond",
        "seed": "seed.seed",
        "latent": "source.latent"
      },
      "params": {
        "span": null,
        "audio": true,
        "steps": 30,
        "cfg": 3,
        "stg": 1
      }
    },
    "decode": {
      "kind": "ltx/decode",
      "in": {
        "model": "model.model",
        "latent": "retake.latent"
      },
      "params": {
        "audio": true
      }
    },
    "output": {
      "kind": "output",
      "in": {
        "media": "decode.video"
      }
    }
  },
  "studio": {
    "composer": [
      "prompt.text",
      "source.source",
      "retake.span"
    ],
    "quick": [
      "elements",
      "model.variant",
      "retake.audio",
      "decode.audio"
    ],
    "inspector": [
      {
        "title": "Quality",
        "help": "Distilled runs its own 8 steps without guidance. Dev adds Steps, CFG and STG here.",
        "items": [
          "model.precision",
          "retake.steps",
          "retake.cfg",
          "retake.stg"
        ]
      }
    ],
    "presets": {
      "Fast": {
        "model.precision": "int8"
      },
      "Low memory": {
        "model.precision": "int4"
      }
    }
  }
}
