{
  "id": "ltx-text-to-video",
  "title": "LTX-2.5 Text to video",
  "family": "ltx",
  "env": "mlx",
  "media": "video",
  "nodes": {
    "prompt": {
      "kind": "prompt",
      "params": {
        "text": ""
      }
    },
    "seed": {
      "kind": "seed",
      "params": {
        "seed": -1
      }
    },
    "canvas": {
      "kind": "ltx/canvas",
      "params": {
        "width": 704,
        "height": 448
      }
    },
    "duration": {
      "kind": "ltx/duration",
      "params": {
        "frames": 49,
        "fps": 24
      }
    },
    "model": {
      "kind": "ltx/model",
      "params": {
        "variant": "distilled",
        "precision": "int8",
        "compute": "float32"
      },
      "only": {
        "variant": [
          "distilled",
          "distilled-fp8"
        ]
      }
    },
    "lora": {
      "kind": "ltx/lora-stack",
      "in": {
        "model": "model.model"
      },
      "params": {
        "rows": []
      }
    },
    "detail": {
      "kind": "ltx/ic-lora",
      "in": {
        "model": "lora.model"
      },
      "params": {
        "strength": 0.5
      },
      "bypass": true
    },
    "encode": {
      "kind": "ltx/encode",
      "in": {
        "model": "model.model",
        "prompt": "prompt.text"
      },
      "params": {
        "beats": [],
        "negative": ""
      }
    },
    "sample1": {
      "kind": "ltx/sample",
      "in": {
        "model": "lora.model",
        "cond": "encode.cond",
        "seed": "seed.seed",
        "canvas": "canvas.canvas",
        "duration": "duration.duration"
      },
      "params": {
        "role": "stage1",
        "steps": 8,
        "detail": false
      }
    },
    "upscale": {
      "kind": "ltx/upscale",
      "in": {
        "model": "model.model",
        "latent": "sample1.latent"
      },
      "params": {}
    },
    "sample2": {
      "kind": "ltx/sample",
      "in": {
        "model": "detail.model",
        "cond": "encode.cond",
        "seed": "seed.seed",
        "latent": "upscale.latent",
        "reference": "sample1.latent"
      },
      "params": {
        "role": "stage2",
        "steps": 3,
        "detail": false
      }
    },
    "decode": {
      "kind": "ltx/decode",
      "in": {
        "model": "model.model",
        "latent": "sample2.latent"
      },
      "params": {
        "audio": true
      }
    },
    "output": {
      "kind": "output",
      "in": {
        "media": "decode.video"
      }
    }
  },
  "studio": {
    "composer": [
      "prompt.text"
    ],
    "quick": [
      "elements",
      "look:film",
      "look:camera",
      "look:lighting",
      "model.variant",
      "decode.audio"
    ],
    "inspector": [
      {
        "title": "Canvas",
        "items": [
          "canvas.width",
          "canvas.height"
        ]
      },
      {
        "title": "Duration",
        "items": [
          "duration.frames"
        ]
      },
      {
        "title": "Quality",
        "help": "Distilled models run their own steps without guidance.",
        "items": [
          "model.precision",
          "model.compute",
          "sample1.steps",
          "sample2.steps"
        ],
        "choices": [
          {
            "label": "Recipe",
            "help": "Two-stage renders at half size, upscales and refines at full size. One-stage stops after stage 1: faster, and the clip is half the canvas.",
            "options": [
              {
                "name": "Two-stage",
                "help": "half size, then ×2 and 3 refine steps",
                "set": {
                  "upscale.bypass": false,
                  "sample2.bypass": false,
                  "detail.bypass": true,
                  "sample1.detail": false,
                  "sample2.detail": false
                }
              },
              {
                "name": "One-stage",
                "help": "the full size in one pass, softer",
                "set": {
                  "upscale.bypass": true,
                  "sample2.bypass": true,
                  "detail.bypass": true,
                  "sample1.detail": false,
                  "sample2.detail": false
                }
              },
              {
                "name": "Detail",
                "help": "Two-stage, then refines stage 2 with Lightricks' detailing LoRA against stage 1: sharper hair, edges and texture, about a third slower. Mac only; needs the Detailer add-on.",
                "set": {
                  "upscale.bypass": false,
                  "sample2.bypass": false,
                  "detail.bypass": false,
                  "sample1.detail": true,
                  "sample2.detail": true
                }
              }
            ]
          }
        ]
      },
      {
        "title": "Negative prompt",
        "help": "What the clip should not show. Applied with NAG, about 10 % slower. Empty: off.",
        "items": [
          "encode.negative"
        ]
      },
      {
        "title": "Prompt beats",
        "help": "Each beat steers the picture and the sound for its stretch. The main prompt covers the rest.",
        "items": [
          "encode.beats"
        ]
      },
      {
        "title": "LoRA",
        "help": "Adapter: applied at run time, a strength change needs no reload. Bake: merged at load.",
        "items": [
          "lora.rows"
        ]
      }
    ],
    "labels": {
      "sample1.steps": "Stage 1 steps",
      "sample2.steps": "Stage 2 steps"
    },
    "presets": {
      "Fast": {
        "model.precision": "int8",
        "model.compute": "float16"
      },
      "Quality": {
        "model.precision": "bf16",
        "model.compute": "float32"
      },
      "Low memory": {
        "model.precision": "int4",
        "model.compute": "float32"
      }
    }
  }
}
