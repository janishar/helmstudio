{
  "id": "ltx-image-to-video",
  "title": "LTX-2.5 Image to video",
  "action": "Animate",
  "family": "ltx",
  "env": "mlx",
  "media": "video",
  "nodes": {
    "prompt": {
      "kind": "prompt",
      "params": {
        "text": ""
      }
    },
    "seed": {
      "kind": "seed",
      "params": {
        "seed": -1
      }
    },
    "canvas": {
      "kind": "ltx/canvas",
      "params": {
        "width": 704,
        "height": 448
      }
    },
    "duration": {
      "kind": "ltx/duration",
      "params": {
        "frames": 49,
        "fps": 24
      }
    },
    "model": {
      "kind": "ltx/model",
      "params": {
        "variant": "distilled",
        "precision": "int8"
      }
    },
    "lora": {
      "kind": "ltx/lora-stack",
      "in": {
        "model": "model.model"
      },
      "params": {
        "rows": []
      }
    },
    "encode": {
      "kind": "ltx/encode",
      "in": {
        "model": "model.model",
        "prompt": "prompt.text"
      },
      "params": {
        "beats": []
      }
    },
    "keyframes": {
      "kind": "ltx/keyframes",
      "in": {
        "cond": "encode.cond"
      },
      "params": {
        "images": []
      }
    },
    "sample1": {
      "kind": "ltx/sample",
      "in": {
        "model": "lora.model",
        "cond": "keyframes.cond",
        "seed": "seed.seed",
        "canvas": "canvas.canvas",
        "duration": "duration.duration"
      },
      "params": {
        "role": "stage1",
        "steps": 8
      }
    },
    "upscale": {
      "kind": "ltx/upscale",
      "in": {
        "model": "model.model",
        "latent": "sample1.latent"
      },
      "params": {}
    },
    "sample2": {
      "kind": "ltx/sample",
      "in": {
        "model": "lora.model",
        "cond": "keyframes.cond",
        "seed": "seed.seed",
        "latent": "upscale.latent"
      },
      "params": {
        "role": "stage2",
        "steps": 3
      }
    },
    "decode": {
      "kind": "ltx/decode",
      "in": {
        "model": "model.model",
        "latent": "sample2.latent"
      },
      "params": {
        "audio": true
      }
    },
    "output": {
      "kind": "output",
      "in": {
        "media": "decode.video"
      }
    }
  },
  "studio": {
    "composer": [
      "prompt.text"
    ],
    "quick": [
      "keyframes.images",
      "elements",
      "look:film",
      "look:camera",
      "look:lighting",
      "model.variant",
      "decode.audio"
    ],
    "inspector": [
      {
        "title": "Canvas",
        "items": [
          "canvas.width",
          "canvas.height"
        ]
      },
      {
        "title": "Duration",
        "items": [
          "duration.frames"
        ]
      },
      {
        "title": "Quality",
        "help": "Distilled models run without guidance. Switch the model to Dev for guidance and a negative prompt.",
        "items": [
          "model.precision",
          "sample1.steps",
          "sample2.steps"
        ],
        "choices": [
          {
            "label": "Recipe",
            "help": "Two-stage renders at half size, upscales and refines at full size. One-stage stops after stage 1: faster, and the clip is half the canvas.",
            "options": [
              {
                "name": "Two-stage",
                "set": {
                  "upscale.bypass": false,
                  "sample2.bypass": false
                }
              },
              {
                "name": "One-stage",
                "set": {
                  "upscale.bypass": true,
                  "sample2.bypass": true
                }
              }
            ]
          }
        ]
      },
      {
        "title": "Prompt beats",
        "help": "A beat steers one part of the clip. The main prompt covers the rest.",
        "items": [
          "encode.beats"
        ]
      },
      {
        "title": "LoRA",
        "help": "Only LoRAs made for LTX-2.5 can be added. Each is baked into the transformer at load: a strength change reloads it.",
        "items": [
          "lora.rows"
        ]
      }
    ],
    "labels": {
      "sample1.steps": "Stage 1 steps",
      "sample2.steps": "Stage 2 steps",
      "keyframes.images": "Frames"
    },
    "presets": {
      "Fast": {
        "model.precision": "int8"
      },
      "Quality": {
        "model.precision": "bf16"
      },
      "Low memory": {
        "model.precision": "int4"
      }
    }
  }
}
