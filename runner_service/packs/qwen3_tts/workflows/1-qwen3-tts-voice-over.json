{
  "id": "qwen3-tts-voice-over",
  "title": "Qwen3-TTS Voice-over",
  "family": "qwen3-tts",
  "env": "torch",
  "media": "audio",
  "nodes": {
    "prompt": {
      "kind": "prompt",
      "params": {
        "text": ""
      }
    },
    "seed": {
      "kind": "seed",
      "params": {
        "seed": -1
      }
    },
    "model": {
      "kind": "qwen3-tts/model",
      "params": {
        "variant": "custom_voice",
        "precision": "bf16"
      },
      "only": {
        "variant": [
          "custom_voice"
        ]
      }
    },
    "speak": {
      "kind": "qwen3-tts/speak",
      "in": {
        "model": "model.model",
        "text": "prompt.text",
        "seed": "seed.seed"
      },
      "params": {
        "voice": null,
        "language": "auto",
        "style": "",
        "temperature": 0.3
      },
      "only": {
        "voice": [
          "preset"
        ]
      }
    },
    "output": {
      "kind": "output",
      "in": {
        "media": "speak.audio"
      }
    }
  },
  "studio": {
    "composer": [
      "prompt.text"
    ],
    "quick": [
      "speak.voice",
      "speak.language",
      "seed.seed"
    ],
    "inspector": [
      {
        "title": "Voice",
        "items": [
          "speak.style",
          "speak.temperature"
        ]
      }
    ],
    "presets": {
      "Steady": {
        "speak.temperature": 0.3
      },
      "Lively": {
        "speak.temperature": 0.9
      }
    }
  },
  "standard": {
    "kind": "voice",
    "model": "Qwen3-TTS",
    "fields": {
      "line": "prompt.text",
      "voice": "speak.voice",
      "seed": "seed.seed"
    },
    "seconds": 1.5
  }
}
