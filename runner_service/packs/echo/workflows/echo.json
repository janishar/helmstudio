{
  "id": "echo",
  "title": "Echo",
  "family": "echo",
  "env": "fake",
  "nodes": {
    "prompt": {
      "kind": "prompt",
      "params": {
        "text": ""
      }
    },
    "echo": {
      "kind": "echo/echo",
      "in": {
