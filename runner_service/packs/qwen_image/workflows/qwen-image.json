{
  "id": "qwen-image",
  "title": "Qwen Image",
  "action": "Edit",
  "family": "qwen-image",
  "env": "torch",
  "nodes": {
    "prompt": {
      "kind": "prompt",
      "params": {
        "text": ""
      }
    },
    "seed": {
      "kind": "seed",
      "params": {
        "seed": -1
      }
    },
    "canvas": {
      "kind": "canvas",
      "params": {
        "mode": "auto",
        "width": 1024,
        "height": 1024
      }
    },
    "model": {
      "kind": "qwen-image/model",
      "params": {
        "variant": "turbo",
        "precision": "int8"
      }
    },
    "lora": {
      "kind": "qwen-image/lora-stack",
      "in": {
        "model": "model.model"
      },
      "params": {
        "rows": []
      }
    },
    "enhance": {
      "kind": "qwen-image/enhance",
      "bypass": true,
      "in": {
        "prompt": "prompt.text",
        "canvas": "canvas.canvas",
        "seed": "seed.seed"
      },
      "params": {
        "think": false
      }
    },
    "encode": {
      "kind": "qwen-image/encode",
      "in": {
        "model": "model.model",
        "prompt": "enhance.text"
      },
      "params": {
        "transparent": false,
        "refs": []
      }
    },
    "sample": {
      "kind": "qwen-image/sample",
      "in": {
        "model": "lora.model",
        "cond": "encode.cond",
        "canvas": "enhance.canvas",
        "seed": "seed.seed"
      },
      "params": {
        "steps": 40
      }
    },
    "decode": {
      "kind": "qwen-image/decode",
      "in": {
        "model": "model.model",
        "latent": "sample.latent"
      },
      "params": {
        "tiled": "auto"
      }
    },
    "output": {
      "kind": "output",
      "in": {
        "media": "decode.image"
      }
    }
  },
  "studio": {
    "composer": [
      "prompt.text",
      "encode.refs"
    ],
    "quick": [
      "elements",
      "look:film",
      "look:camera",
      "look:colour",
      "look:lighting",
      "model.variant",
      "enhance.bypass",
      "seed.seed"
    ],
    "inspector": [
      {
        "title": "Canvas",
        "items": [
          "canvas.mode",
          "canvas.width",
          "canvas.height"
        ]
      },
      {
        "title": "Quality",
        "items": [
          "model.precision",
          "sample.steps",
          "decode.tiled"
        ]
      },
      {
        "title": "LoRA",
        "items": [
          "lora.rows"
        ]
      },
      {
        "title": "Enhance",
        "items": [
          "enhance.think"
        ]
      },
      {
        "title": "Options",
        "items": [
          "encode.transparent"
        ]
      }
    ],
    "labels": {
      "enhance.bypass": "No enhance"
    },
    "presets": {
      "Plain": {
        "enhance.bypass": true
      },
      "Enhanced": {
        "enhance.bypass": false,
        "enhance.think": false
      },
      "Enhanced, think": {
        "enhance.bypass": false,
        "enhance.think": true
      }
    }
  },
  "standard": {
    "kind": "image",
    "model": "Qwen Image 2.1",
    "fields": {
      "prompt": "prompt.text",
      "refs": "encode.refs",
      "width": "canvas.width",
      "height": "canvas.height",
      "seed": "seed.seed"
    },
    "set": {
      "canvas.mode": "fixed"
    },
    "seconds": 45
  }
}
