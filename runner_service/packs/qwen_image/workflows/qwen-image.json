{
  "id": "qwen-image",
  "title": "Qwen Image",
  "action": "Edit",
  "family": "qwen-image",
  "env": "torch",
  "nodes": {
    "prompt": {
      "kind": "prompt",
      "params": {
        "text": ""
      }
    },
    "seed": {
      "kind": "seed",
      "params": {
        "seed": -1
      }
    },
    "canvas": {
      "kind": "canvas",
      "params": {
        "mode": "auto",
        "width": 1024,
        "height": 1024
      }
    },
    "model": {
      "kind": "qwen-image/model",
      "params": {
        "variant": "base",
        "precision": "int8"
      }
    },
    "lora": {
      "kind": "qwen-image/lora-stack",
      "in": {
        "model": "model.model"
      },
      "params": {
        "rows": []
      }
    },
    "encode": {
      "kind": "qwen-image/encode",
      "in": {
        "model": "model.model",
        "prompt": "prompt.text"
      },
      "params": {
        "transparent": false,
        "refs": []
      }
    },
    "sample": {
      "kind": "qwen-image/sample",
      "in": {
        "model": "lora.model",
        "cond": "encode.cond",
        "canvas": "canvas.canvas",
        "seed": "seed.seed"
      },
      "params": {
        "steps": 40
      }
    },
    "decode": {
      "kind": "qwen-image/decode",
      "in": {
        "model": "model.model",
        "latent": "sample.latent"
      },
      "params": {
        "tiled": "auto"
      }
    },
    "output": {
      "kind": "output",
      "in": {
        "media": "decode.image"
      }
    }
  },
  "studio": {
    "composer": [
      "prompt.text",
      "encode.refs"
    ],
    "quick": [
      "elements",
      "look:film",
      "look:camera",
      "look:colour",
      "look:lighting",
      "model.variant",
      "seed.seed"
    ],
    "inspector": [
      {
        "title": "Canvas",
        "items": [
          "canvas.mode",
          "canvas.width",
          "canvas.height"
        ]
      },
      {
        "title": "Quality",
        "items": [
          "model.precision",
          "sample.steps",
          "decode.tiled"
        ]
      },
      {
        "title": "LoRA",
        "items": [
          "lora.rows"
        ]
      },
      {
        "title": "Options",
        "items": [
          "encode.transparent"
        ]
      }
    ]
  }
}
