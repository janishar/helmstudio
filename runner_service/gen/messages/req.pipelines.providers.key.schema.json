{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helmstudio.local/contracts/messages/req.pipelines.providers.key.schema.json",
  "title": "NATS request/reply pipelines.providers.key (studio → pipelines)",
  "description": "From API 1.51. Core NATS request/reply on subject `pipelines.providers.key` (queue group `pipelines`), bare JSON, for GET /v1/studio/admin/provider-keys/{key_secret}: is the key file there? Pipelines answers `found` = a regular file of that name in one of its key folders (PIPELINES_PROVIDER_KEYS_DIR) whose size is above 0, by stat only: it never opens the file, and the key is never in the reply. Studio waits 5 s (no answer: 503).",
  "$defs": {
    "request": {
      "type": "object",
      "required": [
        "key_secret"
      ],
      "additionalProperties": false,
      "properties": {
        "key_secret": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
        }
      }
    },
    "reply": {
      "oneOf": [
        {
          "$ref": "#/$defs/ok"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    },
    "ok": {
      "type": "object",
      "required": [
        "found"
      ],
      "additionalProperties": false,
      "properties": {
        "found": {
          "type": "boolean",
          "description": "a regular file, not empty"
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "error",
        "code"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "code": {
          "enum": [
            "internal"
          ]
        }
      }
    }
  }
}
