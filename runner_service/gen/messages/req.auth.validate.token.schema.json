{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helmstudio.local/contracts/messages/req.auth.validate.token.schema.json",
  "title": "NATS request/reply auth.validate.token (auth_service api/message/handler.go)",
  "description": "Core NATS request/reply on subject `auth.validate.token` (queue group auth), not JetStream and not enveloped: the request and the reply are the bare JSON objects below. Validation checks signature, issuer, expiry, that the user is enabled and the session not revoked.",
  "$defs": {
    "request": {
      "type": "object",
      "required": [
        "token"
      ],
      "properties": {
        "token": {
          "type": "string",
          "minLength": 1,
          "description": "the user's access token (JWT)"
        }
      }
    },
    "reply": {
      "oneOf": [
        {
          "$ref": "#/$defs/ok"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    },
    "ok": {
      "type": "object",
      "required": [
        "user_id",
        "email",
        "jti",
        "family_id",
        "expires_at"
      ],
      "not": {
        "required": [
          "error"
        ]
      },
      "properties": {
        "user_id": {
          "$ref": "defs.schema.json#/$defs/uuid",
          "description": "token sub"
        },
        "email": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "user",
              "dev",
              "admin"
            ]
          },
          "description": "omitted when the user has no roles"
        },
        "jti": {
          "type": "string",
          "minLength": 1
        },
        "family_id": {
          "$ref": "defs.schema.json#/$defs/uuid",
          "description": "session (refresh-token family); matches evt.auth.revoked data.family_id"
        },
        "expires_at": {
          "type": "string",
          "format": "date-time",
          "description": "token exp: cache the answer at most until then"
        },
        "allowed": false
      }
    },
    "error": {
      "type": "object",
      "required": [
        "error"
      ],
      "properties": {
        "error": {
          "type": "string",
          "minLength": 1,
          "description": "\"invalid or expired token\" (bad signature/issuer, expired, disabled user, revoked session), \"bad request: want {...}\" (unparseable request, empty token), or \"internal error\"; treat every error as not authenticated"
        }
      }
    }
  }
}
