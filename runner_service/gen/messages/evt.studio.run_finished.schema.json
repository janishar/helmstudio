{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helmstudio.local/contracts/messages/evt.studio.run_finished.schema.json",
  "title": "studio → pipelines: a batch run (or a session's naming run) reached a terminal status",
  "description": "Subject evt.studio.<session_id>.run_finished (stream EVT), Nats-Msg-Id <run_id>:finished, written to studio's outbox in the transaction that makes a run with a batch_id terminal: the projector applying the runner's status, and every status studio decides itself (cancelled, created failed for no live host, created cancelled for a stopped batch, lease lost twice). pipelines_service consumes it (durable `pipelines-runs` on EVT, filter `evt.studio.>`) and resumes the waiting thread with it whatever the outcome; one that finds no thread waiting on this run (already resumed from a studio.runs.create reply) is acked and dropped. From API 1.43 also for a session's hidden naming run (purpose name): batch_id and row null, idempotency_key `name:<session_id>` (pipelines' names.py takes it).",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "evt.studio.run_finished"
    },
    "version": {
      "const": 1
    },
    "job_id": {
      "$ref": "defs.schema.json#/$defs/uuid",
      "description": "the run id"
    },
    "data": {
      "type": "object",
      "required": [
        "run_id",
        "batch_id",
        "row",
        "idempotency_key",
        "status",
        "take_ids"
      ],
      "properties": {
        "run_id": {
          "$ref": "defs.schema.json#/$defs/uuid",
          "description": "= envelope job_id"
        },
        "batch_id": {
          "oneOf": [
            {
              "$ref": "defs.schema.json#/$defs/uuid"
            },
            {
              "type": "null"
            }
          ],
          "description": "null only for a naming run (API 1.43)"
        },
        "row": {
          "oneOf": [
            {
              "$ref": "defs.schema.json#/$defs/batchRow"
            },
            {
              "const": 0
            },
            {
              "type": "null"
            }
          ],
          "description": "the row; from API 1.15 0 = the director's chat thread (its turns' ask runs); null only for a naming run (API 1.43)"
        },
        "idempotency_key": {
          "oneOf": [
            {
              "$ref": "defs.schema.json#/$defs/idempotencyKey"
            },
            {
              "type": "string",
              "pattern": "^name:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            }
          ],
          "description": "the key the run was created under: names the thread (batch:row), row attempt, node, loop and branch; `name:<session_id>` for a naming run"
        },
        "status": {
          "$ref": "defs.schema.json#/$defs/terminalRunStatus"
        },
        "take_ids": {
          "$ref": "defs.schema.json#/$defs/takeIds"
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000,
          "description": "required (non-empty) when failed"
        },
        "answer": {
          "$ref": "defs.schema.json#/$defs/answer",
          "description": "from API 1.14: the run's answer (a text workflow), as evt.run.status carried it; absent otherwise"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "failed"
              }
            }
          },
          "then": {
            "required": [
              "error"
            ],
            "properties": {
              "error": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "batch_id": {
                "type": "null"
              }
            },
            "required": [
              "batch_id"
            ]
          },
          "then": {
            "properties": {
              "row": {
                "type": "null"
              },
              "idempotency_key": {
                "pattern": "^name:"
              }
            }
          },
          "else": {
            "properties": {
              "row": {
                "type": "integer"
              },
              "idempotency_key": {
                "not": {
                  "pattern": "^name:"
                }
              }
            }
          }
        }
      ]
    }
  }
}
