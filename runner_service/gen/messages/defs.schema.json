{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helmstudio.local/contracts/messages/defs.schema.json",
  "title": "shared definitions",
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "objectKey": {
      "description": "claim check: an object-store key under the owner's prefix u/<owner_id>/ (never bytes)",
      "type": "string",
      "maxLength": 1024,
      "pattern": "^u/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[^\\u0000-\\u001f\\u007f]+$",
      "not": {
        "pattern": "(^|/)\\.\\.(/|$)"
      }
    },
    "objectPrefix": {
      "allOf": [
        {
          "$ref": "#/$defs/objectKey"
        },
        {
          "pattern": "/$"
        }
      ]
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "description": "per-job sequence over every evt.run.* message of one run (= envelope job_id), starting at 1; the projector dedupes on (job_id, seq)"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "description": "the run's attempt: 1, or 2 after the dispatcher lost the lease of attempt 1 and queued the run again (a run command is delivered once)",
      "maximum": 2
    },
    "hostName": {
      "type": "string",
      "pattern": "^[a-z0-9]{1,32}$",
      "description": "a GPU host's name: lower-case letters and digits (one NATS subject token)"
    },
    "envName": {
      "type": "string",
      "pattern": "^[a-z0-9]{1,32}$",
      "description": "a runner env on a host (mlx, torch, fake)"
    },
    "workflowId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$",
      "description": "a registry workflow's slug (echo, qwen-image) or a user workflow's UUID (lower-case, which also fits this pattern)"
    },
    "nodeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$",
      "description": "a node's id inside one workflow graph"
    },
    "nodeKind": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,63}(/[a-z][a-z0-9_-]{0,63})?$",
      "description": "a node schema's kind: a core node (prompt, output) or <family>/<node> (echo/echo)"
    },
    "portRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}\\.[a-z][a-z0-9_]{0,63}$",
      "description": "<node id>.<output name> of another node in the same graph"
    },
    "scalarValue": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ],
      "description": "an int, float, bool, string, text, enum or seed value; null only for a seed (random) or an image param left empty"
    },
    "imageRef": {
      "type": "object",
      "description": "an Image value as a client writes it (RunRequest.inputs, batch rows, made_with, every pipelines message): a take of the caller, by id. Never an object key or a URL: studio resolves it (contracts/README.md, Image inputs)",
      "required": [
        "take_id"
      ],
      "additionalProperties": false,
      "properties": {
        "take_id": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "image": {
      "type": "object",
      "description": "an Image value as studio resolves it for cmd.run.execute: the take's immutable object, owned by the envelope's owner_id. The runner reads `key` from the object store and nothing else; its cache key for the image is (owner_id, key, etag)",
      "required": [
        "take_id",
        "key",
        "content_type",
        "width",
        "height",
        "bytes",
        "etag"
      ],
      "additionalProperties": false,
      "properties": {
        "take_id": {
          "$ref": "#/$defs/uuid"
        },
        "key": {
          "$ref": "#/$defs/objectKey",
          "description": "the take's object, u/<owner_id>/runs/… or u/<owner_id>/uploads/…"
        },
        "content_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp"
          ]
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16384
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "description": "the object's size"
        },
        "etag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "the object's ETag (quotes stripped) from studio's HEAD when it resolved the run; with the key, the content's identity for the runner's cache"
        }
      }
    },
    "loraId": {
      "type": "string",
      "pattern": "^([0-9a-f]{64}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$",
      "description": "a LoRA's id: a shared LoRA's is the lower-case hex SHA-256 of its file (the same file on two hosts is one LoRA); a user's own LoRA's is a UUID (contracts/README.md, LoRAs)"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "lower-case hex SHA-256 of a whole file"
    },
    "loraRef": {
      "type": "object",
      "description": "a Lora value as a client writes it (a rows item's Lora field in RunRequest.inputs, workflows, presets, batch rows, made_with, every pipelines message): a LoRA the caller can use, by id. Never a path, key or URL: studio resolves it (contracts/README.md, LoRAs)",
      "required": [
        "lora_id"
      ],
      "additionalProperties": false,
      "properties": {
        "lora_id": {
          "$ref": "#/$defs/loraId"
        }
      }
    },
    "lora": {
      "type": "object",
      "description": "a Lora value as studio resolves it for cmd.run.execute. shared: the runner finds the file by `sha256` in its own index (the dispatcher sent the run only to a host that lists it). own: the runner fetches `key` (under the envelope owner's u/<owner_id>/loras/) to its LoRA cache on first use and checks `bytes` and `sha256`",
      "required": [
        "lora_id",
        "source",
        "name",
        "sha256",
        "bytes"
      ],
      "additionalProperties": false,
      "properties": {
        "lora_id": {
          "$ref": "#/$defs/loraId"
        },
        "source": {
          "enum": [
            "shared",
            "own"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "for messages only (`LoRA <name>: …`)"
        },
        "sha256": {
          "$ref": "#/$defs/sha256",
          "description": "the file's content hash; = lora_id for a shared LoRA. The runner's cache identity for the LoRA"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483648
        },
        "key": {
          "$ref": "#/$defs/objectKey",
          "description": "own only: u/<owner_id>/loras/<lora_id>.safetensors"
        }
      },
      "if": {
        "properties": {
          "source": {
            "const": "own"
          }
        }
      },
      "then": {
        "required": [
          "key"
        ]
      },
      "else": {
        "not": {
          "required": [
            "key"
          ]
        }
      }
    },
    "inputValue": {
      "description": "a value in the client form (RunRequest.inputs, batch rows, made_with): a scalar, an Image as {take_id}, or a rows value (an ordered list of items, field → scalar, {take_id} or, for a Lora field, {lora_id})",
      "anyOf": [
        {
          "$ref": "#/$defs/scalarValue"
        },
        {
          "$ref": "#/$defs/imageRef"
        },
        {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "$ref": "#/$defs/scalarValue"
                },
                {
                  "$ref": "#/$defs/imageRef"
                },
                {
                  "$ref": "#/$defs/loraRef"
                }
              ]
            }
          }
        }
      ]
    },
    "resolvedValue": {
      "description": "a value in cmd.run.execute: like inputValue, with every Image resolved to `image` and every Lora to `lora`",
      "anyOf": [
        {
          "$ref": "#/$defs/scalarValue"
        },
        {
          "$ref": "#/$defs/image"
        },
        {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "$ref": "#/$defs/scalarValue"
                },
                {
                  "$ref": "#/$defs/image"
                },
                {
                  "$ref": "#/$defs/lora"
                }
              ]
            }
          }
        }
      ]
    },
    "paramValue": {
      "description": "a param value in a graph: inputValue (registry workflows, snapshots) or resolvedValue (cmd.run.execute). See registry.schema.json paramSchema for the types",
      "anyOf": [
        {
          "$ref": "#/$defs/scalarValue"
        },
        {
          "$ref": "#/$defs/imageRef"
        },
        {
          "$ref": "#/$defs/image"
        },
        {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "$ref": "#/$defs/scalarValue"
                },
                {
                  "$ref": "#/$defs/imageRef"
                },
                {
                  "$ref": "#/$defs/image"
                },
                {
                  "$ref": "#/$defs/loraRef"
                },
                {
                  "$ref": "#/$defs/lora"
                }
              ]
            }
          }
        }
      ]
    },
    "graphNode": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "$ref": "#/$defs/nodeKind"
        },
        "params": {
          "type": "object",
          "description": "param name → value; a param left out takes its node schema's default",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/paramValue"
          }
        },
        "in": {
          "type": "object",
          "description": "input port name (or the name of a value param wired from upstream: contracts/README.md, Graph rules) → the output it is wired to",
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/portRef"
          }
        },
        "bypass": {
          "type": "boolean",
          "description": "true = the node is switched off and passes its inputs through (contracts/README.md, Graph rules); absent = false. Never true in cmd.run.execute: studio splices bypassed nodes out before it sends a graph"
        },
        "position": {
          "type": "object",
          "description": "the node's place in the Graph view (canvas pixels, top-left of the card); absent = laid out by the client. Never in cmd.run.execute",
          "required": [
            "x",
            "y"
          ],
          "additionalProperties": false,
          "properties": {
            "x": {
              "type": "number"
            },
            "y": {
              "type": "number"
            }
          }
        }
      }
    },
    "graph": {
      "type": "object",
      "description": "a workflow's node graph: node id → node",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/$defs/nodeId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/graphNode"
      }
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991,
      "description": "a seed the runner actually used (exact in a JS number)"
    },
    "inputs": {
      "type": "object",
      "description": "<node id>.<param name> → value (RunRequest.inputs); only the params to change",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{0,63}\\.[a-z][a-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/inputValue"
      }
    },
    "workflowSnapshot": {
      "type": "object",
      "description": "a registry workflow or a user workflow as it was when the batch was submitted (a user workflow's nodes keep `bypass`, drop `position`; no `studio`); the batch runs this graph, never the live one",
      "required": [
        "id",
        "title",
        "family",
        "env",
        "nodes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/workflowId"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "minLength": 1
        },
        "env": {
          "$ref": "#/$defs/envName"
        },
        "nodes": {
          "$ref": "#/$defs/graph"
        }
      }
    },
    "batchRow": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500,
      "description": "a batch row number, from 1 (after seed repetition)"
    },
    "rowAttempt": {
      "type": "integer",
      "minimum": 1,
      "description": "a batch row's attempt: 1, +1 on every Retry of the row"
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:[1-9][0-9]{0,2}:[1-9][0-9]{0,3}:[a-z][a-z0-9_]{0,63}:(0|[1-9][0-9]{0,4}):[a-z0-9_-]{1,64}$",
      "description": "<batch_id>:<row>:<row attempt>:<graph node>:<loop count>:<branch>, e.g. …:3:1:step:0:0. A batch of one workflow uses node `step`, loop 0, branch `0`. studio.runs.create returns the same run for the same key. A pipeline batch: <graph node> = the step node id, <loop count> = its visit in the row attempt from 0, <branch> = the seed index from 0"
    },
    "takeIds": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/uuid"
      },
      "description": "take ids, by output index"
    },
    "terminalRunStatus": {
      "enum": [
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "rowStatus": {
      "enum": [
        "queued",
        "running",
        "waiting",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "description": "pipelines' view of a row: queued = not started; running = its run was requested and has not finished (a pipeline row: anywhere between its steps); waiting = parked on a gate for a pick (pipeline batches only)"
    },
    "batchStatus": {
      "enum": [
        "running",
        "paused",
        "done",
        "failed",
        "stopped"
      ],
      "description": "set by pipelines_service (queued exists only in studio's record, before the first event)"
    },
    "takeIdList": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/uuid"
      },
      "description": "at most 8 take ids (a step's seeds, a gate's candidates or pick)"
    },
    "pipelineSource": {
      "type": "string",
      "pattern": "^(\\$[a-z][a-z0-9_]{0,63}|[a-z][a-z0-9_]{0,63}\\.(takes|picked))$",
      "description": "`$<input>`, `<step>.takes` or `<gate>.picked` (contracts/README.md, Pipeline rules)"
    },
    "pipelineNode": {
      "description": "a node of a pipeline snapshot: the document's node, a step's `inputs` already merged over its preset by studio at Submit, plus `seed_param`",
      "oneOf": [
        {
          "type": "object",
          "required": [
            "kind",
            "inputs"
          ],
          "properties": {
            "kind": {
              "const": "inputs"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "position": {
              "type": "object",
              "description": "the node's place in the Graph view (canvas pixels, top-left of the card); absent = laid out by the client. Never in cmd.run.execute",
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              }
            },
            "inputs": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "type"
                ],
                "properties": {
                  "name": {
                    "$ref": "#/$defs/nodeId"
                  },
                  "type": {
                    "enum": [
                      "Text",
                      "Image",
                      "Int",
                      "Float",
                      "Seed"
                    ]
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "workflow",
            "seeds",
            "inputs",
            "bind",
            "seed_param"
          ],
          "properties": {
            "kind": {
              "const": "step"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "position": {
              "type": "object",
              "description": "the node's place in the Graph view (canvas pixels, top-left of the card); absent = laid out by the client. Never in cmd.run.execute",
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              }
            },
            "workflow": {
              "$ref": "#/$defs/workflowId"
            },
            "seeds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "preset": {
              "type": "string",
              "description": "for display: already merged into inputs"
            },
            "inputs": {
              "$ref": "#/$defs/inputs",
              "description": "the fixed values: the preset's, then the document's step inputs"
            },
            "bind": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9_]{0,63}\\.[a-z][a-z0-9_]{0,63}$"
              },
              "additionalProperties": {
                "$ref": "#/$defs/pipelineSource"
              }
            },
            "looks": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "string",
                "pattern": "^([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|[a-z0-9][a-z0-9_-]{0,63}/[a-z0-9][a-z0-9-]{0,63})$"
              },
              "description": "the step's look ids (PipelineStepNode.looks), for display: studio applies them from its batch copy when it makes the step's runs; pipelines ignores them"
            },
            "seed_param": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]{0,63}\\.[a-z][a-z0-9_]{0,63}$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "the workflow's one unwired seed param that seeds vary; null without one"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "takes",
            "keep"
          ],
          "properties": {
            "kind": {
              "const": "gate"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "position": {
              "type": "object",
              "description": "the node's place in the Graph view (canvas pixels, top-left of the card); absent = laid out by the client. Never in cmd.run.execute",
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              }
            },
            "takes": {
              "$ref": "#/$defs/nodeId"
            },
            "keep": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kind",
            "from",
            "collection"
          ],
          "properties": {
            "kind": {
              "const": "output"
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "position": {
              "type": "object",
              "description": "the node's place in the Graph view (canvas pixels, top-left of the card); absent = laid out by the client. Never in cmd.run.execute",
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false,
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              }
            },
            "from": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}\\.(takes|picked)$"
            },
            "collection": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          }
        }
      ]
    },
    "pipelineEdge": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/nodeId"
        },
        {
          "oneOf": [
            {
              "$ref": "#/$defs/nodeId"
            },
            {
              "type": "object",
              "required": [
                "pass",
                "fail",
                "max",
                "then"
              ],
              "additionalProperties": false,
              "properties": {
                "pass": {
                  "$ref": "#/$defs/nodeId"
                },
                "fail": {
                  "$ref": "#/$defs/nodeId"
                },
                "then": {
                  "$ref": "#/$defs/nodeId"
                },
                "max": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10
                }
              }
            }
          ]
        }
      ],
      "description": "[from, to] or [gate, {pass, fail, max, then}]"
    },
    "pipelineSnapshot": {
      "type": "object",
      "description": "a saved pipeline as it was at Submit, with every workflow its steps use; the batch runs this, never the live documents",
      "required": [
        "id",
        "title",
        "version",
        "nodes",
        "edges",
        "workflows"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/uuid"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "nodes": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 24,
          "propertyNames": {
            "$ref": "#/$defs/nodeId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/pipelineNode"
          }
        },
        "edges": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/pipelineEdge"
          }
        },
        "workflows": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/workflowId"
          },
          "additionalProperties": {
            "$ref": "#/$defs/workflowSnapshot"
          },
          "description": "workflow id → its snapshot (as for a batch of one workflow)"
        }
      }
    },
    "cellAttempt": {
      "type": "object",
      "required": [
        "visit",
        "status",
        "run_ids",
        "take_ids"
      ],
      "properties": {
        "visit": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "enum": [
            "running",
            "succeeded",
            "failed",
            "cancelled",
            "waiting",
            "picked",
            "rejected"
          ],
          "description": "a step: running (runs requested) then its end; a gate: waiting, picked, rejected; an output: succeeded"
        },
        "run_ids": {
          "$ref": "#/$defs/takeIdList",
          "description": "a step's runs, by seed index"
        },
        "take_ids": {
          "$ref": "#/$defs/takeIdList",
          "description": "a step: its takes; a gate: the pick; an output: what it received"
        },
        "candidates": {
          "$ref": "#/$defs/takeIdList",
          "description": "a gate: what it offered"
        },
        "seeds": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/seed"
          }
        },
        "error": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      }
    },
    "rowCell": {
      "type": "object",
      "required": [
        "node",
        "kind",
        "attempts"
      ],
      "properties": {
        "node": {
          "$ref": "#/$defs/nodeId"
        },
        "kind": {
          "enum": [
            "step",
            "gate",
            "output"
          ]
        },
        "attempts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/cellAttempt"
          }
        }
      }
    }
  }
}
