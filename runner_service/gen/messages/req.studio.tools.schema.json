{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helmstudio.local/contracts/messages/req.studio.tools.schema.json",
  "title": "NATS request/reply studio.tools (pipelines → studio)",
  "description": "From API 1.15. Core NATS request/reply on subject `studio.tools` (queue group `studio`), bare JSON: one Agent tool call that needs studio's data, made as the batch's owner (row-level security, WithUser). Studio serves gallery.search and library.read (read-only views of the owner's data, result caps in tools.schema.json) and rows.add / rows.edit (the batch's rows, through Submit's checks for that row); memory.read and memory.write never come here (pipelines owns memory). Nothing else is reachable. owner_id, batch_id must be one batch of that owner (else not_found); rows.edit only for row 0 (the director's chat). Idempotent on call_id: asking again returns the first reply (a re-run node after a crash adds no second row). From API 1.44 also the in-app assistant's studio tools (tools/catalog.json, `served_by` studio, surface assistant), with thread_id in place of batch_id, row and node: made as the thread's owner, taken from studio's thread row (an owner_id that is not the thread's is not_found); an admin tool (`roles` admin) is checked against the owner's roles again (forbidden); args are the tool's `input`, an ok reply carries `tool` and the tool's `output`. Studio answers within 5 s; a timeout or `internal` is retried under the same call_id with backoff.",
  "$defs": {
    "request": {
      "oneOf": [
        {
          "$ref": "#/$defs/agent"
        },
        {
          "$ref": "#/$defs/assistant"
        }
      ]
    },
    "agent": {
      "type": "object",
      "required": [
        "owner_id",
        "batch_id",
        "row",
        "node",
        "call_id",
        "tool",
        "args"
      ],
      "additionalProperties": false,
      "properties": {
        "owner_id": {
          "$ref": "defs.schema.json#/$defs/uuid"
        },
        "batch_id": {
          "$ref": "defs.schema.json#/$defs/uuid"
        },
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500,
          "description": "the calling row, 0 = the director's chat"
        },
        "node": {
          "$ref": "defs.schema.json#/$defs/nodeId",
          "description": "the agent node"
        },
        "call_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:(0|[1-9][0-9]{0,2}):[1-9][0-9]{0,3}:[a-z][a-z0-9_]{0,63}:(0|[1-9][0-9]{0,4}):t[0-9]{1,2}r?:[0-3]$",
          "description": "<the turn's idempotency key>:<call index from 0>"
        },
        "tool": {
          "enum": [
            "gallery.search",
            "library.read",
            "rows.add",
            "rows.edit"
          ]
        },
        "args": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tool": {
                "const": "gallery.search"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "$ref": "tools.schema.json#/$defs/gallerySearchArgs"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "library.read"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "$ref": "tools.schema.json#/$defs/libraryReadArgs"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "rows.add"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "$ref": "tools.schema.json#/$defs/rowsAddArgs"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "rows.edit"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "$ref": "tools.schema.json#/$defs/rowsEditArgs"
              },
              "row": {
                "const": 0
              }
            }
          }
        }
      ],
      "description": "an Agent node's call (API 1.15)"
    },
    "assistant": {
