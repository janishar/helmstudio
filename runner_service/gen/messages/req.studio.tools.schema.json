    "error": {
      "type": "object",
      "required": [
        "error",
        "code"
      ],
      "additionalProperties": false,
      "properties": {
        "error": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "told to the model as the tool's error; for rows.add / rows.edit Submit's reason (`row: inputs.prompt: a value is required`)"
        },
        "code": {
          "enum": [
            "invalid",
            "conflict",
            "cap",
            "not_found",
            "forbidden",
            "internal"
          ],
          "description": "invalid: the args or the row fail Submit's checks (final); conflict: rows.edit of a row that has started, or the batch has ended (final); cap: 500 rows, or 100 rows added to this batch (final); not_found: no such batch for this owner, or rows.edit of an unknown row (final); internal: retry; forbidden (API 1.44): an admin tool for an owner without the admin role (final)"
        }
      }
