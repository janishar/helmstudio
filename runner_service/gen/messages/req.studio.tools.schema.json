                "$ref": "../tools/catalog.json#/tools/plan_run/input"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "models"
              }
            }
          },
          "then": {
            "properties": {
              "args": {
                "$ref": "../tools/catalog.json#/tools/models/input"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tool": {
                "const": "hosts"
              }
            }
          },
          "then": {
            "properties": {
