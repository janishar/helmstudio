    "reply": {
      "oneOf": [
        {
          "$ref": "#/$defs/ok"
        },
        {
          "$ref": "#/$defs/assistantOk"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    },
    "ok": {
      "type": "object",
      "required": [
        "result"
      ],
      "additionalProperties": false,
      "properties": {
        "result": {
          "anyOf": [
            {
              "$ref": "tools.schema.json#/$defs/gallerySearchResult"
            },
            {
              "$ref": "tools.schema.json#/$defs/libraryReadResult"
            },
            {
              "$ref": "tools.schema.json#/$defs/rowsAddResult"
            }
          ]
        },
        "row": {
          "type": "object",
          "required": [
            "row",
            "inputs",
            "seeds"
          ],
          "additionalProperties": false,
          "description": "rows.add, rows.edit: the stored row as cmd.pipeline.submit carries rows (inputs `<inputs node>.<name>`, every input set; seeds drawn), so pipelines starts or updates its thread",
          "properties": {
            "row": {
              "$ref": "defs.schema.json#/$defs/batchRow"
            },
            "inputs": {
              "$ref": "defs.schema.json#/$defs/inputs"
            },
            "seeds": {
              "type": "object",
              "additionalProperties": {
                "$ref": "defs.schema.json#/$defs/seed"
              }
            }
          }
        }
      }
    },
    "assistantOk": {
      "type": "object",
      "required": [
        "tool",
        "result"
      ],
      "additionalProperties": false,
      "description": "from API 1.44: an assistant call's result, the tool's `output`",
      "properties": {
        "tool": {
          "enum": [
            "sessions",
            "list_workflows",
            "get_workflow",
            "get_run",
            "plan_run",
            "models",
            "hosts",
            "search_takes",
            "get_take",
            "list_library",
            "pipelines",
            "batch_status",
            "list_timelines",
            "show_timeline",
            "custom_nodes",
            "model_sources",
            "model_jobs",
            "look_at"
          ]
        },
        "result": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "tool"
            ],
            "properties": {
              "tool": {
                "const": "sessions"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "../tools/catalog.json#/tools/sessions/output"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "tool"
            ],
            "properties": {
              "tool": {
                "const": "list_workflows"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "../tools/catalog.json#/tools/list_workflows/output"
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "tool"
            ],
            "properties": {
              "tool": {
                "const": "get_workflow"
              }
            }
          },
          "then": {
            "properties": {
              "result": {
                "$ref": "../tools/catalog.json#/tools/get_workflow/output"
              }
            }
