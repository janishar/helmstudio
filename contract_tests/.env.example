# contract_tests settings. Run them against a throw-away helmstudio stack, never one with real users.

# the API: Kong in front of the services
BASE_URL=http://127.0.0.1:8300
# a client API key, sent as X-API-Key (make one with: docker compose run --rm -T auth apikey contract)
API_KEY=
# the stack's root admin (ADMIN_EMAIL / ADMIN_PASSWORD of its auth_service): it creates users A and B on every run.
# deploy/compose/fake.yml sets admin@helm.test; its password is HELM_TEST_ADMIN_PASSWORD (default in fake.yml)
ADMIN_EMAIL=admin@helm.test
ADMIN_PASSWORD=change-me

# 1 = validate JSON bodies and SSE events against contracts/openapi.yaml (OPENAPI_PATH overrides the location)
CONTRACT_SCHEMAS=0
OPENAPI_PATH=../contracts/openapi.yaml

# seconds to wait for a run or an event
JOB_TIMEOUT=60
