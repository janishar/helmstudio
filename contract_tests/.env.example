# contract_tests settings. Run them against the ora-catalog-test project, never the live stack.

# ============================================================================================
# 1. WHAT IS UNDER TEST
# ============================================================================================
# the API: Kong in front of the services (the ora-catalog-test project is on 8190)
BASE_URL=http://localhost:8190
API_KEY=contract-key
# the test stack's admin (deploy/compose/fake.yml): it creates users A and B, since sign-up is closed
ADMIN_EMAIL=contract-admin@example.com
ADMIN_PASSWORD=contract admin pass 1
# optional: user A's and user B's access tokens (empty = the admin creates two new users)
BEARER_TOKEN=
BEARER_TOKEN_B=

# ============================================================================================
# 2. CHECKS
# ============================================================================================
# 1 = validate JSON response bodies against contracts/openapi.yaml (OPENAPI_PATH overrides the location)
CONTRACT_SCHEMAS=0
OPENAPI_PATH=../contracts/openapi.yaml

# ============================================================================================
# 3. LIMITS
# ============================================================================================
# seconds to wait for processing or a run to finish (fake mode)
JOB_TIMEOUT=120
