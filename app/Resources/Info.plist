<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>helmstudio</string>
	<key>CFBundleDisplayName</key>
	<string>helmstudio</string>
	<key>CFBundleIdentifier</key>
	<string>com.janishar.helmstudio</string>
	<key>CFBundleExecutable</key>
	<string>helmstudio</string>
	<key>CFBundleIconFile</key>
	<string>helmstudio</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleShortVersionString</key>
	<string>__VERSION__</string>
	<key>CFBundleVersion</key>
	<string>__VERSION__</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.graphics-design</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>helmstudio</string>
	<!-- A studio that records — a speech studio taking a reference clip — asks
	     the page for the microphone. Without this string macOS terminates the
	     app instead of prompting the first time it is asked. -->
	<key>NSMicrophoneUsageDescription</key>
	<string>A studio you run can record audio, such as a reference voice clip. Nothing leaves this Mac.</string>
	<!-- App Transport Security refuses plain http by default, which would
	     include the daemon on loopback. This is the documented exemption for
	     it, and it is the narrowest one: local networking only, not arbitrary
	     insecure loads. Without it the window never loads anything. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
