# auth_service settings, in the order you're most likely to change them. Compose overrides the infrastructure values.
# Any VAR can instead come from a file: VAR_FILE=/run/secrets/... (the stack does this for DATABASE_URL, NATS_URL,
# JWT_PRIVATE_KEY, WEB_API_KEY and HELM_API_KEY).

# ============================================================================================
# 1. SIGN-IN SESSIONS
# ============================================================================================
JWT_ISSUER=helm-auth
ACCESS_TTL=15m
REFRESH_TTL=720h

# ============================================================================================
# 2. ADMIN
# ============================================================================================
# the root admin, the only admin (there is no sign-up: it creates every account on the web's Admin Users screen). Applied on every
# start: created when missing, else enabled with this password; every other account loses the admin role.
# empty = no admin at all
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ============================================================================================
# 3. KEYS AND CLIENTS
# ============================================================================================
# RSA key: <KEYS_DIR>/private.pem; generated on first start when missing. JWT_PRIVATE_KEY (PEM)
# replaces it; the helmstudio stack sets JWT_PRIVATE_KEY_FILE to a compose secret.
KEYS_DIR=/app/keys
# the web app's API key: registered for client "web" on every start (the stack's web_api_key secret)
WEB_API_KEY=
# the helm CLI's API key: registered for client "helm" on every start (the stack's helm_api_key secret)
HELM_API_KEY=
# hops allowed to set X-Forwarded-For (IPs or CIDRs, comma-separated): Kong and the web BFF. Empty: the TCP peer
# is the client (sign-in limits per IP)
TRUSTED_PROXIES=

# ============================================================================================
# 4. INFRASTRUCTURE
# ============================================================================================
PORT=8080
# own database + user (created by deploy/postgres init)
DATABASE_URL=postgres://auth:auth@postgres:5432/auth?sslmode=disable
NATS_URL=nats://nats:4222
NATS_USER=auth
NATS_PASSWORD=
