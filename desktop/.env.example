# desktop/.env is not read by the app; these are the variables `make run` and a scratch launch understand.
# The app's folder (default ~/Library/Application Support/helmstudio); a scratch folder keeps a test run apart
HELMSTUDIO_HOME=
# 1 fakes every command (no VM, no Docker, no uv): to look at the screens
HELMSTUDIO_FAKE=
# fake mode: the first faked command line holding this word fails once (e.g. make-secrets: step 4)
HELMSTUDIO_FAKE_FAIL=
