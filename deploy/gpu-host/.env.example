# A remote GPU host's runner (deploy/gpu-host). Copy to .env on the GPU host. Placeholders only: credentials are files
# in ./secrets (README.md, step 3), never values here.

# The host's name in the stack: lower-case letters and digits, the one given to .tools/make-secrets (GPU_HOSTS)
GPU_HOST=gcp
# This host's models folder (<model>/<variant>/ as on the Mac); ro = no model jobs here (studio answers 409), rw =
# downloads and deletes land here (the folder must be writable by uid 10001)
MODELS_DIR=/mnt/models
MODELS_MODE=ro

# The object store over https (the test rig's tunnel puts the stack's S3 https port on 127.0.0.1:8333); NATS comes
# from secrets/nats_runner_<GPU_HOST>_torch_url (tls://127.0.0.1:4222 through the tunnel)
S3_ENDPOINT=https://127.0.0.1:8333
S3_BUCKET=helmstudio
S3_REGION=us-east-1

# Budgets (contracts/README.md, Hosts with a discrete GPU): device budget = VRAM - RUNNER_RESERVE_GB (the admin's
# Hosts setting replaces it), host RAM budget = RAM - RUNNER_RAM_RESERVE_GB
RUNNER_RESERVE_GB=2
RUNNER_RAM_RESERVE_GB=4
RUNNER_AFTER_RUN=keep_warm
RUNNER_IDLE_UNLOAD_S=600
# GET /health (host networking: on every interface of this host; keep it firewalled)
HEALTH_PORT=8081

# Model downloads (MODELS_MODE=rw); a token for gated repos goes in secrets/hf_token, never here
HF_ENDPOINT=https://huggingface.co
