# Compose-level values for the helmstudio stack only (ports, profiles, network, bucket). Copy to deploy/.env
# (.tools/copy-envs does it). Credentials are compose secrets in deploy/secrets/ (.tools/make-secrets), not here.

# ============================================================================================
# 1. WHAT RUNS
# ============================================================================================
COMPOSE_PROFILES=s3local

# ============================================================================================
# 2. HOST PORTS AND NETWORK
# ============================================================================================
# Host port Kong listens on (127.0.0.1 only): the platform's single entry point
KONG_HTTP_PORT=8300
# Host port for psql against the helmstudio Postgres (127.0.0.1 only); tests use the helmstudio-test one on 5464
POSTGRES_HOST_PORT=5463
# Host ports (127.0.0.1 only) a native runner (make runners) uses: NATS and the SeaweedFS S3 API; helmstudio-test
# uses 4323 / 8434. make runners reads S3_HOST_PORT from the shell, and the NATS one is baked into
# deploy/secrets/nats_runner_mac_url when .tools/make-secrets first creates it.
NATS_HOST_PORT=4322
S3_HOST_PORT=8433
# First three octets of the stack's /24 network (Kong is .10, the web app .11); change it if the subnet is taken
HELM_NET=172.30.97

# ============================================================================================
# 3. OBJECT STORE
# ============================================================================================
# SeaweedFS bucket (profile s3local); its keys are the s3_* secrets
S3_BUCKET=helmstudio
